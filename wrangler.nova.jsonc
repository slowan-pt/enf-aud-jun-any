{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "essencial-saude-nova",
  "main": "dist/server/entry.mjs",
  "no_bundle": true,
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "ESModule", "globs": ["**/*.js", "**/*.mjs"] }],
  "assets": {
    "directory": "dist/client",
    "binding": "ASSETS",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "clone-estratagema-claude-db",
      "database_id": "29a812fb-63bf-4de1-80ae-a6acc8b3e997",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "essencial-saude-nova-media",
    },
  ],
  "workers_dev": true,
  "preview_urls": false,
  "routes": [
    { "pattern": "essencialsaudeauditoria.com.br", "custom_domain": true },
    { "pattern": "www.essencialsaudeauditoria.com.br", "custom_domain": true },
    { "pattern": "essencialsaudeauditoria.online", "custom_domain": true },
    { "pattern": "www.essencialsaudeauditoria.online", "custom_domain": true },
  ],
  // Plano B do aviso de contato/currículo (o principal é o Resend, que entrega
  // na caixa do UOL). Só funciona se o destino estiver VERIFICADO no Email
  // Routing da Cloudflare — com o MX no UOL, normalmente não estará.
  "send_email": [
    {
      "name": "EMAIL",
      "allowed_destination_addresses": ["contato@essencialsaudeauditoria.com.br"],
    },
  ],
  "vars": {
    "MAIL_FROM": "curriculos@essencialsaudeauditoria.com.br",
    "NEWSLETTER_FROM": "novidades@essencialsaudeauditoria.com.br",
    "PORTFOLIO_FROM": "portfolio@essencialsaudeauditoria.com.br",
    "PUBLIC_SITE_URL": "https://essencialsaudeauditoria.com.br",
  },
}
