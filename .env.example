# Nunca versionar valores reais — usar GitHub Secrets / Cloudflare Secrets.
# As variáveis do binding D1/R2/Turnstile são configuradas via wrangler.jsonc
# (bindings) e `wrangler secret put` (segredos) — não por .env em produção.
# Este arquivo documenta o que existe; uso local via wrangler é opcional.

# Cloudflare (necessário só para deploy/gestão via CLI fora do wrangler login)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Antispam (Cloudflare Turnstile) — Fase 4, ainda não conectado
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Estatísticas do Site (painel /admin/estatisticas) — SEGREDOS DO WORKER:
#   npx wrangler secret put CLOUDFLARE_API_TOKEN -c wrangler.nova.jsonc   (token só com "Analytics: leitura")
#   npx wrangler secret put CLOUDFLARE_ZONE_ID   -c wrangler.nova.jsonc   (ID da zona)
# Local: coloque os dois em .dev.vars (ignorado pelo Git). Nunca em arquivos públicos.
# (Não confundir com o CLOUDFLARE_API_TOKEN acima, usado só pelo CLI para deploy.)

# Site
PUBLIC_SITE_URL=https://essencialsaudeauditoria.com.br
