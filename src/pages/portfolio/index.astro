---
/**
 * Portfólio institucional: o PDF aparece como revista (páginas que viram) e,
 * embaixo, o formulário para pedir o PDF. O pedido vai para aprovação da Essencial.
 *
 * Página "escondida": sem link no menu/rodapé, fora do sitemap e com noindex —
 * só abre por quem recebe o endereço.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';

export const prerender = false;

const pages = [1, 2, 3, 4].map((n) => `/portfolio/pagina-${n}.webp`);
---

<BaseLayout
  title="Portfólio"
  description="Portfólio institucional da Essencial Saúde Auditoria."
  path="/portfolio"
  noindex
  bodyClass="page-portfolio"
>
  <PageHero
    eyebrow="Institucional"
    title="Portfólio"
    lead="Conheça a Essencial Saúde Auditoria: o que fazemos, em quais segmentos atuamos e como trabalhamos."
    crumbs={[{ label: 'Portfólio' }]}
  />

  <section class="section section--tight">
    <div class="container">
      <div class="flipbook" data-flipbook data-pages={JSON.stringify(pages)}>
        <div class="flipbook__view" data-view>
          <div class="flipbook__stage" data-stage>
            <img class="flipbook__fallback" src={pages[0]} alt="Portfólio — capa" />
          </div>
          <div class="flipbook__lens" data-lens hidden></div>
        </div>
        <div class="flipbook__bar">
          <button type="button" class="btn btn--ghost btn--sm" data-prev aria-label="Página anterior">
            <Icon name="arrow-left" size={16} /> Anterior
          </button>
          <span class="flipbook__count" data-count aria-live="polite">1 / {pages.length}</span>
          <button type="button" class="btn btn--ghost btn--sm" data-next aria-label="Próxima página">
            Próxima <Icon name="arrow-right" size={16} />
          </button>
          <button type="button" class="btn btn--ghost btn--sm" data-zoom aria-pressed="false">
            <Icon name="search" size={16} /> Zoom
          </button>
          <button type="button" class="btn btn--ghost btn--sm" data-full aria-label="Tela cheia">
            Tela cheia
          </button>
        </div>
        <p class="flipbook__hint" data-hint>Clique ou arraste as bordas da página para virar.</p>
      </div>
    </div>
  </section>

  <section class="section section--subtle" id="receber">
    <div class="container container--narrow">
      <div class="request" data-request>
        <h2 class="title-md">Quer receber o Portfólio em PDF?</h2>
        <p class="request__lead">
          Preencha os dados abaixo. Nossa equipe analisa o pedido e, se aprovado, enviamos o PDF para o
          e-mail informado.
        </p>

        <form class="request__form" method="post" action="/api/portfolio" novalidate data-request-form>
          <div class="request__hp" aria-hidden="true">
            <label>Não preencha <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
          </div>
          <label class="request__field">
            <span>Nome completo</span>
            <input class="input" type="text" name="nome" autocomplete="name" maxlength="150" required />
          </label>
          <label class="request__field">
            <span>E-mail</span>
            <input class="input" type="email" name="email" autocomplete="email" required />
          </label>
          <label class="request__field">
            <span>Telefone (com DDD)</span>
            <input class="input" type="tel" name="telefone" autocomplete="tel" inputmode="tel" required />
          </label>
          <label class="request__field">
            <span>Empresa</span>
            <input class="input" type="text" name="empresa" autocomplete="organization" maxlength="200" required />
          </label>
          <label class="request__field">
            <span>Cargo</span>
            <input class="input" type="text" name="cargo" autocomplete="organization-title" maxlength="150" required />
          </label>
          <label class="request__consent">
            <input type="checkbox" name="consentimento" />
            <span>
              Concordo com o tratamento dos meus dados para análise deste pedido e envio do material,
              conforme a{' '}
              <a href="/politica-de-privacidade" data-popup target="_blank" rel="noopener">Política de Privacidade</a>.
            </span>
          </label>
          <button type="submit" class="btn btn--primary request__submit">
            <Icon name="download" size={18} /> Quero receber o Portfólio
          </button>
          <p class="request__msg" role="status" data-msg></p>
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .flipbook {
    display: grid;
    justify-items: center;
    gap: var(--sp-4);
  }

  .flipbook__stage {
    width: 100%;
    max-width: 980px;
    display: grid;
    justify-items: center;
  }

  .flipbook__view {
    position: relative;
    width: 100%;
    max-width: 980px;
    overflow: hidden;
    border-radius: var(--r-md);
  }

  .flipbook__stage {
    transition: transform 0.18s ease-out;
  }

  .flipbook__view.is-zoom .flipbook__stage {
    transform: scale(2.2);
  }

  /* Com o zoom ligado, esta camada fica por cima e captura mouse/dedo
     (em vez de virar a página). */
  .flipbook__lens {
    position: absolute;
    inset: 0;
    z-index: 5;
    cursor: zoom-in;
    touch-action: none;
  }

  .flipbook__fallback {
    max-width: 420px;
    width: 100%;
    height: auto;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md);
  }

  .flipbook__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
  }

  .flipbook__count {
    min-width: 4.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .flipbook__hint {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-faint);
    text-align: center;
  }

  .flipbook :global(.btn.is-active) {
    background: var(--c-accent-50, #e8f6ef);
    color: var(--c-accent-700);
  }

  .flipbook:fullscreen {
    background: #0b1626;
    padding: var(--sp-4);
    align-content: center;
  }

  .flipbook:fullscreen .flipbook__count,
  .flipbook:fullscreen .flipbook__hint {
    color: #cfd8e3;
  }

  .request {
    display: grid;
    gap: var(--sp-4);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--c-white);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-sm);
  }

  .request__lead {
    margin: 0;
    color: var(--text-muted);
    text-align: left;
  }

  .request__form {
    display: grid;
    gap: var(--sp-4);
  }

  .request__field {
    display: grid;
    gap: 0.35rem;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-strong);
  }

  .request__consent {
    display: flex;
    gap: var(--sp-2);
    align-items: flex-start;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .request__consent input {
    margin-top: 0.2rem;
    flex: none;
  }

  .request__consent span {
    text-align: left;
  }

  .request__submit {
    justify-self: stretch;
  }

  .request__msg {
    min-height: 1.2em;
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    text-align: left;
  }

  .request__msg[data-state='ok'] {
    color: var(--c-accent-700);
  }

  .request__msg[data-state='error'] {
    color: var(--c-danger-600);
  }

  .request__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<script is:inline src="/vendor/page-flip.browser.js"></script>
<script is:inline>
  (function () {
    // ---------- revista (páginas que viram) ----------
    var root = document.querySelector('[data-flipbook]');
    var stage = root && root.querySelector('[data-stage]');
    if (root && stage && window.St && window.St.PageFlip) {
      var urls = JSON.parse(root.getAttribute('data-pages') || '[]');
      stage.innerHTML = '';
      var flip = new window.St.PageFlip(stage, {
        width: 550,
        height: 778,
        size: 'stretch',
        minWidth: 240,
        maxWidth: 560,
        minHeight: 340,
        maxHeight: 792,
        showCover: true,
        usePortrait: true,
        maxShadowOpacity: 0.45,
        flippingTime: 800,
        mobileScrollSupport: false,
      });
      flip.loadFromImages(urls);
      var count = root.querySelector('[data-count]');
      var update = function () {
        if (count) count.textContent = flip.getCurrentPageIndex() + 1 + ' / ' + flip.getPageCount();
      };
      flip.on('flip', update);
      flip.on('init', update);
      root.querySelector('[data-prev]').addEventListener('click', function () { flip.flipPrev(); });
      root.querySelector('[data-next]').addEventListener('click', function () { flip.flipNext(); });
      var full = root.querySelector('[data-full]');
      if (full) {
        if (!root.requestFullscreen) full.hidden = true;
        full.addEventListener('click', function () {
          if (document.fullscreenElement) document.exitFullscreen();
          else root.requestFullscreen();
        });
      }
      // ---------- zoom: passa o mouse (ou arrasta o dedo) para ver os detalhes ----------
      var view = root.querySelector('[data-view]');
      var lens = root.querySelector('[data-lens]');
      var zoomBtn = root.querySelector('[data-zoom]');
      var hint = root.querySelector('[data-hint]');
      var hintOff = hint ? hint.textContent : '';
      var move = function (e) {
        var box = view.getBoundingClientRect();
        var x = Math.max(0, Math.min(100, ((e.clientX - box.left) / box.width) * 100));
        var y = Math.max(0, Math.min(100, ((e.clientY - box.top) / box.height) * 100));
        stage.style.transformOrigin = x + '% ' + y + '%';
      };
      var setZoom = function (on) {
        view.classList.toggle('is-zoom', on);
        lens.hidden = !on;
        zoomBtn.setAttribute('aria-pressed', String(on));
        zoomBtn.classList.toggle('is-active', on);
        stage.style.transformOrigin = '50% 50%';
        if (hint) hint.textContent = on ? 'Passe o mouse sobre a página (ou arraste o dedo) para ampliar. Clique em Zoom para sair.' : hintOff;
      };
      zoomBtn.addEventListener('click', function () { setZoom(!view.classList.contains('is-zoom')); });
      lens.addEventListener('pointermove', move);
      lens.addEventListener('pointerdown', move);

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape') setZoom(false);
        if (e.key === 'ArrowLeft') flip.flipPrev();
        if (e.key === 'ArrowRight') flip.flipNext();
      });
    }

    // ---------- formulário de pedido ----------
    var form = document.querySelector('[data-request-form]');
    if (!form) return;
    var msg = form.querySelector('[data-msg]');
    var show = function (text, state) { msg.textContent = text; msg.dataset.state = state; };
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      show('Enviando…', 'ok');
      fetch(form.action, { method: 'POST', body: new FormData(form) })
        .then(function (res) {
          return res.json().catch(function () { return null; }).then(function (payload) { return { res: res, payload: payload }; });
        })
        .then(function (r) {
          if (r.res.ok && r.payload && r.payload.success) {
            form.reset();
            show('Pedido enviado! Nossa equipe vai analisar e, se aprovado, você receberá o PDF no e-mail informado.', 'ok');
          } else if (r.res.status === 422 && r.payload && r.payload.fields) {
            show(Object.values(r.payload.fields)[0] || 'Verifique os campos.', 'error');
          } else {
            show((r.payload && r.payload.message) || 'Não foi possível enviar agora. Tente novamente.', 'error');
          }
        })
        .catch(function () { show('Falha de conexão. Tente novamente.', 'error'); })
        .then(function () { button.disabled = false; });
    });
  })();
</script>
