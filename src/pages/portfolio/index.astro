---
/**
 * Portfólio institucional: o PDF aparece como revista (páginas que viram) e,
 * embaixo, o formulário para pedir o PDF. O pedido vai para aprovação da Essencial.
 *
 * Página pública (menu, rodapé e sitemap). As rotas /portfolio/decisao e
 * /portfolio/baixar seguem privadas (noindex, fora do sitemap).
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import PortfolioViewer from '../../components/PortfolioViewer.astro';

export const prerender = false;

const hero = Astro.locals.settings.portfolioHero;

---

<BaseLayout
  title="Portfólio"
  description="Portfólio institucional da Essencial Saúde Auditoria."
  path="/portfolio"
  bodyClass="page-portfolio"
>
  <PageHero
    eyebrow={hero.eyebrow}
    title={hero.title}
    lead={hero.lead}
    crumbs={[{ label: 'Portfólio' }]}
  />

  <PortfolioViewer />
</BaseLayout>
