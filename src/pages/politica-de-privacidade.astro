---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import Icon from '../components/Icon.astro';
import SectionOverlays from '../components/SectionOverlays.astro';
import { getDB } from '../lib/db';
import { getPoliticaContent } from '../lib/documents';
import { sectionStyleAttr, layoutStylesheet, pageStyleOverride } from '../lib/pages';

const { company } = Astro.locals.settings;

const edit = Boolean(Astro.locals.editMode);
const ed = <T,>(value: T): T | undefined => (edit ? value : undefined);
const editMode = Astro.url.searchParams.get('__edit') === '1' && Boolean(Astro.locals.user);

const db = getDB();
const {
  hero,
  updatedAt,
  noteText,
  sections,
  pageStyle,
  sectionStyles,
  sectionOrder,
  hiddenSections,
  layouts,
  overlays,
} = await getPoliticaContent(db);

const layoutCss = layoutStylesheet(layouts, overlays);

const isHidden = (key: string) => (hiddenSections as string[]).includes(key);
const secClass = (key: string) =>
  isHidden(key) ? (editMode ? 'is-section-off-preview' : 'is-section-off') : '';
const slotOf = new Map<string, number>();
sectionOrder.forEach((key, index) => slotOf.set(key, index));
const secStyle = (key: string, style: (typeof sectionStyles)[keyof typeof sectionStyles]) =>
  [sectionStyleAttr(style), `order:${slotOf.get(key) ?? 0}`].filter(Boolean).join(';');

/**
 * Texto puro (nunca HTML) em blocos: parágrafos separados por linha em
 * branco; um bloco onde TODA linha começa com "- " vira lista. Nunca passa
 * por innerHTML — cada trecho segue como texto interpolado normal do
 * Astro, que já escapa sozinho.
 */
function parseBody(body: string): { kind: 'p' | 'ul'; lines: string[] }[] {
  return body
    .split(/\n\s*\n/)
    .map((block) => block.trim())
    .filter(Boolean)
    .map((block) => {
      const lines = block.split('\n').map((l) => l.trim());
      const isList = lines.length > 0 && lines.every((l) => l.startsWith('- '));
      return isList
        ? { kind: 'ul' as const, lines: lines.map((l) => l.slice(2)) }
        : { kind: 'p' as const, lines: [block] };
    });
}
---

<BaseLayout
  title="Política de Privacidade"
  description="Política de Privacidade da Essencial Saúde Auditoria: como tratamos dados pessoais coletados neste site, base legal, finalidades, retenção e direitos do titular (LGPD)."
  path="/politica-de-privacidade"
  colorOverride={pageStyleOverride(pageStyle)}
  bodyClass="page-politica"
>
  <div style="order:-1">
    <PageHero
      eyebrow={hero.eyebrow}
      title={hero.title}
      lead={hero.lead}
      crumbs={[{ label: 'Política de Privacidade' }]}
    />
  </div>

  <section
    class:list={['section', secClass('nota')]}
    style={secStyle('nota', sectionStyles.nota)}
    data-section="nota"
    data-section-label={ed('Aviso')}
  >
    <div class="container container--narrow">
      <p class="note">
        <Icon name="info" size={16} />
        <span>
          <span data-edit="noteText" data-edit-kind={ed('multiline')}>{noteText}</span>
          {' '}Última atualização: <span data-edit="updatedAt">{updatedAt}</span>.
        </span>
      </p>
      <SectionOverlays section="nota" overlays={overlays} />
    </div>
  </section>

  <section
    class:list={['section', secClass('conteudo')]}
    style={secStyle('conteudo', sectionStyles.conteudo)}
    data-section="conteudo"
    data-section-label={ed('Conteúdo jurídico')}
  >
    <div class="container container--narrow">
      <div class="prose policy" data-edit-list={ed('sections')}>
        {
          sections.map((sectionItem, index) => (
            <div data-edit-item={ed(index)}>
              <h2 data-edit={`sections.${index}.title`}>{sectionItem.title}</h2>
              <div data-edit={`sections.${index}.body`} data-edit-kind={ed('multiline')}>
                {parseBody(sectionItem.body).map((block) =>
                  block.kind === 'ul' ? (
                    <ul>
                      {block.lines.map((line) => (
                        <li>{line}</li>
                      ))}
                    </ul>
                  ) : (
                    block.lines.map((line) => <p>{line}</p>)
                  )
                )}
              </div>
            </div>
          ))
        }
        <p class="muted small">
          Dúvidas sobre esta política podem ser enviadas para{' '}
          <a href={`mailto:${company.email}`}>{company.email}</a>.
        </p>
      </div>
      <SectionOverlays section="conteudo" overlays={overlays} />
    </div>
  </section>

  {layoutCss && <style is:inline set:html={layoutCss} />}

  {
    editMode && (
      <>
        <script is:inline src="/vendor/moveable.min.js" />
        <script is:inline src="/editor-runtime.js" />
      </>
    )
  }
</BaseLayout>

<style is:global>
  body.page-politica main {
    display: flex;
    flex-direction: column;
  }

  body.page-politica main > section {
    position: relative;
    container-type: inline-size;
  }

  .is-section-off {
    display: none;
  }

  .is-section-off-preview {
    opacity: 0.35;
    filter: grayscale(0.6);
  }
</style>

<style>
  .note {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    align-items: start;
    padding: var(--sp-4);
    margin-bottom: var(--sp-8);
    border-radius: var(--r-md);
    background: var(--c-warning-100);
    color: var(--c-warning-600);
    font-size: var(--fs-xs);
    line-height: var(--lh-relaxed);
  }

  .policy {
    max-width: none;
  }

  .policy h2 {
    font-size: var(--fs-lg);
  }
</style>
