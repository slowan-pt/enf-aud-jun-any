---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

import { publishedOnly as publishedServicesOnly } from '../lib/services';
import { formatDate, publishedOnly as publishedPostsOnly } from '../lib/posts';
import { getDB } from '../lib/db';
import { getHomeContent } from '../lib/pages';
import { waLink } from '../data/site';

const { whatsapp, clientSegments } = Astro.locals.settings;
const publishedServices = publishedServicesOnly(Astro.locals.services);
const publishedPosts = publishedPostsOnly(Astro.locals.posts);
const { heroSlides, heroSlideIntervalSeconds, faqItems, finalCta } = await getHomeContent(getDB());

---

<BaseLayout
  description="Essencial Saúde Auditoria: auditoria concorrente, gestão da jornada do paciente, auditoria de contas hospitalares e soluções técnicas para operadoras, prestadores e beneficiários."
  path="/"
  bodyClass="page-home"
>
  <section class="hero-carousel" aria-label="Destaques da Essencial Saúde">
    <div class="hero-carousel__track" data-hero-interval={heroSlideIntervalSeconds}>
      {
        heroSlides.map((slide, index) => (
          <article class:list={['hero-slide', index === 0 && 'is-active']} data-slide>
            <img
              src={slide.image}
              alt={slide.alt}
              width="1400"
              height="760"
              fetchpriority={index === 0 ? 'high' : undefined}
              loading={index === 0 ? undefined : 'lazy'}
              decoding="async"
            />
            <div class="hero-slide__shade" aria-hidden="true" />
            <div class="container hero-slide__content">
              <div class="hero-slide__copy">
                <h1>{slide.title}</h1>
                <p>{slide.text}</p>
                <div class="hero-slide__actions">
                  <a href="#servicos" class="btn">
                    Conhecer serviços
                  </a>
                  <a
                    href={waLink(whatsapp.number, whatsapp.defaultMessage)}
                    class="btn btn--on-brand"
                    target="_blank"
                    rel="noopener"
                  >
                    <Icon name="whatsapp" size={17} />
                    Falar com especialista
                  </a>
                </div>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="hero-carousel__controls container" aria-label="Selecionar destaque">
      {
        heroSlides.map((slide, index) => (
          <button
            type="button"
            class:list={['hero-dot', index === 0 && 'is-active']}
            aria-label={`Ver destaque: ${slide.title}`}
            data-slide-button={index}
          />
        ))
      }
    </div>
  </section>

  <section class="service-icons" id="servicos" aria-labelledby="servicos-title">
    <div class="container">
      <h2 class="sr-only" id="servicos-title">Serviços</h2>

      <div class="service-icons__grid" data-reveal>
        {
          publishedServices.map((service, index) => (
            <button
              type="button"
              class:list={['service-icon-card', index === 0 && 'is-active']}
              id={`tab-${service.slug}`}
              aria-controls={`panel-${service.slug}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              data-service-tab={service.slug}
            >
              <Icon name={service.icon} size={36} strokeWidth={1.55} />
              <span>{service.shortName || service.name}</span>
            </button>
          ))
        }
      </div>

      <div class="service-tabs" aria-label="Conteúdo dos serviços" data-reveal>
        {
          publishedServices.map((service, index) => (
            <article
              class:list={['service-panel', index === 0 && 'is-active']}
              id={`panel-${service.slug}`}
              role="tabpanel"
              aria-labelledby={`tab-${service.slug}`}
              data-service-panel={service.slug}
              hidden={index !== 0}
            >
              <div class="service-panel__media">
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  width="900"
                  height="680"
                  loading="eager"
                  fetchpriority={index === 0 ? 'auto' : 'low'}
                  decoding="async"
                />
              </div>
              <div class="service-panel__body">
                <h2 class="title-md">{service.name}</h2>
                <p class="lead">{service.summary}</p>
                <ul class="service-panel__highlights">
                  {service.highlights.slice(0, 3).map((item) => (
                    <li>
                      <Icon name={item.icon} size={18} />
                      <span>
                        <strong>{item.title}.</strong> {item.text}
                      </span>
                    </li>
                  ))}
                </ul>
                <div class="cluster">
                  <a href={`/servicos/${service.slug}`} class="btn btn--secondary">
                    Ver detalhes
                    <Icon name="arrow-right" size={16} class="icon--arrow" />
                  </a>
                  <a
                    href={waLink(whatsapp.number, service.whatsappMessage)}
                    class="link-arrow"
                    target="_blank"
                    rel="noopener"
                  >
                    Conversar sobre este serviço
                    <Icon name="whatsapp" size={16} />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--subtle segments-home" aria-labelledby="segments-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <p class="eyebrow">{clientSegments.eyebrow}</p>
        <h2 class="title-lg" id="segments-title">{clientSegments.title}</h2>
        <p class="lead">{clientSegments.text}</p>
      </div>

      <div class="segments" data-reveal>
        {
          clientSegments.items.map((item, index) => (
            <article class="segment" tabindex="0" data-card-key={`seg-${index}`}>
              <span class="icon-badge icon-badge--sm">
                <Icon name={item.icon} size={18} />
              </span>
              <h3>{item.label}</h3>
              <p class="segment__detail">{item.detail}</p>
              <div class="segment__more">
                <p class="segment__behavior">{item.behavior}</p>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section faq" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-head section-head--center" data-reveal>
        <h2 class="title-lg" id="faq-title">Perguntas frequentes</h2>
      </div>
      <div class="faq__list" data-faq-list data-reveal>
        {
          faqItems.map((item, index) => (
            <details class="faq__item" data-faq-item>
              <summary>
                <span>{item.question}</span>
                <Icon name="chevron-down" size={18} />
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight contact-home" id="contato">
    <div class="container contact-home__inner" data-reveal>
      <p class="eyebrow">{finalCta.eyebrow}</p>
      <h2 class="title-lg">{finalCta.title}</h2>
      <p class="lead">{finalCta.text}</p>

      <a href={finalCta.primary.href} class="btn contact-home__button">
        {finalCta.primary.label}
        <Icon name="arrow-right" size={16} class="icon--arrow" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .segments {
    display: grid;
    gap: var(--sp-4);
    padding-bottom: var(--sp-8);
  }

  @media (min-width: 640px) {
    .segments {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 980px) {
    .segments {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .segment {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: var(--sp-5);
    border: 1px solid var(--card-border, var(--line));
    border-top: 3px solid var(--card-accent, var(--line));
    border-radius: var(--r-lg);
    background: var(--card-bg, var(--c-white));
    transition:
      border-color 0.25s var(--ease),
      box-shadow 0.25s var(--ease),
      border-radius 0.25s var(--ease);
  }

  .segment h3 {
    font-size: var(--fs-base);
    margin-top: 0.25rem;
  }

  .segment__detail {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    line-height: var(--lh-normal);
    white-space: pre-line;
  }

  /* A parte de baixo "desce" do próprio card: a altura da linha não muda,
     então nada da página se mexe — o painel só se sobrepõe ao que vem abaixo. */
  .segment__more {
    position: absolute;
    z-index: 5;
    top: calc(100% - 1px);
    left: -1px;
    right: -1px;
    padding: var(--sp-4) var(--sp-5) var(--sp-5);
    background: var(--card-bg, var(--c-white));
    border: 1px solid var(--c-brand-200, var(--line));
    border-top: 1px dashed var(--line);
    border-radius: 0 0 var(--r-lg) var(--r-lg);
    box-shadow: 0 18px 32px -14px rgba(11, 37, 69, 0.28);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-8px);
    transition:
      opacity 0.25s var(--ease),
      transform 0.3s var(--ease),
      visibility 0s linear 0.3s;
  }

  .segment:hover,
  .segment:focus-within {
    z-index: 6;
    border-color: var(--c-brand-200, var(--line));
    border-bottom-color: transparent;
    border-radius: var(--r-lg) var(--r-lg) 0 0;
    box-shadow: 0 -4px 20px -12px rgba(11, 37, 69, 0.25);
  }

  .segment:hover .segment__more,
  .segment:focus-within .segment__more {
    opacity: 1;
    visibility: visible;
    transform: none;
    transition-delay: 0s;
  }

  .segment__behavior {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: var(--lh-relaxed);
    white-space: pre-line;
  }

  /* Sem mouse (celular/tablet) não há "passar por cima": mostra tudo, como antes. */
  @media (hover: none) {
    .segment__more {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      padding: var(--sp-3) 0 0;
      border: 0;
      border-top: 1px solid var(--line);
      border-radius: 0;
      box-shadow: none;
    }
  }

  .hero-carousel {
    position: relative;
    background: var(--c-brand-900);
    overflow: hidden;
  }

  .hero-carousel__track {
    position: relative;
    min-height: clamp(460px, 68vw, 690px);
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 720ms var(--ease-out),
      visibility 720ms var(--ease-out);
  }

  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-slide__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(6, 32, 58, 0.78),
        rgba(6, 32, 58, 0.36) 48%,
        rgba(6, 32, 58, 0.04)
      ),
      linear-gradient(0deg, rgba(6, 32, 58, 0.22), rgba(6, 32, 58, 0.08));
  }

  .hero-slide__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: flex-start;
    align-items: flex-start;
    color: #fff;
    padding-top: clamp(2.2rem, 5.6vw, 4rem);
    padding-bottom: clamp(3rem, 6vw, 5rem);
    /* `.container` (max-width 1200px + margin auto) centraliza este bloco
       dentro da foto full-bleed, deixando uma faixa vazia à esquerda em
       telas largas. O texto em si não é centralizado, então tirar o teto
       de largura aqui faz ele se aproximar da borda real da viewport — com
       um respiro maior que o gutter padrão para não colar na borda. */
    max-width: none;
    padding-left: clamp(1.5rem, 6vw, 5rem);
  }

  .hero-slide__copy {
    width: min(100%, 430px);
  }

  .hero-slide h1 {
    max-width: 14ch;
    color: #fff;
    /* Mesma escala do topo das páginas de serviço. */
    font-size: clamp(1.6rem, 3vw, 2.6rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .hero-slide__copy > p {
    max-width: 31rem;
    margin-top: var(--sp-4);
    color: rgba(234, 243, 251, 0.9);
    font-size: clamp(0.875rem, 1.15vw, 1rem);
    line-height: 1.55;
  }

  .hero-slide__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-8);
  }

  .hero-carousel__controls {
    position: absolute;
    left: 50%;
    right: auto;
    bottom: var(--sp-6);
    transform: translateX(-50%);
    display: flex;
    gap: 0.55rem;
  }

  .hero-dot {
    width: 9px;
    height: 9px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.42);
    transition:
      background var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .hero-dot.is-active {
    background: #fff;
    transform: scale(1.25);
  }

  .service-icons {
    padding-block: clamp(1.1rem, 3vw, 2rem);
    background: var(--bg-subtle);
  }

  .service-icons__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(164px, 1fr));
    gap: var(--sp-3);
    scroll-margin-top: 92px;
  }

  .service-icon-card {
    appearance: none;
    position: relative;
    min-height: 128px;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--sp-3);
    padding: var(--sp-3);
    border-radius: 8px;
    background: var(--c-white);
    color: var(--c-brand-800);
    border: 1px solid rgba(183, 193, 205, 0.42);
    box-shadow: 0 18px 32px -26px rgba(9, 44, 78, 0.42);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .service-icon-card:hover,
  .service-icon-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 24px 36px -24px rgba(9, 44, 78, 0.38);
  }

  .service-icon-card.is-active {
    background: var(--c-brand-700);
    color: rgba(255, 255, 255, 0.86);
    border-color: var(--c-brand-700);
    box-shadow: 0 24px 38px -24px rgba(37, 53, 80, 0.48);
    transform: translateY(-3px);
  }

  .service-icon-card.is-active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -14px;
    width: 28px;
    height: 28px;
    background: var(--c-brand-700);
    border-radius: 4px;
    transform: translateX(-50%) rotate(45deg);
    z-index: 1;
    pointer-events: none;
  }

  .service-icon-card span {
    display: block;
    width: 100%;
    font-family: var(--font-display);
    font-size: clamp(0.82rem, 1.15vw, 1rem);
    line-height: 1.15;
    /* Quebra só entre palavras — nunca no meio de uma, com ou sem hífen. */
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .service-tabs {
    margin-top: 0.65rem;
    border-radius: 8px;
    background: var(--c-white);
    border: 1px solid color-mix(in srgb, var(--c-brand-700) 28%, var(--line));
    border-top: 4px solid var(--c-brand-700);
    box-shadow: 0 26px 48px -34px rgba(9, 44, 78, 0.38);
    overflow: hidden;
  }

  .service-panel {
    display: none;
    gap: clamp(1rem, 3vw, 2.2rem);
    align-items: center;
    padding: clamp(0.85rem, 2vw, 1.45rem);
    scroll-margin-top: 120px;
  }

  .service-panel.is-active {
    display: grid;
    animation: service-panel-in 280ms var(--ease-out);
  }

  @keyframes service-panel-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 900px) {
    .service-panel {
      grid-template-columns: 0.86fr 1.14fr;
    }
  }

  .service-panel__media {
    border-radius: 8px;
    overflow: hidden;
    background: var(--c-brand-50);
    border: 1px solid var(--line);
  }

  .service-panel__media img {
    width: 100%;
    aspect-ratio: 4.5 / 3;
    object-fit: cover;
  }

  .service-panel__body {
    max-width: 660px;
    scroll-margin-top: 96px;
  }

  .service-panel__highlights {
    display: grid;
    gap: var(--sp-3);
    margin: var(--sp-4) 0 var(--sp-6);
    padding: 0;
    list-style: none;
  }

  .service-panel__highlights li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }

  .service-panel__highlights :global(.icon) {
    color: var(--c-brand-500);
    margin-top: 3px;
  }

  .service-panel__highlights strong {
    color: var(--text-strong);
  }

  .latest-posts {
    background: var(--bg-subtle);
  }

  .latest-posts .section-head {
    margin-bottom: var(--sp-4);
  }

  .latest-posts .title-lg {
    font-size: clamp(1.75rem, 3.4vw, 2.65rem);
    line-height: 1.05;
  }

  .latest-posts__shell {
    position: relative;
  }

  .latest-posts__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.6vw, 1.1rem);
  }

  .latest-card {
    display: flex;
    min-height: 100%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--c-white);
    box-shadow: 0 18px 36px -30px rgba(9, 44, 78, 0.34);
    animation: latest-card-in 260ms var(--ease-out);
  }

  .latest-card[hidden] {
    display: none;
  }

  @keyframes latest-card-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .latest-card__media {
    display: block;
    overflow: hidden;
    background: var(--c-brand-50);
  }

  .latest-card__media img {
    width: 100%;
    aspect-ratio: 16 / 8.4;
    object-fit: cover;
    transition: transform var(--dur-slow) var(--ease-out);
  }

  .latest-card:hover .latest-card__media img {
    transform: scale(1.035);
  }

  .latest-card__body {
    display: flex;
    flex: 1;
    flex-direction: column;
    gap: var(--sp-2);
    padding: clamp(0.85rem, 1.5vw, 1.05rem);
  }

  .latest-card__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    color: var(--text-faint);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
  }

  .latest-card h3 {
    color: var(--c-brand-800);
    font-size: clamp(1rem, 1.45vw, 1.18rem);
    line-height: var(--lh-snug);
  }

  .latest-card h3 a,
  .latest-card__link {
    color: inherit;
    text-decoration: none;
  }

  .latest-card p {
    color: var(--text-muted);
    font-size: var(--fs-xs);
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .latest-card__link {
    margin-top: auto;
    color: var(--text-strong);
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
  }

  .latest-card__link:hover,
  .latest-card h3 a:hover {
    color: var(--c-brand-600);
  }

  .latest-posts__arrow {
    position: absolute;
    top: 42%;
    z-index: 2;
    display: inline-grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border-radius: var(--r-pill);
    background: var(--c-white);
    color: var(--c-brand-800);
    box-shadow: 0 12px 28px -18px rgba(9, 44, 78, 0.5);
    transform: translateY(-50%);
    transition:
      transform var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .latest-posts__arrow:hover,
  .latest-posts__arrow:focus-visible {
    background: var(--c-brand-700);
    color: #fff;
    transform: translateY(-50%) scale(1.04);
  }

  .latest-posts__arrow--prev {
    left: -21px;
  }

  .latest-posts__arrow--next {
    right: -21px;
  }

  .latest-posts__dots {
    display: flex;
    justify-content: center;
    gap: 0.45rem;
    margin-top: var(--sp-4);
  }

  .latest-posts__dot {
    width: 7px;
    height: 7px;
    border-radius: var(--r-pill);
    background: var(--c-ink-300);
    transition:
      width var(--dur) var(--ease),
      background var(--dur) var(--ease);
  }

  .latest-posts__dot.is-active {
    width: 18px;
    background: var(--c-brand-700);
  }

  .faq {
    background: linear-gradient(180deg, var(--c-ink-50), var(--c-white));
  }

  .faq .section-head {
    max-width: none;
    margin-bottom: var(--sp-5);
  }

  .faq__list {
    display: grid;
    width: 100%;
    gap: var(--sp-2);
  }

  .faq__item {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--c-white);
    box-shadow: var(--shadow-xs);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    width: 100%;
    min-height: 64px;
    padding: var(--sp-4) clamp(1rem, 3vw, 1.6rem);
    color: var(--text-strong);
    font-weight: var(--fw-semibold);
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary :global(.icon) {
    color: var(--c-brand-500);
    transition: transform var(--dur) var(--ease);
  }

  .faq__item[open] summary :global(.icon) {
    transform: rotate(180deg);
  }

  .faq__item p {
    max-width: 76rem;
    padding: 0 clamp(1rem, 3vw, 1.6rem) var(--sp-5);
    color: var(--text-muted);
    font-size: var(--fs-base);
    line-height: var(--lh-relaxed);
  }

  .contact-home {
    background: var(--c-white);
  }

  .contact-home__inner {
    display: grid;
    justify-items: center;
    max-width: 760px;
    text-align: center;
  }

  .contact-home__inner h2 {
    text-align: center;
  }

  .contact-home__button {
    margin-top: var(--sp-6);
  }

  @media (max-width: 700px) {
    /* Celular: cada destaque vira "foto em cima, texto embaixo" (sem texto sobre a
       imagem). Todos os destaques ocupam a mesma célula da grade, então a altura
       do carrossel acompanha o mais alto e o texto nunca é cortado. */
    .hero-carousel__track {
      min-height: 0;
      display: grid;
    }

    .hero-slide {
      position: relative;
      inset: auto;
      grid-area: 1 / 1;
      display: flex;
      flex-direction: column;
    }

    .hero-slide img {
      height: auto;
      aspect-ratio: 16 / 11;
      flex: none;
      /* As artes têm o espaço escuro do texto à esquerda e o assunto à direita:
         no recorte estreito do celular o foco vai para a direita. */
      object-position: 78% 50%;
    }

    .hero-slide__shade {
      display: none;
    }

    .hero-slide__content {
      position: static;
      justify-content: flex-start;
      padding-top: 1.5rem;
      padding-bottom: 3.5rem;
    }

    .hero-slide__copy {
      width: min(100%, 360px);
    }

    .hero-slide h1 {
      max-width: 14ch;
      font-size: clamp(1.6rem, 7vw, 2.4rem);
    }

    .hero-slide__copy > p {
      max-width: 34ch;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .hero-slide__actions .btn {
      width: auto;
      min-width: 0;
      padding-inline: 1rem;
      font-size: 0.85rem;
    }

    .service-icons__grid {
      display: flex;
      gap: var(--sp-3);
      margin-inline: calc(var(--sp-4) * -1);
      padding: 0 var(--sp-4) var(--sp-2);
      overflow-x: auto;
      scroll-margin-top: 78px;
      scroll-padding-inline: var(--sp-4);
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
    }

    .service-icon-card {
      flex: 0 0 clamp(132px, 40vw, 150px);
      min-height: 118px;
      scroll-snap-align: center;
    }

    .service-panel {
      padding: var(--sp-4);
    }

    .service-panel__body {
      scroll-margin-top: 84px;
    }

    .latest-posts__grid {
      grid-template-columns: 1fr;
    }

    .latest-posts__arrow {
      top: auto;
      bottom: -0.2rem;
      transform: none;
    }

    .latest-posts__arrow:hover,
    .latest-posts__arrow:focus-visible {
      transform: scale(1.04);
    }

    .latest-posts__arrow--prev {
      left: 0;
    }

    .latest-posts__arrow--next {
      right: 0;
    }
  }
</style>

<script>
  const heroTrack = document.querySelector<HTMLElement>('[data-hero-interval]');
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-slide-button]')
  );
  const heroIntervalSeconds = Number(heroTrack?.dataset.heroInterval ?? 6);
  const heroIntervalMs =
    Math.min(30, Math.max(3, Number.isFinite(heroIntervalSeconds) ? heroIntervalSeconds : 6)) *
    1000;
  let activeSlide = 0;
  let timer = 0;

  const showSlide = (index: number) => {
    activeSlide = (index + slides.length) % slides.length;
    slides.forEach((slide, current) =>
      slide.classList.toggle('is-active', current === activeSlide)
    );
    buttons.forEach((button, current) =>
      button.classList.toggle('is-active', current === activeSlide)
    );
  };

  const startCarousel = () => {
    window.clearInterval(timer);
    if (slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      timer = window.setInterval(() => showSlide(activeSlide + 1), heroIntervalMs);
    }
  };

  buttons.forEach((button, index) => {
    button.addEventListener('click', () => {
      showSlide(index);
      startCarousel();
    });
  });

  startCarousel();

  const serviceTabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-service-tab]')
  );
  const servicePanels = Array.from(
    document.querySelectorAll<HTMLElement>('[data-service-panel]')
  );
  const serviceMenu = document.querySelector<HTMLElement>('.service-icons__grid');

  const showService = (slug: string) => {
    let activePanel: HTMLElement | undefined;
    let activeTab: HTMLButtonElement | undefined;

    serviceTabs.forEach((tab) => {
      const active = tab.dataset.serviceTab === slug;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
      if (active) activeTab = tab;
    });

    servicePanels.forEach((panel) => {
      const active = panel.dataset.servicePanel === slug;
      panel.classList.toggle('is-active', active);
      panel.hidden = !active;
      if (active) activePanel = panel;
    });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.requestAnimationFrame(() => {
      serviceMenu?.scrollIntoView({
        behavior: reduce ? 'auto' : 'smooth',
        block: 'start',
      });
      activeTab?.scrollIntoView({
        behavior: reduce ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'center',
      });
    });
  };

  serviceTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const slug = tab.dataset.serviceTab;
      if (slug) showService(slug);
    });
  });

  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]'));

  faqItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!item.open) return;
      faqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });

  const postCards = Array.from(document.querySelectorAll<HTMLElement>('[data-post-card]'));
  const postDots = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-post-dot]'));
  const postPrev = document.querySelector<HTMLButtonElement>('[data-post-prev]');
  const postNext = document.querySelector<HTMLButtonElement>('[data-post-next]');
  const postsPerPage = 3;
  const postPageCount = Math.max(1, Math.ceil(postCards.length / postsPerPage));
  let activePostPage = 0;
  let postTimer = 0;

  const showPostPage = (page: number) => {
    activePostPage = (page + postPageCount) % postPageCount;
    const start = activePostPage * postsPerPage;
    const end = start + postsPerPage;

    postCards.forEach((card, index) => {
      card.hidden = index < start || index >= end;
    });
    postDots.forEach((dot, index) => {
      dot.classList.toggle('is-active', index === activePostPage);
    });
  };

  const startPostCarousel = () => {
    window.clearInterval(postTimer);
    if (postPageCount > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      postTimer = window.setInterval(() => showPostPage(activePostPage + 1), 10000);
    }
  };

  postPrev?.addEventListener('click', () => {
    showPostPage(activePostPage - 1);
    startPostCarousel();
  });

  postNext?.addEventListener('click', () => {
    showPostPage(activePostPage + 1);
    startPostCarousel();
  });

  postDots.forEach((dot) => {
    dot.addEventListener('click', () => {
      showPostPage(Number(dot.dataset.postDot ?? 0));
      startPostCarousel();
    });
  });

  if (postCards.length) {
    showPostPage(0);
    startPostCarousel();
  }
</script>
