---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';

import { publishedOnly as publishedServicesOnly } from '../lib/services';
import { getDB } from '../lib/db';
import { getHomeContent } from '../lib/pages';
import { waLink } from '../data/site';

const { whatsapp } = Astro.locals.settings;
const publishedServices = publishedServicesOnly(Astro.locals.services);
const { faqItems } = await getHomeContent(getDB());

const heroSlides = [
  {
    title: 'Presença Técnica onde o cuidado acontece',
    text: 'Atua na rede prestadora, conectando a operadora de saúde à realidade assistencial e apoiando decisões mais assertivas.',
    image: '/images/home/presenca-tecnica.png',
    alt: 'Criança internada sendo acompanhada por profissionais de saúde diversos em ambiente hospitalar',
  },
  {
    title: 'Gestão da Jornada do Paciente',
    text: 'Coordena a transição entre níveis de atenção, assegurando o cuidado adequado, no momento certo e pelo tempo necessário.',
    image: '/images/home/jornada-paciente.png',
    alt: 'Paciente cadeirante sendo acompanhado por profissionais de saúde em ambiente domiciliar',
  },
  {
    title: 'Eficiência Sustentável',
    text: 'Transforma dados fragmentados e cenários imprevisíveis em informação integrada para ampliar a previsibilidade e otimizar custos.',
    image: '/images/home/eficiencia-sustentavel.png',
    alt: 'Gráfico de eficiência e custos representando otimização sustentável em saúde',
  },
  {
    title: 'Inteligência em Saúde',
    text: 'Tecnologia Carefy processa dados com agilidade e precisão, protegendo informações sensíveis e sinalizando riscos e oportunidades.',
    image: '/images/home/inteligencia-saude.png',
    alt: 'Profissional médico utilizando tecnologia para integrar informações de saúde',
  },
];

---

<BaseLayout
  description="Essencial Saúde Auditoria: auditoria concorrente, gestão da jornada do paciente, auditoria de contas hospitalares e soluções técnicas para operadoras, prestadores e beneficiários."
  path="/"
  bodyClass="page-home"
>
  <section class="hero-carousel" aria-label="Destaques da Essencial Saúde">
    <div class="hero-carousel__track">
      {
        heroSlides.map((slide, index) => (
          <article class:list={['hero-slide', index === 0 && 'is-active']} data-slide>
            <img
              src={slide.image}
              alt={slide.alt}
              width="1400"
              height="760"
              fetchpriority={index === 0 ? 'high' : undefined}
              loading={index === 0 ? undefined : 'lazy'}
              decoding="async"
            />
            <div class="hero-slide__shade" aria-hidden="true" />
            <div class="container hero-slide__content">
              <p class="hero-slide__kicker">Auditoria em saúde com presença técnica</p>
              <h1>{slide.title}</h1>
              <p>{slide.text}</p>
              <div class="hero-slide__actions">
                <a href="#servicos" class="btn">
                  Conhecer serviços
                </a>
                <a
                  href={waLink(whatsapp.number, whatsapp.defaultMessage)}
                  class="btn btn--on-brand"
                  target="_blank"
                  rel="noopener"
                >
                  <Icon name="whatsapp" size={17} />
                  Falar com especialista
                </a>
              </div>
            </div>
          </article>
        ))
      }
    </div>

    <div class="hero-carousel__controls container" aria-label="Selecionar destaque">
      {
        heroSlides.map((slide, index) => (
          <button
            type="button"
            class:list={['hero-dot', index === 0 && 'is-active']}
            aria-label={`Ver destaque: ${slide.title}`}
            data-slide-button={index}
          />
        ))
      }
    </div>
  </section>

  <section class="service-icons" id="servicos" aria-labelledby="servicos-title">
    <div class="container">
      <h2 class="sr-only" id="servicos-title">Serviços</h2>

      <div class="service-icons__grid" data-reveal>
        {
          publishedServices.map((service, index) => (
            <button
              type="button"
              class:list={['service-icon-card', index === 0 && 'is-active']}
              id={`tab-${service.slug}`}
              aria-controls={`panel-${service.slug}`}
              aria-selected={index === 0 ? 'true' : 'false'}
              data-service-tab={service.slug}
            >
              <Icon name={service.icon} size={36} strokeWidth={1.55} />
              <span>{service.shortName || service.name}</span>
            </button>
          ))
        }
      </div>

      <div class="service-tabs" aria-label="Conteúdo dos serviços" data-reveal>
        {
          publishedServices.map((service, index) => (
            <article
              class:list={['service-panel', index === 0 && 'is-active']}
              id={`panel-${service.slug}`}
              role="tabpanel"
              aria-labelledby={`tab-${service.slug}`}
              data-service-panel={service.slug}
              hidden={index !== 0}
            >
              <div class="service-panel__media">
                <img
                  src={service.image}
                  alt={service.imageAlt}
                  width="900"
                  height="680"
                  loading="lazy"
                  decoding="async"
                />
              </div>
              <div class="service-panel__body">
                <h2 class="title-md">{service.name}</h2>
                <p class="lead">{service.summary}</p>
                <ul class="service-panel__highlights">
                  {service.highlights.slice(0, 3).map((item) => (
                    <li>
                      <Icon name={item.icon} size={18} />
                      <span>
                        <strong>{item.title}.</strong> {item.text}
                      </span>
                    </li>
                  ))}
                </ul>
                <div class="cluster">
                  <a href={`/servicos/${service.slug}`} class="btn btn--secondary">
                    Ver detalhes
                    <Icon name="arrow-right" size={16} class="icon--arrow" />
                  </a>
                  <a
                    href={waLink(whatsapp.number, service.whatsappMessage)}
                    class="link-arrow"
                    target="_blank"
                    rel="noopener"
                  >
                    Conversar sobre este serviço
                    <Icon name="whatsapp" size={16} />
                  </a>
                </div>
              </div>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section faq" aria-labelledby="faq-title">
    <div class="container">
      <div class="section-head" data-reveal>
        <h2 class="title-lg" id="faq-title">Perguntas frequentes</h2>
      </div>
      <div class="faq__list" data-faq-list data-reveal>
        {
          faqItems.map((item, index) => (
            <details class="faq__item" data-faq-item>
              <summary>
                <span>{item.question}</span>
                <Icon name="chevron-down" size={18} />
              </summary>
              <p>{item.answer}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section section--tight contact-home" id="contato">
    <div class="container contact-home__inner" data-reveal>
      <p class="eyebrow">Contato</p>
      <h2 class="title-lg">Solicite uma apresentação</h2>
      <p class="lead">
        Fale com um especialista e informe seus dados para receber uma conversa técnica sobre o
        escopo mais adequado para sua operação.
      </p>

      <a href="/contato#form-contato" class="btn contact-home__button">
        Fale com um especialista
        <Icon name="arrow-right" size={16} class="icon--arrow" />
      </a>
    </div>
  </section>
</BaseLayout>

<style>
  .hero-carousel {
    position: relative;
    background: var(--c-brand-900);
    overflow: hidden;
  }

  .hero-carousel__track {
    position: relative;
    min-height: clamp(460px, 68vw, 690px);
  }

  .hero-slide {
    position: absolute;
    inset: 0;
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 720ms var(--ease-out),
      visibility 720ms var(--ease-out);
  }

  .hero-slide.is-active {
    opacity: 1;
    visibility: visible;
  }

  .hero-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
  }

  .hero-slide__shade {
    position: absolute;
    inset: 0;
    background:
      linear-gradient(
        90deg,
        rgba(6, 32, 58, 0.78),
        rgba(6, 32, 58, 0.36) 48%,
        rgba(6, 32, 58, 0.04)
      ),
      linear-gradient(0deg, rgba(6, 32, 58, 0.22), rgba(6, 32, 58, 0.08));
  }

  .hero-slide__content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    color: #fff;
    padding-block: clamp(3rem, 8vw, 6rem);
  }

  .hero-slide__kicker {
    font-size: var(--fs-xs);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: rgba(234, 243, 251, 0.86);
  }

  .hero-slide h1 {
    max-width: 12ch;
    margin-top: var(--sp-3);
    color: #fff;
    font-size: clamp(2rem, 4.8vw, 4.2rem);
    line-height: 1.05;
    letter-spacing: 0;
  }

  .hero-slide__content > p:not(.hero-slide__kicker) {
    max-width: 44rem;
    margin-top: var(--sp-4);
    color: rgba(234, 243, 251, 0.9);
    font-size: var(--fs-lg);
  }

  .hero-slide__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    margin-top: var(--sp-8);
  }

  .hero-carousel__controls {
    position: absolute;
    left: 50%;
    right: auto;
    bottom: var(--sp-6);
    transform: translateX(-50%);
    display: flex;
    gap: var(--sp-2);
  }

  .hero-dot {
    width: 42px;
    height: 4px;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.42);
    transition:
      background var(--dur) var(--ease),
      width var(--dur) var(--ease);
  }

  .hero-dot.is-active {
    width: 64px;
    background: #fff;
  }

  .service-icons {
    padding-block: clamp(1.1rem, 3vw, 2rem);
    background: var(--bg-subtle);
  }

  .service-icons__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
    gap: var(--sp-3);
    scroll-margin-top: 92px;
  }

  .service-icon-card {
    appearance: none;
    position: relative;
    min-height: 132px;
    display: grid;
    place-items: center;
    align-content: center;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border-radius: 8px;
    background: var(--c-white);
    color: var(--c-brand-800);
    border: 1px solid rgba(183, 193, 205, 0.42);
    box-shadow: 0 18px 32px -26px rgba(9, 44, 78, 0.42);
    text-align: center;
    text-decoration: none;
    cursor: pointer;
    transition:
      transform var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      background var(--dur) var(--ease),
      color var(--dur) var(--ease);
  }

  .service-icon-card:hover,
  .service-icon-card:focus-visible {
    transform: translateY(-4px);
    box-shadow: 0 24px 36px -24px rgba(9, 44, 78, 0.38);
  }

  .service-icon-card.is-active {
    background: var(--c-brand-700);
    color: rgba(255, 255, 255, 0.86);
    border-color: var(--c-brand-700);
    box-shadow: 0 24px 38px -24px rgba(37, 53, 80, 0.48);
    transform: translateY(-3px);
  }

  .service-icon-card.is-active::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: -14px;
    width: 28px;
    height: 28px;
    background: var(--c-brand-700);
    border-radius: 4px;
    transform: translateX(-50%) rotate(45deg);
    z-index: 1;
    pointer-events: none;
  }

  .service-icon-card span {
    max-width: 13ch;
    font-family: var(--font-display);
    font-size: var(--fs-base);
    line-height: 1.15;
  }

  .service-tabs {
    margin-top: 0.65rem;
    border-radius: 8px;
    background: var(--c-white);
    border: 1px solid color-mix(in srgb, var(--c-brand-700) 28%, var(--line));
    border-top: 4px solid var(--c-brand-700);
    box-shadow: 0 26px 48px -34px rgba(9, 44, 78, 0.38);
    overflow: hidden;
  }

  .service-panel {
    display: none;
    gap: clamp(1rem, 3vw, 2.2rem);
    align-items: center;
    padding: clamp(0.85rem, 2vw, 1.45rem);
    scroll-margin-top: 120px;
  }

  .service-panel.is-active {
    display: grid;
    animation: service-panel-in 280ms var(--ease-out);
  }

  @keyframes service-panel-in {
    from {
      opacity: 0;
      transform: translateY(10px);
    }

    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (min-width: 900px) {
    .service-panel {
      grid-template-columns: 0.86fr 1.14fr;
    }
  }

  .service-panel__media {
    border-radius: 8px;
    overflow: hidden;
    background: var(--c-brand-50);
    border: 1px solid var(--line);
  }

  .service-panel__media img {
    width: 100%;
    aspect-ratio: 4.5 / 3;
    object-fit: cover;
  }

  .service-panel__body {
    max-width: 660px;
    scroll-margin-top: 96px;
  }

  .service-panel__highlights {
    display: grid;
    gap: var(--sp-3);
    margin: var(--sp-4) 0 var(--sp-6);
    padding: 0;
    list-style: none;
  }

  .service-panel__highlights li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-3);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
  }

  .service-panel__highlights :global(.icon) {
    color: var(--c-brand-500);
    margin-top: 3px;
  }

  .service-panel__highlights strong {
    color: var(--text-strong);
  }

  .faq {
    background: linear-gradient(180deg, var(--c-ink-50), var(--c-white));
  }

  .faq .section-head {
    max-width: none;
    margin-bottom: var(--sp-5);
  }

  .faq__list {
    display: grid;
    width: 100%;
    gap: var(--sp-2);
  }

  .faq__item {
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--c-white);
    box-shadow: var(--shadow-xs);
  }

  .faq__item summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-4);
    width: 100%;
    min-height: 64px;
    padding: var(--sp-4) clamp(1rem, 3vw, 1.6rem);
    color: var(--text-strong);
    font-weight: var(--fw-semibold);
    cursor: pointer;
  }

  .faq__item summary::-webkit-details-marker {
    display: none;
  }

  .faq__item summary :global(.icon) {
    color: var(--c-brand-500);
    transition: transform var(--dur) var(--ease);
  }

  .faq__item[open] summary :global(.icon) {
    transform: rotate(180deg);
  }

  .faq__item p {
    max-width: 76rem;
    padding: 0 clamp(1rem, 3vw, 1.6rem) var(--sp-5);
    color: var(--text-muted);
    font-size: var(--fs-base);
    line-height: var(--lh-relaxed);
  }

  .contact-home {
    background: var(--c-white);
  }

  .contact-home__inner {
    display: grid;
    justify-items: center;
    max-width: 760px;
    text-align: center;
  }

  .contact-home__button {
    margin-top: var(--sp-6);
  }

  @media (max-width: 700px) {
    .hero-carousel__track {
      min-height: 560px;
    }

    .hero-slide__shade {
      background: linear-gradient(0deg, rgba(6, 32, 58, 0.78), rgba(6, 32, 58, 0.28));
    }

    .hero-slide__content {
      justify-content: flex-end;
      padding-bottom: 5.5rem;
    }

    .hero-slide h1 {
      max-width: 14ch;
    }

    .hero-slide__actions .btn {
      width: 100%;
    }

    .service-icons__grid {
      display: flex;
      gap: var(--sp-3);
      margin-inline: calc(var(--sp-4) * -1);
      padding: 0 var(--sp-4) var(--sp-2);
      overflow-x: auto;
      scroll-margin-top: 78px;
      scroll-padding-inline: var(--sp-4);
      scroll-snap-type: x mandatory;
      scrollbar-width: thin;
    }

    .service-icon-card {
      flex: 0 0 min(38vw, 126px);
      min-height: 118px;
      scroll-snap-align: center;
    }

    .service-panel {
      padding: var(--sp-4);
    }

    .service-panel__body {
      scroll-margin-top: 84px;
    }
  }
</style>

<script>
  const slides = Array.from(document.querySelectorAll<HTMLElement>('[data-slide]'));
  const buttons = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-slide-button]')
  );
  let activeSlide = 0;
  let timer = 0;

  const showSlide = (index: number) => {
    activeSlide = (index + slides.length) % slides.length;
    slides.forEach((slide, current) =>
      slide.classList.toggle('is-active', current === activeSlide)
    );
    buttons.forEach((button, current) =>
      button.classList.toggle('is-active', current === activeSlide)
    );
  };

  const startCarousel = () => {
    window.clearInterval(timer);
    if (slides.length > 1 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
      timer = window.setInterval(() => showSlide(activeSlide + 1), 5600);
    }
  };

  buttons.forEach((button, index) => {
    button.addEventListener('click', () => {
      showSlide(index);
      startCarousel();
    });
  });

  startCarousel();

  const serviceTabs = Array.from(
    document.querySelectorAll<HTMLButtonElement>('[data-service-tab]')
  );
  const servicePanels = Array.from(
    document.querySelectorAll<HTMLElement>('[data-service-panel]')
  );
  const serviceMenu = document.querySelector<HTMLElement>('.service-icons__grid');

  const showService = (slug: string) => {
    let activePanel: HTMLElement | undefined;
    let activeTab: HTMLButtonElement | undefined;

    serviceTabs.forEach((tab) => {
      const active = tab.dataset.serviceTab === slug;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
      if (active) activeTab = tab;
    });

    servicePanels.forEach((panel) => {
      const active = panel.dataset.servicePanel === slug;
      panel.classList.toggle('is-active', active);
      panel.hidden = !active;
      if (active) activePanel = panel;
    });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    window.requestAnimationFrame(() => {
      serviceMenu?.scrollIntoView({
        behavior: reduce ? 'auto' : 'smooth',
        block: 'start',
      });
      activeTab?.scrollIntoView({
        behavior: reduce ? 'auto' : 'smooth',
        block: 'nearest',
        inline: 'center',
      });
    });
  };

  serviceTabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const slug = tab.dataset.serviceTab;
      if (slug) showService(slug);
    });
  });

  const faqItems = Array.from(document.querySelectorAll<HTMLDetailsElement>('[data-faq-item]'));

  faqItems.forEach((item) => {
    item.addEventListener('toggle', () => {
      if (!item.open) return;
      faqItems.forEach((other) => {
        if (other !== item) other.open = false;
      });
    });
  });
</script>
