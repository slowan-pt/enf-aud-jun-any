---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import SectionOverlays from '../../components/SectionOverlays.astro';
import { publishedOnly, findBySlug } from '../../lib/services';
import { seo, waLink } from '../../data/site';
import { getDB } from '../../lib/db';
import { getServicosContent } from '../../lib/documents';
import { getServiceEditorContent, resolveServicePageStyle } from '../../lib/service-editor';
import { sectionStyleAttr, layoutStylesheet, pageStyleOverride } from '../../lib/pages';

const { company, whatsapp } = Astro.locals.settings;

const edit = Boolean(Astro.locals.editMode);
const ed = <T,>(value: T): T | undefined => (edit ? value : undefined);
const editMode = Astro.url.searchParams.get('__edit') === '1' && Boolean(Astro.locals.user);

const publishedServices = publishedOnly(Astro.locals.services);
// Em modo de edição, o admin precisa conseguir pré-visualizar um serviço
// ainda não publicado (rascunho) dentro do próprio Editor Visual — fora do
// editor, a regra de sempre continua: só serviço publicado é encontrado.
const lookupPool = editMode ? Astro.locals.services : publishedServices;
const service = findBySlug(lookupPool, Astro.params.slug ?? '');
if (!service) return Astro.rewrite('/404');

const db = getDB();
const moldura = await getServicosContent(db);
const {
  pageStyle: servicePageStyle,
  sectionStyles,
  sectionOrder,
  hiddenSections,
  layouts,
  overlays,
  imageStyle,
} = await getServiceEditorContent(db, service.id);

const effectivePageStyle = resolveServicePageStyle(moldura.pageStyle, servicePageStyle);
const layoutCss = layoutStylesheet(layouts, overlays);

const isHidden = (key: string) => (hiddenSections as string[]).includes(key);
const secClass = (key: string) =>
  isHidden(key) ? (editMode ? 'is-section-off-preview' : 'is-section-off') : '';
const slotOf = new Map<string, number>();
sectionOrder.forEach((key, index) => slotOf.set(key, index));
const secStyle = (key: string, style: (typeof sectionStyles)[keyof typeof sectionStyles]) =>
  [sectionStyleAttr(style), `order:${slotOf.get(key) ?? 0}`].filter(Boolean).join(';');

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.summary,
  serviceType: service.name,
  url: new URL(`/servicos/${service.slug}`, seo.siteUrl).href,
  areaServed: 'BR',
  provider: {
    '@type': 'Organization',
    name: company.name,
    url: seo.siteUrl,
  },
};
---

<BaseLayout
  title={service.seo.title.replace(' | Essencial Saúde Auditoria', '')}
  description={service.seo.description}
  path={`/servicos/${service.slug}`}
  ogImage={service.image}
  jsonLd={[serviceLd]}
  whatsappMessage={service.whatsappMessage}
  colorOverride={pageStyleOverride(effectivePageStyle)}
  bodyClass="page-servico"
>
  <div style="order:-1">
    <PageHero
      eyebrow="Serviço"
      title={service.heroTitle}
      lead={service.heroLead}
      crumbs={[{ label: 'Serviços', href: '/servicos' }, { label: service.name }]}
      image={service.image}
      imageAlt={service.imageAlt}
      imageEditPath={ed('image')}
      bgImage={service.heroBg}
      bgImageAlt={service.heroBgAlt}
      bgEditPath={ed('heroBg')}
      imageFit={imageStyle.fit}
      imagePosX={imageStyle.posX}
      imagePosY={imageStyle.posY}
      titleEditPath={ed('heroTitle')}
      leadEditPath={ed('heroLead')}
    >
      <div class="cluster hero-actions">
        <a href="/contato#form-contato" class="btn btn--on-brand">
          Solicitar apresentação
          <Icon name="arrow-right" size={16} class="icon--arrow" />
        </a>
        <a
          href={waLink(whatsapp.number, service.whatsappMessage)}
          class="btn btn--outline-on-brand"
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={16} />
          Falar no WhatsApp
        </a>
      </div>
    </PageHero>
  </div>

  <!-- ------------------------------------------------- destaques -->
  <section
    class:list={['section', 'section--tight', secClass('highlights')]}
    style={secStyle('highlights', sectionStyles.highlights)}
    data-section="highlights"
    data-section-label={ed('Destaques')}
  >
    <div class="container">
      <div class="grid grid--4" data-edit-list={ed('highlights')}>
        {
          service.highlights.map((item, index) => (
            <article
              class="card highlight"
              data-reveal
              data-card-key={`hl-${item.id ?? index}`.toLowerCase().replace(/[^a-z0-9-]/g, '')}
              data-edit-item={ed(index)}
            >
              <span class="icon-badge icon-badge--accent icon-badge--sm">
                <Icon
                  name={item.icon}
                  size={18}
                  data-edit={`highlights.${index}.icon`}
                  data-layout-key={item.id && ed(`highlights.${item.id}.icon`)}
                  data-edit-kind={ed('icon')}
                  data-edit-value={item.icon}
                  data-edit-label={ed('Ícone')}
                />
              </span>
              <h2
                data-edit={`highlights.${index}.title`}
                data-layout-key={item.id && ed(`highlights.${item.id}.title`)}
                data-edit-label={ed('Título do destaque')}
              >
                {item.title}
              </h2>
              <p
                data-edit={`highlights.${index}.text`}
                data-layout-key={item.id && ed(`highlights.${item.id}.text`)}
                data-edit-kind={ed('multiline')}
                data-edit-label={ed('Texto do destaque')}
              >
                {item.text}
              </p>
            </article>
          ))
        }
      </div>
      <SectionOverlays section="highlights" overlays={overlays} />
    </div>
  </section>

  <!-- ---------------------------------------------- conteúdo -->
  <section
    class:list={['section', 'section--tight', secClass('content')]}
    style={secStyle('content', sectionStyles.content)}
    data-section="content"
    data-section-label={ed('Conteúdo e barra lateral')}
  >
    <div class="container svc-layout">
      <article class="svc-content">
        <div class="prose" data-reveal data-edit-list={ed('intro')}>
          {
            service.intro.map((paragraph, index) => (
              <p
                data-edit={`intro.${index}`}
                data-edit-kind={ed('multiline')}
                data-edit-item={ed(index)}
              >
                {paragraph}
              </p>
            ))
          }
        </div>

        <div data-edit-list={ed('blocks')}>
          {
            service.blocks.map((block, index) => (
              <div class="svc-block" data-reveal data-edit-item={ed(index)}>
                <h2
                  class="title-md"
                  data-edit={`blocks.${index}.title`}
                  data-layout-key={block.id && ed(`blocks.${block.id}.title`)}
                  data-edit-label={ed('Título do bloco')}
                >
                  {block.title}
                </h2>
                {(block.text || (edit && typeof block.text === 'string')) && (
                  <p
                    class="svc-block__text"
                    data-edit={`blocks.${index}.text`}
                    data-layout-key={block.id && ed(`blocks.${block.id}.text`)}
                    data-edit-kind={ed('multiline')}
                    data-edit-label={ed('Texto do bloco')}
                  >
                    {block.text}
                  </p>
                )}
                {block.items?.length ? (
                  <ul class="check-list" data-edit-list={ed(`blocks.${index}.items`)}>
                    {block.items.map((item, itemIndex) => (
                      <li data-edit-item={ed(itemIndex)}>
                        <span class="icon-badge icon-badge--accent icon-badge--sm">
                          <Icon name="check" size={16} />
                        </span>
                        <span
                          data-edit={`blocks.${index}.items.${itemIndex}`}
                          data-edit-label={ed('Item')}
                        >
                          {item}
                        </span>
                      </li>
                    ))}
                  </ul>
                ) : null}
              </div>
            ))
          }
        </div>
      </article>

      <aside class="svc-aside">
        <div class="aside-card" data-reveal data-card-key="aside-deliverables">
          <h2 class="aside-card__title">
            <Icon name="file-check" size={18} />
            <span data-edit="aside.deliverablesTitle" data-edit-label={ed('Título da lista')}>
              {service.aside.deliverablesTitle}
            </span>
          </h2>
          <ul class="aside-list" data-edit-list={ed('deliverables')}>
            {
              service.deliverables.map((item, index) => (
                <li data-edit-item={ed(index)}>
                  <Icon name="check" size={15} />
                  <span data-edit={`deliverables.${index}`} data-edit-label={ed('Item')}>
                    {item}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="aside-card" data-reveal data-card-key="aside-audience">
          <h2 class="aside-card__title">
            <Icon name="users" size={18} />
            <span data-edit="aside.audienceTitle" data-edit-label={ed('Título da lista')}>
              {service.aside.audienceTitle}
            </span>
          </h2>
          <ul class="aside-list" data-edit-list={ed('audience')}>
            {
              service.audience.map((item, index) => (
                <li data-edit-item={ed(index)}>
                  <Icon name="check" size={15} />
                  <span data-edit={`audience.${index}`} data-edit-label={ed('Item')}>
                    {item}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="aside-card aside-card--cta" data-reveal>
          <h2
            class="title-sm"
            data-edit="aside.ctaTitle"
            data-edit-label={ed('Título do contato')}
          >
            {service.aside.ctaTitle}
          </h2>
          <p
            data-edit="aside.ctaText"
            data-edit-kind={ed('multiline')}
            data-edit-label={ed('Texto do contato')}
          >
            {service.aside.ctaText}
          </p>
          <a
            href={waLink(whatsapp.number, service.whatsappMessage)}
            class="btn btn--accent btn--block"
            target="_blank"
            rel="noopener"
          >
            <Icon name="whatsapp" size={18} />
            <span data-edit="aside.whatsappLabel" data-edit-label={ed('Texto do botão WhatsApp')}>
              {service.aside.whatsappLabel || company.phoneDisplay}
            </span>
          </a>
          <a href="/contato#form-contato" class="btn btn--secondary btn--block">
            <span data-edit="aside.ctaButtonLabel" data-edit-label={ed('Texto do botão')}>
              {service.aside.ctaButtonLabel}
            </span>
          </a>
        </div>
      </aside>
      <SectionOverlays section="content" overlays={overlays} />
    </div>
  </section>

  {layoutCss && <style is:inline set:html={layoutCss} />}

  {
    editMode && (
      <>
        <script is:inline src="/vendor/moveable.min.js" />
        <script is:inline src="/editor-runtime.js" />
      </>
    )
  }
</BaseLayout>

<style is:global>
  body.page-servico main {
    display: flex;
    flex-direction: column;
  }

  body.page-servico main > section {
    position: relative;
    container-type: inline-size;
  }

  .is-section-off {
    display: none;
  }

  .is-section-off-preview {
    opacity: 0.35;
    filter: grayscale(0.6);
  }
</style>

<style>
  .hero-actions {
    margin-top: var(--sp-8);
  }

  @media (max-width: 480px) {
    .hero-actions :global(.btn) {
      width: 100%;
    }
  }

  .highlight h2 {
    font-size: var(--fs-base);
  }

  .highlight p {
    font-size: var(--fs-xs);
  }

  .svc-layout {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .svc-layout {
      grid-template-columns: minmax(0, 1fr) 340px;
    }
  }

  .svc-content > * + * {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .svc-block__text {
    margin: var(--sp-4) 0 var(--sp-5);
    color: var(--text-muted);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    max-width: 68ch;
    white-space: pre-line;
  }

  .svc-block + .svc-block {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .svc-block .check-list {
    max-width: 68ch;
  }

  /* Listas com check seguem exatamente o corpo do texto do bloco: só o marcador muda. */
  .svc-block .check-list li {
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    color: var(--text-muted);
  }

  .svc-aside {
    display: grid;
    gap: var(--sp-4);
  }

  @media (min-width: 1000px) {
    .svc-aside {
      position: sticky;
      top: 120px;
    }
  }

  .aside-card {
    padding: var(--sp-5);
    background: var(--card-bg, var(--c-white));
    border: 1px solid var(--card-border, var(--line));
    border-top: 3px solid var(--card-accent, var(--line));
    border-radius: var(--r-lg);
  }

  .aside-card__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    font-family: var(--font-text);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-brand-600);
    margin-bottom: var(--sp-4);
  }

  .aside-list {
    display: grid;
    gap: var(--sp-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .aside-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-2);
    align-items: start;
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--text-muted);
  }

  .aside-list :global(.icon) {
    color: var(--c-accent-600);
    margin-top: 3px;
  }

  .aside-card--cta {
    display: grid;
    gap: var(--sp-3);
    background: linear-gradient(160deg, var(--c-brand-50), var(--c-white));
    border-color: var(--c-brand-100);
  }

  .aside-card--cta p {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: var(--lh-relaxed);
  }

</style>
