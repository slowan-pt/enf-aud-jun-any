---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import ContactForm from '../../components/ContactForm.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import SectionOverlays from '../../components/SectionOverlays.astro';
import { publishedOnly, findBySlug } from '../../lib/services';
import { seo, waLink } from '../../data/site';
import { getDB } from '../../lib/db';
import { getServicosContent } from '../../lib/documents';
import { getServiceEditorContent, resolveServicePageStyle } from '../../lib/service-editor';
import { sectionStyleAttr, layoutStylesheet, pageStyleOverride } from '../../lib/pages';

const { company, whatsapp } = Astro.locals.settings;

const edit = Boolean(Astro.locals.editMode);
const ed = <T,>(value: T): T | undefined => (edit ? value : undefined);
const editMode = Astro.url.searchParams.get('__edit') === '1' && Boolean(Astro.locals.user);

const publishedServices = publishedOnly(Astro.locals.services);
// Em modo de edição, o admin precisa conseguir pré-visualizar um serviço
// ainda não publicado (rascunho) dentro do próprio Editor Visual — fora do
// editor, a regra de sempre continua: só serviço publicado é encontrado.
const lookupPool = editMode ? Astro.locals.services : publishedServices;
const service = findBySlug(lookupPool, Astro.params.slug ?? '');
if (!service) return Astro.rewrite('/404');
const others = publishedServices.filter((item) => item.slug !== service.slug).slice(0, 3);

const db = getDB();
const moldura = await getServicosContent(db);
const {
  pageStyle: servicePageStyle,
  sectionStyles,
  sectionOrder,
  hiddenSections,
  layouts,
  overlays,
} = await getServiceEditorContent(db, service.id);

const effectivePageStyle = resolveServicePageStyle(moldura.pageStyle, servicePageStyle);
const layoutCss = layoutStylesheet(layouts, overlays);

const isHidden = (key: string) => (hiddenSections as string[]).includes(key);
const secClass = (key: string) =>
  isHidden(key) ? (editMode ? 'is-section-off-preview' : 'is-section-off') : '';
const slotOf = new Map<string, number>();
sectionOrder.forEach((key, index) => slotOf.set(key, index));
const secStyle = (key: string, style: (typeof sectionStyles)[keyof typeof sectionStyles]) =>
  [sectionStyleAttr(style), `order:${slotOf.get(key) ?? 0}`].filter(Boolean).join(';');

const serviceLd = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  name: service.name,
  description: service.summary,
  serviceType: service.name,
  url: new URL(`/servicos/${service.slug}`, seo.siteUrl).href,
  areaServed: 'BR',
  provider: {
    '@type': 'Organization',
    name: company.name,
    url: seo.siteUrl,
  },
};
---

<BaseLayout
  title={service.seo.title.replace(' | Essencial Saúde Auditoria', '')}
  description={service.seo.description}
  path={`/servicos/${service.slug}`}
  ogImage={service.image}
  jsonLd={[serviceLd]}
  whatsappMessage={service.whatsappMessage}
  colorOverride={pageStyleOverride(effectivePageStyle)}
  bodyClass="page-servico"
>
  <div style="order:-1">
    <PageHero
      eyebrow="Serviço"
      title={service.heroTitle}
      lead={service.heroLead}
      crumbs={[{ label: 'Serviços', href: '/servicos' }, { label: service.name }]}
      image={service.image}
      imageAlt={service.imageAlt}
    >
      <div class="cluster hero-actions">
        <a href="#solicitar" class="btn btn--on-brand">
          Solicitar apresentação
          <Icon name="arrow-right" size={16} class="icon--arrow" />
        </a>
        <a
          href={waLink(whatsapp.number, service.whatsappMessage)}
          class="btn btn--outline-on-brand"
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={16} />
          Falar no WhatsApp
        </a>
      </div>
    </PageHero>
  </div>

  <!-- ------------------------------------------------- destaques -->
  <section
    class:list={['section', 'section--tight', secClass('highlights')]}
    style={secStyle('highlights', sectionStyles.highlights)}
    data-section="highlights"
    data-section-label={ed('Destaques')}
  >
    <div class="container">
      <div class="grid grid--4">
        {
          service.highlights.map((item) => (
            <article class="card highlight" data-reveal>
              <span class="icon-badge icon-badge--accent icon-badge--sm">
                <Icon name={item.icon} size={18} />
              </span>
              <h2>{item.title}</h2>
              <p>{item.text}</p>
            </article>
          ))
        }
      </div>
      <SectionOverlays section="highlights" overlays={overlays} />
    </div>
  </section>

  <!-- ---------------------------------------------- conteúdo -->
  <section
    class:list={['section', 'section--tight', secClass('content')]}
    style={secStyle('content', sectionStyles.content)}
    data-section="content"
    data-section-label={ed('Conteúdo e barra lateral')}
  >
    <div class="container svc-layout">
      <article class="svc-content">
        <div class="prose" data-reveal data-edit-list={ed('intro')}>
          {
            service.intro.map((paragraph, index) => (
              <p
                data-edit={`intro.${index}`}
                data-edit-kind={ed('multiline')}
                data-edit-item={ed(index)}
              >
                {paragraph}
              </p>
            ))
          }
        </div>

        {
          service.blocks.map((block) => (
            <div class="svc-block" data-reveal>
              <h2 class="title-md">{block.title}</h2>
              {block.text && <p class="svc-block__text">{block.text}</p>}
              {block.items && (
                <ul class="check-list">
                  {block.items.map((item) => (
                    <li>
                      <Icon name="check-circle" size={18} />
                      <span>{item}</span>
                    </li>
                  ))}
                </ul>
              )}
            </div>
          ))
        }
      </article>

      <aside class="svc-aside">
        <div class="aside-card" data-reveal>
          <h2 class="aside-card__title">
            <Icon name="file-check" size={18} />
            O que entregamos
          </h2>
          <ul class="aside-list" data-edit-list={ed('deliverables')}>
            {
              service.deliverables.map((item, index) => (
                <li>
                  <Icon name="check" size={15} />
                  <span data-edit={`deliverables.${index}`} data-edit-item={ed(index)}>
                    {item}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="aside-card" data-reveal>
          <h2 class="aside-card__title">
            <Icon name="users" size={18} />
            Para quem
          </h2>
          <ul class="aside-list" data-edit-list={ed('audience')}>
            {
              service.audience.map((item, index) => (
                <li>
                  <Icon name="check" size={15} />
                  <span data-edit={`audience.${index}`} data-edit-item={ed(index)}>
                    {item}
                  </span>
                </li>
              ))
            }
          </ul>
        </div>

        <div class="aside-card aside-card--cta" data-reveal>
          <h2 class="title-sm">Fale com a equipe técnica</h2>
          <p>
            Tire dúvidas sobre escopo, método e indicadores de acompanhamento deste serviço.
          </p>
          <a
            href={waLink(whatsapp.number, service.whatsappMessage)}
            class="btn btn--accent btn--block"
            target="_blank"
            rel="noopener"
          >
            <Icon name="whatsapp" size={18} />
            {company.phoneDisplay}
          </a>
          <a href="#solicitar" class="btn btn--secondary btn--block">Solicitar apresentação</a>
        </div>
      </aside>
      <SectionOverlays section="content" overlays={overlays} />
    </div>
  </section>

  <!-- ------------------------------------------------ formulário -->
  <section
    class:list={['section', 'section--subtle', secClass('form')]}
    style={secStyle('form', sectionStyles.form)}
    data-section="form"
    data-section-label={ed('Formulário')}
    id="solicitar"
  >
    <div class="container form-layout">
      <div data-reveal>
        <p class="eyebrow">Solicitar apresentação</p>
        <h2 class="title-lg">Converse com a Essencial sobre {service.shortName}</h2>
        <p class="lead" style="margin-top: var(--sp-4)">
          Preencha o formulário com o cenário da sua organização. O campo “serviço de interesse”
          já vem preenchido com <strong>{service.name}</strong>.
        </p>
        <ul class="check-list" style="margin-top: var(--sp-6)">
          <li>
            <Icon name="check-circle" size={18} />
            <span>Retorno em horário comercial</span>
          </li>
          <li>
            <Icon name="check-circle" size={18} />
            <span>Conversa técnica, sem compromisso</span>
          </li>
          <li>
            <Icon name="check-circle" size={18} />
            <span>Apresentação do método e do escopo</span>
          </li>
        </ul>
      </div>
      <div data-reveal>
        <ContactForm
          variant="commercial"
          id={`form-${service.slug}`}
          title="Solicite uma apresentação"
          preselectedService={service.name}
          origin={`Serviço: ${service.name}`}
        />
      </div>
      <SectionOverlays section="form" overlays={overlays} />
    </div>
  </section>

  <!-- --------------------------------------------- outros serviços -->
  <section
    class:list={['section', secClass('others')]}
    style={secStyle('others', sectionStyles.others)}
    data-section="others"
    data-section-label={ed('Outros serviços')}
  >
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Outros serviços</p>
        <h2 class="title-md">Complemente com outras frentes de atuação</h2>
      </div>
      <div class="grid grid--3">
        {others.map((item) => <ServiceCard service={item} variant="compact" />)}
      </div>
      <SectionOverlays section="others" overlays={overlays} />
    </div>
  </section>

  {layoutCss && <style is:inline set:html={layoutCss} />}

  {
    editMode && (
      <>
        <script is:inline src="/vendor/moveable.min.js" />
        <script is:inline src="/editor-runtime.js" />
      </>
    )
  }
</BaseLayout>

<style is:global>
  body.page-servico main {
    display: flex;
    flex-direction: column;
  }

  body.page-servico main > section {
    position: relative;
    container-type: inline-size;
  }

  .is-section-off {
    display: none;
  }

  .is-section-off-preview {
    opacity: 0.35;
    filter: grayscale(0.6);
  }
</style>

<style>
  .hero-actions {
    margin-top: var(--sp-8);
  }

  @media (max-width: 480px) {
    .hero-actions :global(.btn) {
      width: 100%;
    }
  }

  .highlight h2 {
    font-size: var(--fs-base);
  }

  .highlight p {
    font-size: var(--fs-xs);
  }

  .svc-layout {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 1000px) {
    .svc-layout {
      grid-template-columns: minmax(0, 1fr) 340px;
    }
  }

  .svc-content > * + * {
    margin-top: clamp(2rem, 4vw, 3rem);
  }

  .svc-block__text {
    margin: var(--sp-4) 0 var(--sp-5);
    color: var(--text-muted);
    font-size: var(--fs-md);
    line-height: var(--lh-relaxed);
    max-width: 68ch;
  }

  .svc-block .check-list {
    max-width: 68ch;
  }

  .svc-aside {
    display: grid;
    gap: var(--sp-4);
  }

  @media (min-width: 1000px) {
    .svc-aside {
      position: sticky;
      top: 120px;
    }
  }

  .aside-card {
    padding: var(--sp-5);
    background: var(--c-white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }

  .aside-card__title {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: var(--fs-xs);
    font-family: var(--font-text);
    font-weight: var(--fw-semibold);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-brand-600);
    margin-bottom: var(--sp-4);
  }

  .aside-list {
    display: grid;
    gap: var(--sp-3);
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .aside-list li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-2);
    align-items: start;
    font-size: var(--fs-sm);
    line-height: var(--lh-normal);
    color: var(--text-muted);
  }

  .aside-list :global(.icon) {
    color: var(--c-accent-600);
    margin-top: 3px;
  }

  .aside-card--cta {
    display: grid;
    gap: var(--sp-3);
    background: linear-gradient(160deg, var(--c-brand-50), var(--c-white));
    border-color: var(--c-brand-100);
  }

  .aside-card--cta p {
    font-size: var(--fs-sm);
    color: var(--text-muted);
    line-height: var(--lh-relaxed);
  }

  .form-layout {
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: start;
  }

  @media (min-width: 980px) {
    .form-layout {
      grid-template-columns: 0.85fr 1.15fr;
    }
  }
</style>
