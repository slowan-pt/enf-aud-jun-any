---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import ContactForm from '../components/ContactForm.astro';
import PageHero from '../components/PageHero.astro';
import SectionOverlays from '../components/SectionOverlays.astro';
import { waLink, seo } from '../data/site';
import { getDB } from '../lib/db';
import { getContatoContent, formatBrPhoneDisplay } from '../lib/documents';
import { sectionStyleAttr, layoutStylesheet, pageStyleOverride } from '../lib/pages';
import type { SectionStyle } from '../lib/pages';

const { company, whatsapp } = Astro.locals.settings;

const edit = Boolean(Astro.locals.editMode);
const ed = <T,>(value: T): T | undefined => (edit ? value : undefined);

const db = getDB();
const {
  hero,
  formTitle,
  formDescription,
  contactOverrides,
  pageStyle,
  sectionStyles,
  sectionOrder,
  hiddenSections,
  layouts,
  overlays,
} = await getContatoContent(db);

const layoutCss = layoutStylesheet(layouts, overlays);
const editMode = Astro.url.searchParams.get('__edit') === '1' && Boolean(Astro.locals.user);

const isHidden = (key: string) => (hiddenSections as string[]).includes(key);
const secClass = (key: string) =>
  isHidden(key) ? (editMode ? 'is-section-off-preview' : 'is-section-off') : '';
const slotOf = new Map<string, number>();
sectionOrder.forEach((key, index) => slotOf.set(key, index));
const secStyle = (key: string, style: SectionStyle) =>
  [sectionStyleAttr(style), `order:${slotOf.get(key) ?? 0}`].filter(Boolean).join(';');

// Cada dado herda do global a menos que esta página tenha sobrescrita — nunca
// duplicado silenciosamente (ver ContatoOverrides em src/lib/documents.ts).
// Os links (tel:/wa.me) sempre usam a MESMA fonte do texto mostrado, nunca
// uma mistura entre valor global e personalizado.
const effectivePhoneRaw = contactOverrides.phone || company.phoneRaw;
const effectivePhoneDisplay = contactOverrides.phone
  ? formatBrPhoneDisplay(contactOverrides.phone)
  : company.phoneDisplay;
const effectiveWhatsappNumber = contactOverrides.whatsapp || whatsapp.number;
// Texto e link do canal WhatsApp vêm da MESMA fonte (a sobrescrita de
// WhatsApp, não a de telefone) — as duas são independentes: alguém pode
// customizar só o telefone sem tocar no WhatsApp, ou vice-versa.
const effectiveWhatsappDisplay = contactOverrides.whatsapp
  ? formatBrPhoneDisplay(contactOverrides.whatsapp)
  : company.phoneDisplay;
const effectiveEmail = contactOverrides.email || company.email;
// Mensagem pré-preenchida dos links de WhatsApp DESTA página — nunca a
// mensagem que o visitante escreve no formulário (são dados diferentes).
const effectiveWhatsappMessage = contactOverrides.whatsappMessage || whatsapp.defaultMessage;
const effectiveHours = contactOverrides.hours || company.hours;
const contactLd = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contato — Essencial Saúde Auditoria',
  url: new URL('/contato', seo.siteUrl).href,
};

const channels = [
  {
    icon: 'whatsapp',
    title: 'WhatsApp',
    text: effectiveWhatsappDisplay,
    href: waLink(effectiveWhatsappNumber, effectiveWhatsappMessage),
    hint: 'Resposta em horário comercial',
    external: true,
  },
  {
    icon: 'mail',
    title: 'E-mail',
    text: effectiveEmail,
    href: `mailto:${effectiveEmail}`,
    hint: 'Para propostas e documentos',
    external: false,
  },
  {
    icon: 'phone',
    title: 'Telefone',
    text: effectivePhoneDisplay,
    href: `tel:+${effectivePhoneRaw}`,
    hint: effectiveHours,
    external: false,
  },
];
---

<BaseLayout
  title="Contato"
  description="Fale com a Essencial Saúde Auditoria: WhatsApp, e-mail, telefone e endereço em Brasília - DF. Solicite uma apresentação dos nossos serviços."
  path="/contato"
  jsonLd={[contactLd]}
  colorOverride={pageStyleOverride(pageStyle)}
  bodyClass="page-contato"
  whatsappMessage={effectiveWhatsappMessage}
>
  <div style="order:-1">
    <PageHero
      eyebrow={hero.eyebrow}
      title={hero.title}
      lead={hero.lead}
      crumbs={[{ label: 'Contato' }]}
      bgImage={hero.bg}
      bgImageAlt={hero.bgAlt}
      bgEditPath={ed('hero.bg')}
      eyebrowEditPath={ed('hero.eyebrow')}
      titleEditPath={ed('hero.title')}
      leadEditPath={ed('hero.lead')}
    />
  </div>

  <section
    class:list={['section', 'section--tight', secClass('form')]}
    style={secStyle('form', sectionStyles.form)}
    data-section="form"
    data-section-label={ed('Formulário e informações')}
  >
    <div class="container contact-layout">
      <div data-reveal>
        <ContactForm
          variant="full"
          id="form-contato"
          title={formTitle}
          description={formDescription}
          origin="Página de contato"
        />
      </div>
      <SectionOverlays section="form" overlays={overlays} />
    </div>
  </section>

  <section
    class:list={['section', 'section--tight', secClass('channels')]}
    style={secStyle('channels', sectionStyles.channels)}
    data-section="channels"
    data-section-label={ed('Canais de contato')}
  >
    <div class="container">
      <div class="channels">
        {
          channels.map((channel) => (
            <a
              class:list={['channel', channel.icon === 'whatsapp' && 'channel--whatsapp']}
              href={channel.href}
              target={channel.external ? '_blank' : undefined}
              rel={channel.external ? 'noopener' : undefined}
              data-reveal
            >
              <span class="icon-badge">
                <Icon name={channel.icon} size={22} />
              </span>
              <span class="channel__body">
                <strong>{channel.title}</strong>
                <span class="channel__value">{channel.text}</span>
                <span class="channel__hint">{channel.hint}</span>
              </span>
              <Icon name="arrow-up-right" size={18} class="channel__arrow" />
            </a>
          ))
        }
      </div>
      <SectionOverlays section="channels" overlays={overlays} />
    </div>
  </section>

  {layoutCss && <style is:inline set:html={layoutCss} />}

  {
    editMode && (
      <>
        <script is:inline src="/vendor/moveable.min.js" />
        <script is:inline src="/editor-runtime.js" />
      </>
    )
  }
</BaseLayout>

<style is:global>
  body.page-contato main {
    display: flex;
    flex-direction: column;
  }

  body.page-contato main > section {
    position: relative;
    container-type: inline-size;
  }

  body.page-contato main > section:first-of-type {
    padding-top: clamp(1rem, 2.5vw, 2rem);
  }

  .is-section-off {
    display: none;
  }

  .is-section-off-preview {
    opacity: 0.35;
    filter: grayscale(0.6);
  }
</style>

<style>
  .channels {
    display: grid;
    gap: var(--sp-4);
  }

  @media (min-width: 760px) {
    .channels {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .channel {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-5);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    background: var(--c-white);
    text-decoration: none;
    transition:
      border-color var(--dur) var(--ease),
      box-shadow var(--dur) var(--ease),
      transform var(--dur) var(--ease);
  }

  .channel:hover {
    border-color: var(--c-brand-200);
    box-shadow: var(--shadow-md);
    transform: translateY(-3px);
  }

  .channel--whatsapp {
    border-color: color-mix(in srgb, var(--c-whatsapp-600) 34%, var(--line));
  }

  .channel--whatsapp .icon-badge {
    color: var(--c-whatsapp-700);
    background: var(--c-whatsapp-100);
  }

  .channel--whatsapp strong,
  .channel--whatsapp .channel__arrow {
    color: var(--c-whatsapp-700);
  }

  .channel--whatsapp:hover {
    border-color: var(--c-whatsapp-600);
  }

  .channel__body {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }

  .channel strong {
    font-size: var(--fs-xs);
    letter-spacing: var(--tracking-caps);
    text-transform: uppercase;
    color: var(--c-brand-600);
  }

  .channel__value {
    font-size: var(--fs-md);
    font-weight: var(--fw-medium);
    color: var(--text-strong);
    overflow-wrap: anywhere;
  }

  .channel__hint {
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .channel__arrow {
    color: var(--c-ink-300);
  }

  .channel:hover .channel__arrow {
    color: var(--c-brand-500);
  }

  .contact-layout {
    display: grid;
    max-width: 960px;
    align-items: start;
  }
</style>
