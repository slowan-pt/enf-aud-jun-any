---
/**
 * Editar conteúdo da página de Conteúdos por formulário — abertura e
 * chamada final. A grade de matérias em si vem da tabela `posts` e é
 * gerida em Conteúdo → Matérias; aqui só o que envolve a grade é editável.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getDB, writeAuditLog } from '../../../lib/db';
import { getConteudosContent, updateConteudosContent } from '../../../lib/documents';

const db = getDB();

if (Astro.request.method === 'POST') {
  const current = await getConteudosContent(db);
  const form = await Astro.request.formData();
  const text = (key: string, fallback: string) => String(form.get(key) ?? fallback);

  const updated = {
    ...current,
    hero: {
      eyebrow: text('hero_eyebrow', current.hero.eyebrow),
      title: text('hero_title', current.hero.title),
      lead: text('hero_lead', current.hero.lead),
    },
    cta: {
      eyebrow: text('cta_eyebrow', current.cta.eyebrow),
      title: text('cta_title', current.cta.title),
      text: text('cta_text', current.cta.text),
    },
  };

  await updateConteudosContent(db, updated, Astro.locals.user?.id);
  await writeAuditLog(db, {
    userId: Astro.locals.user?.id,
    userName: Astro.locals.user?.name ?? '',
    action: 'page.edit',
    target: 'Conteúdos (formulário de conteúdo)',
    ip: Astro.request.headers.get('cf-connecting-ip') ?? '',
  });

  return Astro.redirect('/admin/paginas/conteudos?saved=1');
}

const content = await getConteudosContent(db);
const { hero, cta } = content;
const justSaved = Astro.url.searchParams.get('saved') === '1';
---

<AdminLayout
  title="Conteúdos — Conteúdo"
  description="Abertura e chamada final. A grade de matérias fica em Conteúdo → Matérias."
  active="/admin/editor"
>
  <div slot="actions">
    <a href="/admin/editor/conteudos" class="btn btn--sm">
      <Icon name="pointer" size={16} />
      Editor visual
    </a>
  </div>

  {
    justSaved && (
      <div
        class="form-alert form-alert--success"
        role="status"
        style="margin-bottom: var(--sp-5)"
      >
        <Icon name="check-circle" size={18} />
        <span>Conteúdo salvo.</span>
      </div>
    )
  }

  <form method="post" class="stack-panels">
    <section class="panel">
      <div class="panel__head">
        <h2 class="panel__title">Abertura</h2>
      </div>
      <div class="panel__body stack">
        <div class="field">
          <label class="label" for="hero_eyebrow">Selo</label>
          <input class="input" id="hero_eyebrow" name="hero_eyebrow" value={hero.eyebrow} />
        </div>
        <div class="field">
          <label class="label" for="hero_title">Título</label>
          <input class="input" id="hero_title" name="hero_title" value={hero.title} />
        </div>
        <div class="field">
          <label class="label" for="hero_lead">Texto de apoio</label>
          <textarea class="textarea" id="hero_lead" name="hero_lead" rows="3"
            >{hero.lead}</textarea
          >
        </div>
      </div>
    </section>

    <section class="panel">
      <div class="panel__head">
        <h2 class="panel__title">Chamada final</h2>
      </div>
      <div class="panel__body stack">
        <div class="field">
          <label class="label" for="cta_eyebrow">Selo</label>
          <input class="input" id="cta_eyebrow" name="cta_eyebrow" value={cta.eyebrow} />
        </div>
        <div class="field">
          <label class="label" for="cta_title">Título</label>
          <input class="input" id="cta_title" name="cta_title" value={cta.title} />
        </div>
        <div class="field">
          <label class="label" for="cta_text">Texto</label>
          <textarea class="textarea" id="cta_text" name="cta_text" rows="3">{cta.text}</textarea
          >
        </div>
      </div>
    </section>

    <section class="panel" id="pagina-config">
      <div class="panel__head">
        <h2 class="panel__title">Configurações da página</h2>
      </div>
      <div class="panel__body">
        <p class="muted small">
          A grade de matérias (destaque, filtros e cartões) vem de{' '}
          <a href="/admin/conteudos">Conteúdo → Matérias</a> e das{' '}
          <a href="/admin/categorias">Categorias</a> — não é editada aqui.
        </p>
        <p class="muted small" style="margin-top: var(--sp-3)">
          Cores e fundo desta página ficam em{' '}
          <a href="/admin/editor/conteudos/aparencia">Editor Visual → Conteúdos → Aparência</a>.
        </p>
      </div>
    </section>

    <div class="cluster standalone-foot">
      <button type="submit" class="btn">
        <Icon name="save" size={16} />
        Salvar conteúdo
      </button>
    </div>
  </form>
</AdminLayout>

<style>
  .stack-panels {
    display: grid;
    gap: var(--sp-5);
  }
</style>
