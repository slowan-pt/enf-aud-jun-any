---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getDB, writeAuditLog } from '../../../lib/db';
import {
  archiveGenericPage,
  duplicateGenericPage,
  listGenericPages,
  permanentlyDeleteGenericPage,
  restoreGenericPage,
} from '../../../lib/generic-pages';

const db = getDB();
let error = '';

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('_action') ?? '');
  const id = Number(form.get('id'));
  let target = `Pagina #${id}`;
  if (Number.isInteger(id) && id > 0) {
    if (action === 'archive') await archiveGenericPage(db, id);
    else if (action === 'restore') await restoreGenericPage(db, id);
    else if (action === 'duplicate') {
      const newId = await duplicateGenericPage(db, id, Astro.locals.user?.id);
      if (newId) return Astro.redirect(`/admin/paginas/${newId}`);
    } else if (action === 'delete') {
      const confirmation = String(form.get('confirmation') ?? '');
      if (!(await permanentlyDeleteGenericPage(db, id, confirmation))) {
        error = 'A exclusao definitiva exige uma pagina arquivada e o titulo exato.';
      } else target = `${target} excluida definitivamente`;
    }
    if (!error) {
      await writeAuditLog(db, {
        userId: Astro.locals.user?.id,
        userName: Astro.locals.user?.name ?? '',
        action: `page.${action}`,
        target,
        ip: Astro.request.headers.get('cf-connecting-ip') ?? '',
      });
      return Astro.redirect('/admin/paginas');
    }
  }
}

const genericPages = await listGenericPages(db);
const fixedPages = [
  { title: 'Home', slug: '/', edit: '/admin/paginas/home', visual: '/admin/editor/home' },
  {
    title: 'Quem Somos',
    slug: '/quem-somos',
    edit: '/admin/paginas/quem-somos',
    visual: '/admin/editor/quem-somos',
  },
  {
    title: 'Servicos',
    slug: '/servicos',
    edit: '/admin/paginas/servicos',
    visual: '/admin/editor/servicos/moldura',
  },
  {
    title: 'Conteudos',
    slug: '/conteudos',
    edit: '/admin/paginas/conteudos',
    visual: '/admin/editor/conteudos',
  },
  {
    title: 'Contato',
    slug: '/contato',
    edit: '/admin/paginas/contato',
    visual: '/admin/editor/contato',
  },
  {
    title: 'Politica de Privacidade',
    slug: '/politica-de-privacidade',
    edit: '/admin/paginas/politica',
    visual: '/admin/editor/politica',
  },
];

function formatDate(value: string): string {
  if (!value) return '-';
  return new Intl.DateTimeFormat('pt-BR').format(new Date(`${value.replace(' ', 'T')}Z`));
}
---

<AdminLayout
  title="Paginas"
  description="Paginas fixas e institucionais criadas pelo painel, com publicacao, SEO, menu e Editor Visual."
  active="/admin/paginas"
>
  <div slot="actions">
    <a href="/admin/paginas/menu" class="btn btn--secondary btn--sm"
      ><Icon name="menu" size={16} />Menu do site</a
    >
    <a href="/admin/paginas/nova" class="btn btn--sm"
      ><Icon name="plus" size={16} />Nova pagina</a
    >
  </div>
  {
    error && (
      <p class="notice notice--danger" role="alert">
        {error}
      </p>
    )
  }
  <section class="panel">
    <div class="panel__head">
      <h2 class="panel__title">Paginas institucionais</h2><span class="muted small"
        >{genericPages.length} cadastrada(s)</span
      >
    </div>
    <div class="toolbar">
      <label class="toolbar__search"
        ><Icon name="search" size={16} /><input
          type="search"
          class="input"
          placeholder="Buscar pagina"
          aria-label="Buscar pagina"
          data-table-search="tabela-paginas"
        /></label
      >
      <select class="select" aria-label="Filtrar por status" data-table-filter="tabela-paginas"
        ><option value="">Todos os status</option><option value="published">Publicada</option
        ><option value="draft">Rascunho</option><option value="archived">Arquivada</option
        ></select
      >
      <span class="toolbar__count" data-table-count="tabela-paginas"></span>
    </div>
    <div class="table-wrap">
      <table class="table" id="tabela-paginas">
        <thead
          ><tr
            ><th>Pagina</th><th>URL</th><th>Menu</th><th>Status</th><th>Atualizada</th><th
              class="text-right">Acoes</th
            ></tr
          ></thead
        >
        <tbody
          >{
            genericPages.map((page) => {
              const state = page.archivedAt ? 'archived' : page.status;
              return (
                <tr data-status={state}>
                  <td>
                    <>
                      <a class="table__main" href={`/admin/paginas/${page.id}`}>
                        {page.title}
                      </a>
                      <span class="table__sub">ID estavel #{page.id}</span>
                    </>
                  </td>
                  <>
                    <td>
                      <span class="kbd">{page.slug}</span>
                    </td>
                    <td>{page.showInMenu ? 'Visivel' : <span class="muted">Oculta</span>}</td>
                  </>
                  <td>
                    <span
                      class:list={[
                        'badge',
                        page.archivedAt
                          ? 'badge--neutral'
                          : page.status === 'published'
                            ? 'badge--success'
                            : 'badge--warning',
                      ]}
                    >
                      {page.archivedAt
                        ? 'Arquivada'
                        : page.status === 'published'
                          ? 'Publicada'
                          : 'Rascunho'}
                    </span>
                  </td>
                  <>
                    <td class="muted small">{formatDate(page.updatedAt)}</td>
                    <td>
                      <div class="table__actions">
                        <a
                          class="row-btn"
                          href={`/admin/paginas/${page.id}`}
                          aria-label={`Editar ${page.title}`}
                        >
                          <Icon name="edit" size={16} />
                        </a>
                        <a
                          class="row-btn"
                          href={`/admin/editor/paginas/${page.id}`}
                          aria-label={`Abrir ${page.title} no Editor Visual`}
                        >
                          <Icon name="pointer" size={16} />
                        </a>
                        {!page.archivedAt && (
                          <a
                            class="row-btn"
                            href={page.slug}
                            target="_blank"
                            rel="noopener"
                            aria-label={`Ver ${page.title} no site`}
                          >
                            <Icon name="eye" size={16} />
                          </a>
                        )}
                        <form method="post" style="display:contents">
                          <>
                            <input type="hidden" name="id" value={page.id} />
                            <button
                              class="row-btn"
                              name="_action"
                              value="duplicate"
                              aria-label={`Duplicar ${page.title}`}
                            >
                              <Icon name="copy" size={16} />
                            </button>
                          </>
                        </form>
                        {page.archivedAt ? (
                          <form method="post" style="display:contents">
                            <input type="hidden" name="id" value={page.id} />
                            <button
                              class="row-btn"
                              name="_action"
                              value="restore"
                              aria-label={`Restaurar ${page.title}`}
                            >
                              <Icon name="rotate-ccw" size={16} />
                            </button>
                          </form>
                        ) : (
                          <form method="post" style="display:contents">
                            <input type="hidden" name="id" value={page.id} />
                            <button
                              class="row-btn row-btn--danger"
                              name="_action"
                              value="archive"
                              aria-label={`Arquivar ${page.title}`}
                            >
                              <Icon name="trash" size={16} />
                            </button>
                          </form>
                        )}
                      </div>
                    </td>
                  </>
                </tr>
              );
            })
          }</tbody
        >
      </table>
    </div>
    {
      genericPages.length === 0 && (
        <div class="empty-state">
          <>
            <h2 class="title-sm">Nenhuma pagina institucional criada</h2>
            <p>Crie uma pagina em branco ou comece por um modelo editavel.</p>
          </>
        </div>
      )
    }
  </section>
  <section class="panel fixed-pages">
    <div class="panel__head"><h2 class="panel__title">Paginas fixas do site</h2></div><div
      class="table-wrap"
    >
      <table class="table">
        <thead><tr><th>Pagina</th><th>URL</th><th class="text-right">Acoes</th></tr></thead
        ><tbody
          >{
            fixedPages.map((page) => (
              <tr>
                <>
                  <td>
                    <a class="table__main" href={page.edit}>
                      {page.title}
                    </a>
                  </td>
                  <td>
                    <span class="kbd">{page.slug}</span>
                  </td>
                  <td>
                    <div class="table__actions">
                      <>
                        <a class="row-btn" href={page.edit} aria-label={`Editar ${page.title}`}>
                          <Icon name="edit" size={16} />
                        </a>
                        <a
                          class="row-btn"
                          href={page.visual}
                          aria-label={`Editor Visual de ${page.title}`}
                        >
                          <Icon name="pointer" size={16} />
                        </a>
                        <a
                          class="row-btn"
                          href={page.slug}
                          target="_blank"
                          rel="noopener"
                          aria-label={`Ver ${page.title}`}
                        >
                          <Icon name="eye" size={16} />
                        </a>
                      </>
                    </div>
                  </td>
                </>
              </tr>
            ))
          }</tbody
        >
      </table>
    </div>
  </section>
</AdminLayout>
<style>
  .text-right {
    text-align: right !important;
  }
  .fixed-pages {
    margin-top: var(--sp-5);
  }
  .notice {
    margin-bottom: var(--sp-4);
    padding: 0.8rem 1rem;
    border-radius: var(--r-sm);
  }
  .notice--danger {
    color: #7f1d1d;
    background: #fef2f2;
    border: 1px solid #fecaca;
  }
</style>
