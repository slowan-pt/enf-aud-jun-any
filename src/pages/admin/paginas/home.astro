          <SectionColorFields sectionKey="elo" value={sectionStyles.elo} />
          <div class="form-section">
            <div class="field">
              <label class="label" for="elo_eyebrow">Rótulo (eyebrow)</label>
              <input class="input" id="elo_eyebrow" name="elo_eyebrow" value={elo.eyebrow} />
            </div>
            <div class="field">
              <label class="label" for="elo_title">Título</label>
              <input class="input" id="elo_title" name="elo_title" value={elo.title} />
            </div>
            <div class="field">
              <label class="label" for="elo_text">Texto</label>
              <textarea class="textarea" id="elo_text" name="elo_text">{elo.text}</textarea>
            </div>
          </div>
          <div class="form-section">
            <h3 class="form-section__title">Nós do diagrama</h3>
            <ul class="list-clean">
              {
                elo.nodes.map((node, index) => (
                  <li class="list-row benefit-row">
                    <IconPicker name={`elo_node_icon_${index}`} value={node.icon} label="" />
                    <div class="benefit-row__fields">
                      <input
                        class="input"
                        name={`elo_node_label_${index}`}
                        value={node.label}
                        aria-label={`Rótulo do nó ${index + 1}`}
                      />
                      <input
                        class="input"
                        name={`elo_node_text_${index}`}
                        value={node.text}
                        aria-label={`Texto do nó ${index + 1}`}
                      />
                    </div>
                  </li>
                ))
              }
            </ul>
            <span class="hint">Posição de cada nó ainda não é editável por aqui.</span>
          </div>
        </div>
      </section>

      <!-- benefícios -->
      <section class="panel" hidden>
        <div class="panel__head">
          <h2 class="panel__title">Seção: Benefícios</h2>
          <span class="badge badge--brand">Em edição</span>
        </div>
        <div class="panel__body">
          <SectionColorFields sectionKey="beneficios" value={sectionStyles.beneficios} />
          <div class="form-section">
            <ul class="list-clean">
              {
                benefits.items.map((item, index) => (
                  <li class="list-row benefit-row">
                    <IconPicker name={`benefit_icon_${index}`} value={item.icon} label="" />
                    <div class="benefit-row__fields">
                      <input
                        class="input"
                        name={`benefit_title_${index}`}
                        value={item.title}
                        aria-label={`Título do benefício ${index + 1}`}
                      />
                      <input
                        class="input"
                        name={`benefit_text_${index}`}
                        value={item.text}
                        aria-label={`Texto do benefício ${index + 1}`}
                      />
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <!-- como atuamos -->
      <section class="panel" hidden>
        <div class="panel__head">
          <h2 class="panel__title">Seção: Como atuamos</h2>
          <span class="badge badge--brand">Em edição</span>
        </div>
        <div class="panel__body">
          <SectionColorFields sectionKey="comoAtuamos" value={sectionStyles.comoAtuamos} />
          <div class="form-section">
            <div class="field">
              <label class="label" for="how_eyebrow">Rótulo (eyebrow)</label>
              <input
                class="input"
                id="how_eyebrow"
                name="how_eyebrow"
                value={howWeWork.eyebrow}
              />
            </div>
            <div class="field">
              <label class="label" for="how_title">Título</label>
              <input class="input" id="how_title" name="how_title" value={howWeWork.title} />
            </div>
            <div class="field">
              <label class="label" for="how_text">Texto</label>
              <textarea class="textarea" id="how_text" name="how_text"
                >{howWeWork.text}</textarea
              >
            </div>
          </div>
          <div class="form-section">
            <h3 class="form-section__title">Etapas do processo</h3>
            <ul class="list-clean">
              {
                howWeWork.steps.map((step, index) => (
                  <li class="list-row benefit-row">
                    <span class="icon-badge icon-badge--sm">{step.number}</span>
                    <IconPicker name={`how_step_icon_${index}`} value={step.icon} label="" />
                    <div class="benefit-row__fields">
                      <input
                        class="input"
                        name={`how_step_title_${index}`}
                        value={step.title}
                        aria-label={`Título da etapa ${index + 1}`}
                      />
                      <input
                        class="input"
                        name={`how_step_text_${index}`}
                        value={step.text}
                        aria-label={`Texto da etapa ${index + 1}`}
                      />
                    </div>
                  </li>
                ))
              }
            </ul>
            <span class="hint">Número de cada etapa ainda não é editável por aqui.</span>
          </div>
        </div>
      </section>

      <!-- missão, visão e valores -->
      <section class="panel" hidden>
        <div class="panel__head">
          <h2 class="panel__title">Seção: Missão, visão e valores</h2>
          <span class="badge badge--brand">Em edição</span>
        </div>
        <div class="panel__body">
          <SectionColorFields sectionKey="mvv" value={sectionStyles.mvv} />
          <div class="form-section">
            <div class="field">
              <label class="label" for="mvv_eyebrow">Rótulo (eyebrow)</label>
              <input
                class="input"
                id="mvv_eyebrow"
                name="mvv_eyebrow"
                value={missionVisionValues.eyebrow}
              />
            </div>
            <div class="field">
              <label class="label" for="mvv_title">Título</label>
              <input
                class="input"
                id="mvv_title"
                name="mvv_title"
                value={missionVisionValues.title}
              />
            </div>
            <div class="form-grid form-grid--2">
              <div class="field">
                <label class="label" for="mvv_mission_title">Missão — título</label>
                <input
                  class="input"
                  id="mvv_mission_title"
                  name="mvv_mission_title"
                  value={missionVisionValues.mission.title}
                />
              </div>
              <div class="field">
                <label class="label" for="mvv_vision_title">Visão — título</label>
                <input
                  class="input"
                  id="mvv_vision_title"
                  name="mvv_vision_title"
                  value={missionVisionValues.vision.title}
                />
              </div>
            </div>
            <div class="field">
              <label class="label" for="mvv_mission_text">Missão — texto</label>
              <textarea class="textarea" id="mvv_mission_text" name="mvv_mission_text"
                >{missionVisionValues.mission.text}</textarea
              >
            </div>
            <div class="field">
              <label class="label" for="mvv_vision_text">Visão — texto</label>
              <textarea class="textarea" id="mvv_vision_text" name="mvv_vision_text"
                >{missionVisionValues.vision.text}</textarea
              >
            </div>
          </div>
          <div class="form-section">
            <h3 class="form-section__title">Valores</h3>
            <ul class="list-clean">
              {
                missionVisionValues.values.map((value, index) => (
                  <li class="list-row benefit-row">
                    <IconPicker name={`mvv_value_icon_${index}`} value={value.icon} label="" />
                    <div class="benefit-row__fields">
                      <input
                        class="input"
                        name={`mvv_value_title_${index}`}
                        value={value.title}
                        aria-label={`Título do valor ${index + 1}`}
                      />
                      <input
                        class="input"
                        name={`mvv_value_text_${index}`}
                        value={value.text}
                        aria-label={`Texto do valor ${index + 1}`}
                      />
                    </div>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </section>

      <!-- para quem atuamos -->
      <section class="panel" hidden>
        <div class="panel__head">
          <h2 class="panel__title">Seção: Para quem atuamos</h2>
          <span class="badge badge--brand">Em edição</span>
        </div>
        <div class="panel__body">
          <SectionColorFields sectionKey="segmentos" value={sectionStyles.segmentos} />
          <div class="form-section">
            <div class="field">
              <label class="label" for="seg_eyebrow">Rótulo (eyebrow)</label>
              <input
                class="input"
                id="seg_eyebrow"
                name="seg_eyebrow"
                value={clientSegments.eyebrow}
              />
            </div>
            <div class="field">
              <label class="label" for="seg_title">Título</label>
              <input
                class="input"
                id="seg_title"
                name="seg_title"
                value={clientSegments.title}
              />
            </div>
            <div class="field">
              <label class="label" for="seg_text">Texto</label>
              <textarea class="textarea" id="seg_text" name="seg_text"
                >{clientSegments.text}</textarea
              >
            </div>
          </div>
          <div class="form-section">
            <h3 class="form-section__title">Segmentos (exibidos na Home apenas o rótulo)</h3>
            <ul class="list-clean">
              {
                clientSegments.items.map((item, index) => (
                  <li class="list-row">
                    <IconPicker name={`seg_item_icon_${index}`} value={item.icon} label="" />
                    <div class="list-row__main" style="display:grid;gap:var(--sp-2);flex:1">
                      <input
                        class="input"
                        name={`seg_item_label_${index}`}
                        value={item.label}
                        aria-label={`Rótulo do segmento ${index + 1}`}
                      />
                      <input
                        class="input"
                        name={`seg_item_detail_${index}`}
                        value={item.detail}
                        aria-label={`Detalhe do segmento ${index + 1}`}
                      />
                      {/* prettier-ignore */}
                      <textarea class="textarea" name={`seg_item_behavior_${index}`} aria-label={`Comportamento do segmento ${index + 1}`} style="min-height:70px">{item.behavior}</textarea>
                    </div>
                  </li>
                ))
              }
            </ul>
            <span class="hint"
              >Detalhe e comportamento são usados em "Quem Somos"; a Home mostra só o rótulo.</span
            >
          </div>
        </div>
      </section>

      <!-- contato da home -->
      <section class="panel">
        <div class="panel__head">
          <h2 class="panel__title">Contato da Home</h2>
          <span class="badge badge--brand">Home</span>
        </div>
        <div class="panel__body">
          <div class="form-section">
            <div class="field">
              <label class="label" for="cta_eyebrow">Rótulo acima do título</label>
              <input
                class="input"
                id="cta_eyebrow"
                name="cta_eyebrow"
                value={finalCta.eyebrow}
              />
            </div>
            <div class="field">
              <label class="label" for="cta_title">Título do contato</label>
              <input class="input" id="cta_title" name="cta_title" value={finalCta.title} />
            </div>
            <div class="field">
              <label class="label" for="cta_text">Texto de apoio</label>
              <textarea class="textarea" id="cta_text" name="cta_text">{finalCta.text}</textarea
              >
            </div>
            <div class="form-grid form-grid--2">
              <div class="field">
                <label class="label" for="cta_primary_label">Texto do botão</label>
                <input
                  class="input"
                  id="cta_primary_label"
                  name="cta_primary_label"
                  value={finalCta.primary.label}
                />
              </div>
              <div class="field">
                <label class="label" for="cta_primary_href">Link do botão</label>
                <input
                  class="input"
                  id="cta_primary_href"
                  name="cta_primary_href"
                  value={finalCta.primary.href}
                />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- vídeo promocional -->
      <section class="panel" hidden>
        <div class="panel__head">
          <h2 class="panel__title">Vídeo promocional</h2>
          <span class="badge badge--brand">Em edição</span>
        </div>
        <div class="panel__body">
          <SectionColorFields sectionKey="promoVideo" value={sectionStyles.promoVideo} />
          <div class="form-section">
            <p class="hint">
              Some da Home enquanto o vídeo não estiver enviado. MP4 ou WebM, até 90 MB.
            </p>
            {
              promoVideo.url && (
                <video id="video-preview" src={promoVideo.url} controls class="video-preview" />
              )
            }
            <div class="field">
              <label class="label" for="video_title">Título</label>
              <input
                class="input"
                id="video_title"
                name="video_title"
                value={promoVideo.title}
              />
            </div>
            <div class="field">
              <label class="label" for="video_text">Texto</label>
              <input class="input" id="video_text" name="video_text" value={promoVideo.text} />
            </div>
            <div class="field">
              <label class="label" for="video_url">Caminho do vídeo</label>
              <input class="input" id="video_url" name="video_url" value={promoVideo.url} />
              <span class="hint">Deixe em branco para ocultar a seção.</span>
            </div>
            <label class="btn btn--secondary btn--sm" style="justify-self:start">
              <Icon name="upload" size={16} />
              Enviar vídeo
              <input
                type="file"
                id="video-upload-input"
                accept="video/mp4,video/webm"
                style="display:none"
              />
            </label>
            <span class="hint" id="video-upload-status"></span>
          </div>
        </div>
      </section>

      <section class="panel">
        <div class="panel__head">
          <h2 class="panel__title">Matérias da Home</h2>
          <span class="badge badge--neutral">Automático</span>
        </div>
        <div class="panel__body">
          <p class="muted small">
            A seção “Últimas matérias” da Home mostra automaticamente as publicações cadastradas
            em Conteúdos. Para alterar título, imagem, categoria ou texto de uma matéria, use o
            botão abaixo.
          </p>
          <a href="/admin/conteudos" class="btn btn--secondary btn--sm" style="justify-self:start">
            <Icon name="newspaper" size={16} />
            Editar matérias
          </a>
        </div>
      </section>

      <!-- perguntas frequentes -->
      <section class="panel">
        <div class="panel__head">
          <h2 class="panel__title">Perguntas frequentes</h2>
          <span class="badge badge--brand">Home</span>
        </div>
        <div class="panel__body">
          <div class="form-section">
            <p class="hint">
              Estas perguntas aparecem na Home em formato sanfona. No site público, apenas uma
              resposta fica aberta por vez.
            </p>
            <div class="faq-editor" data-faq-editor>
              {
                faqItems.map((item, index) => (
                  <div class="faq-editor__item" data-faq-row>
                    <div class="faq-editor__head">
                      <strong>Pergunta {index + 1}</strong>
                      <button type="button" class="row-btn row-btn--danger" data-faq-remove>
                        Excluir
                      </button>
                    </div>
                    <div class="field">
                      <label class="label">Pergunta</label>
                      <input class="input" name="faq_question" value={item.question} />
                    </div>
                    <div class="field">
                      <label class="label">Resposta</label>
                      {/* prettier-ignore */}
                      <textarea class="textarea faq-editor__answer" name="faq_answer">{item.answer}</textarea>
                    </div>
                  </div>
                ))
              }
            </div>
            <button type="button" class="btn btn--secondary btn--sm" data-faq-add>
              <Icon name="plus" size={16} />
              Adicionar pergunta
            </button>
          </div>
        </div>
      </section>

      <div class="panel__foot standalone-foot">
        <span class="muted small">Última atualização: {formatDate(updatedAt)}</span>
        <button type="submit" class="btn">
          <Icon name="save" size={16} />
          Salvar alterações da Home
        </button>
      </div>
    </div>

    <!-- lateral -->
    <aside class="editor-side">
      <section class="panel">
        <div class="panel__head">
          <h2 class="panel__title">O que esta tela edita</h2>
        </div>
        <div class="panel__body">
          <p class="muted small">
            Aqui ficam os conteúdos que aparecem na Home: carrossel, ícones e abas de serviços,
            matérias automáticas, perguntas frequentes e contato. As páginas internas de cada
            serviço continuam tendo edição própria quando você precisar de textos mais completos.
          </p>
        </div>
      </section>

      <section class="panel" id="pagina-config">
        <div class="panel__head">
          <h2 class="panel__title">Configurações da página</h2>
        </div>
        <div class="panel__body">
          <p class="muted small">
            Metadados de SEO por página ainda não são editáveis — a Home usa o título e a
            descrição padrão definidos em Configurações.
          </p>
          <p class="muted small" style="margin-top: var(--sp-3)">
            Ajustes avançados de cores, fundos e espaçamentos ficam em
            <a href="/admin/editor/home/aparencia">Editor Visual → Home → Aparência</a>.
          </p>
        </div>
      </section>
    </aside>
  </form>
</AdminLayout>

<style>
  .stack-panels {
    display: grid;
    gap: var(--sp-5);
    align-content: start;
  }

  .standalone-foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
    padding: var(--sp-4) var(--sp-5);
    background: var(--c-white);
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
  }

  .section-row .drag {
    color: var(--c-ink-300);
    cursor: grab;
  }

  .order {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--r-xs);
    background: var(--c-ink-100);
    color: var(--c-ink-600);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }

  .image-picker {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--c-ink-50);
  }

  .image-picker img {
    width: 160px;
    height: 120px;
    object-fit: cover;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
  }

  @media (max-width: 560px) {
    .image-picker {
      grid-template-columns: 1fr;
    }

    .image-picker img {
      width: 100%;
    }
  }

  .benefit-row {
    align-items: center;
  }

  .benefit-row__fields {
    display: grid;
    gap: var(--sp-2);
    flex: 1;
    min-width: 0;
  }

  .home-service-editor {
    display: grid;
    gap: var(--sp-4);
  }

  .home-service-card {
    display: grid;
    gap: var(--sp-4);
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--c-ink-50);
  }

  .home-service-card__head {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .home-service-card__head h3 {
    margin: 0;
    color: var(--text-strong);
    font-size: var(--fs-base);
  }

  .home-service-card__head span:not(.order) {
    color: var(--text-faint);
    font-size: var(--fs-xs);
  }

  .home-service-card__actions {
    display: flex;
    align-items: end;
    gap: var(--sp-2);
    flex-wrap: wrap;
    margin-left: auto;
  }

  .field--inline {
    gap: 0.25rem;
  }

  .home-service-card.is-pending-delete {
    opacity: 0.52;
    border-style: dashed;
  }

  .home-service-card__highlights {
    margin-top: 0;
  }

  .home-highlight-row {
    display: grid;
    gap: var(--sp-2);
    padding-top: var(--sp-3);
    border-top: 1px solid var(--line);
  }

  .home-highlight-row__fields {
    display: grid;
    gap: var(--sp-2);
  }

  @media (min-width: 700px) {
    .benefit-row__fields {
      grid-template-columns: 1fr 2fr;
    }

    .home-highlight-row {
      grid-template-columns: minmax(190px, 0.8fr) minmax(0, 2fr);
      align-items: end;
    }

    .home-highlight-row__fields {
      grid-template-columns: minmax(180px, 0.75fr) minmax(0, 1.25fr);
    }
  }

  .video-preview {
    width: 100%;
    max-height: 260px;
    background: #000;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
  }

  .hero-slide-editor {
    display: grid;
    gap: var(--sp-4);
  }

  .hero-slide-editor__item {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--c-ink-50);
  }

  .hero-slide-editor__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .hero-slide-editor__text {
    min-height: 92px;
  }

  .image-upload__row {
    display: flex;
    align-items: center;
    gap: var(--sp-3);
    flex-wrap: wrap;
  }

  .image-upload__preview {
    width: 120px;
    height: 72px;
    object-fit: cover;
    border-radius: var(--r-sm);
    border: 1px solid var(--line);
    background: var(--c-ink-100);
    flex: none;
  }

  .image-upload__controls {
    display: grid;
    gap: 0.4rem;
    flex: 1;
    min-width: 220px;
  }

  .image-upload__btn {
    justify-self: start;
  }

  .faq-editor {
    display: grid;
    gap: var(--sp-4);
  }

  .faq-editor__item {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--c-ink-50);
  }

  .faq-editor__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .faq-editor__answer {
    min-height: 110px;
  }
</style>

<script>
  const videoInput = document.querySelector<HTMLInputElement>('#video-upload-input');
  const videoStatus = document.getElementById('video-upload-status');
  const videoUrlField = document.querySelector<HTMLInputElement>('#video_url');

  videoInput?.addEventListener('change', async () => {
    const file = videoInput.files?.[0];
    if (!file) return;
    if (videoStatus) videoStatus.textContent = `Enviando ${file.name}…`;
    const body = new FormData();
    body.set('file', file);
    body.set('alt', '');
    body.set('title', file.name);
    try {
      const res = await fetch('/admin/api/upload', { method: 'POST', body });
      const data = await res.json();
      if (!res.ok) {
        if (videoStatus) videoStatus.textContent = data.error ?? 'Falha no envio.';
        return;
      }
      if (videoUrlField) videoUrlField.value = data.url;
      if (videoStatus) videoStatus.textContent = 'Enviado. Clique em "Salvar" para aplicar.';
    } catch {
      if (videoStatus) videoStatus.textContent = 'Falha no envio. Tente novamente.';
    }
  });

  const heroSlideEditor = document.querySelector<HTMLElement>('[data-hero-slide-editor]');
  const heroSlideAdd = document.querySelector<HTMLButtonElement>('[data-hero-slide-add]');

  const uploadHeroSlideImage = async (root: HTMLElement, file: File) => {
    const urlInput = root.querySelector<HTMLInputElement>('[data-hero-slide-url]');
    const preview = root.querySelector<HTMLImageElement>('[data-hero-slide-preview]');
    const status = root.querySelector<HTMLElement>('[data-hero-slide-status]');
    if (!urlInput) return;

    if (status) status.textContent = `Enviando ${file.name}...`;
    const body = new FormData();
    body.set('file', file);
    body.set('alt', file.name);
    body.set('title', file.name);

    try {
      const res = await fetch('/admin/api/upload', { method: 'POST', body });
      const data = await res.json();
      if (!res.ok) {
        if (status) status.textContent = data.error ?? 'Falha no envio.';
        return;
      }
      urlInput.value = data.url;
      if (preview) preview.src = data.url;
      if (status) status.textContent = 'Enviado.';
    } catch {
      if (status) status.textContent = 'Falha no envio. Tente novamente.';
    }
  };

  const renumberHeroSlides = () => {
    heroSlideEditor
      ?.querySelectorAll<HTMLElement>('[data-hero-slide-row]')
      .forEach((row, index) => {
        const label = row.querySelector('strong');
        if (label) label.textContent = `Slide ${index + 1}`;
      });
  };

  const wireHeroSlideRow = (row: HTMLElement) => {
    if (row.dataset.bound) return;
    row.dataset.bound = '1';

    row
      .querySelector<HTMLButtonElement>('[data-hero-slide-remove]')
      ?.addEventListener('click', () => {
        const rows = heroSlideEditor?.querySelectorAll('[data-hero-slide-row]').length ?? 0;
        if (rows <= 1) {
          row.querySelector<HTMLInputElement>('input[name="hero_slide_title"]')!.value = '';
          row.querySelector<HTMLTextAreaElement>('textarea[name="hero_slide_text"]')!.value = '';
          row.querySelector<HTMLInputElement>('input[name="hero_slide_image"]')!.value = '';
          row.querySelector<HTMLInputElement>('input[name="hero_slide_alt"]')!.value = '';
          const preview = row.querySelector<HTMLImageElement>('[data-hero-slide-preview]');
          if (preview) preview.src = '/favicon-192.png';
        } else {
          row.remove();
        }
        renumberHeroSlides();
      });

    row.querySelector<HTMLInputElement>('[data-hero-slide-file]')?.addEventListener('change', (event) => {
      const file = (event.currentTarget as HTMLInputElement).files?.[0];
      if (file) uploadHeroSlideImage(row, file);
    });
  };

  heroSlideEditor?.querySelectorAll<HTMLElement>('[data-hero-slide-row]').forEach(wireHeroSlideRow);

  heroSlideAdd?.addEventListener('click', () => {
    if (!heroSlideEditor) return;
    const row = document.createElement('div');
    row.className = 'hero-slide-editor__item';
    row.dataset.heroSlideRow = '';
    row.innerHTML = `
      <div class="hero-slide-editor__head">
        <strong>Slide</strong>
        <button type="button" class="row-btn row-btn--danger" data-hero-slide-remove>Excluir</button>
      </div>
      <div class="field">
        <label class="label">Título</label>
        <input class="input" name="hero_slide_title" value="" />
      </div>
      <div class="field">
        <label class="label">Texto</label>
        <textarea class="textarea hero-slide-editor__text" name="hero_slide_text"></textarea>
      </div>
      <div class="field hero-slide-editor__image" data-hero-slide-upload>
        <label class="label">Imagem</label>
        <div class="image-upload__row">
          <img class="image-upload__preview" src="/favicon-192.png" alt="" width="120" height="90" data-hero-slide-preview />
          <div class="image-upload__controls">
            <input class="input" name="hero_slide_image" value="" data-hero-slide-url />
            <label class="btn btn--secondary btn--sm image-upload__btn">
              Enviar arquivo
              <input type="file" accept="image/jpeg,image/png,image/webp" style="display:none" data-hero-slide-file />
            </label>
            <span class="hint" data-hero-slide-status></span>
          </div>
        </div>
      </div>
      <div class="field">
        <label class="label">Texto alternativo</label>
        <input class="input" name="hero_slide_alt" value="" />
      </div>
    `;
    heroSlideEditor.appendChild(row);
    wireHeroSlideRow(row);
    renumberHeroSlides();
    row.querySelector<HTMLInputElement>('input[name="hero_slide_title"]')?.focus();
  });

  const serviceEditor = document.querySelector<HTMLElement>('[data-home-service-editor]');
  const serviceAdd = document.querySelector<HTMLButtonElement>('[data-home-service-add]');
  const serviceCount = document.querySelector<HTMLElement>('[data-home-service-count]');
  const serviceLimit = Number(serviceEditor?.dataset.serviceLimit ?? 10);

  const visibleServiceRows = () =>
    Array.from(serviceEditor?.querySelectorAll<HTMLElement>('[data-home-service-row]') ?? []).filter(
      (row) => row.querySelector<HTMLInputElement>('[data-service-action]')?.value !== 'delete'
    );

  const updateServiceControls = () => {
    const count = visibleServiceRows().length;
    if (serviceAdd) serviceAdd.disabled = count >= serviceLimit;
    if (serviceCount) serviceCount.textContent = `${count} de ${serviceLimit} serviços cadastrados nesta tela.`;
    visibleServiceRows().forEach((row, index) => {
      const order = row.querySelector<HTMLElement>('.order');
      if (order) order.textContent = String(index + 1).padStart(2, '0');
    });
  };

  const rewriteServiceRowNames = (row: HTMLElement, key: string) => {
    row.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>('[name]').forEach((field) => {
      field.name = field.name.replace(/service_(?:new_)?\d+/g, `service_${key}`);
    });
    row.querySelectorAll<HTMLLabelElement>('label[for]').forEach((label) => {
      label.htmlFor = label.htmlFor.replace(/service_(?:new_)?\d+/g, `service_${key}`);
    });
    row.querySelectorAll<HTMLElement>('[id]').forEach((field) => {
      field.id = field.id.replace(/service_(?:new_)?\d+/g, `service_${key}`);
    });
  };

  const clearServiceRow = (row: HTMLElement, key: string) => {
    const keyInput = row.querySelector<HTMLInputElement>('input[name="home_service_key"]');
    if (keyInput) keyInput.value = key;
    const action = row.querySelector<HTMLInputElement>('[data-service-action]');
    if (action) {
      action.name = `service_${key}_action`;
      action.value = 'save';
    }
    row.querySelectorAll<HTMLInputElement>('input').forEach((input) => {
      if (input.name === 'home_service_key' || input.dataset.serviceAction !== undefined) return;
      if (input.type === 'hidden' || input.type === 'file') return;
      input.value = '';
    });
    row.querySelectorAll<HTMLTextAreaElement>('textarea').forEach((textarea) => {
      textarea.value = '';
    });
    row.querySelectorAll<HTMLSelectElement>('select').forEach((select) => {
      if (select.name.endsWith('_status')) select.value = 'draft';
      if (select.name.endsWith('_icon')) select.value = 'stethoscope';
    });
    row.querySelectorAll<HTMLImageElement>('[data-image-preview]').forEach((preview) => {
      preview.src = '/favicon-192.png';
      preview.style.visibility = 'hidden';
    });
    row.querySelectorAll<HTMLElement>('[data-image-upload]').forEach((root) => {
      root.removeAttribute('data-bound');
    });
    const title = row.querySelector('.home-service-card__head h3');
    if (title) title.textContent = 'Novo serviço';
    const subtitle = row.querySelector('.home-service-card__head h3 + span');
    if (subtitle) subtitle.textContent = 'Preencha e salve para criar';
  };

  const wireServiceRow = (row: HTMLElement) => {
    if (row.dataset.serviceBound) return;
    row.dataset.serviceBound = '1';
    row.querySelector<HTMLButtonElement>('[data-service-delete]')?.addEventListener('click', () => {
      const action = row.querySelector<HTMLInputElement>('[data-service-action]');
      const key = row.querySelector<HTMLInputElement>('input[name="home_service_key"]')?.value ?? '';
      if (key.startsWith('new_')) {
        row.remove();
      } else if (action) {
        action.value = 'delete';
        row.classList.add('is-pending-delete');
        row.hidden = true;
      }
      updateServiceControls();
    });

    row.querySelectorAll<HTMLElement>('[data-image-upload]').forEach((root) => {
      if (root.dataset.bound) return;
      if (root.dataset.serviceUploadBound) return;
      root.dataset.serviceUploadBound = '1';
      const urlInput = root.querySelector<HTMLInputElement>('[data-image-url]');
      const fileInput = root.querySelector<HTMLInputElement>('[data-image-file]');
      const preview = root.querySelector<HTMLImageElement>('[data-image-preview]');
      const status = root.querySelector<HTMLElement>('[data-image-status]');
      fileInput?.addEventListener('change', async () => {
        const file = fileInput.files?.[0];
        if (!file || !urlInput) return;
        if (status) status.textContent = `Enviando ${file.name}...`;
        const body = new FormData();
        body.set('file', file);
        body.set('alt', file.name);
        body.set('title', file.name);
        try {
          const res = await fetch('/admin/api/upload', { method: 'POST', body });
          const data = await res.json();
          if (!res.ok) {
            if (status) status.textContent = data.error ?? 'Falha no envio.';
            return;
          }
          urlInput.value = data.url;
          if (preview) {
            preview.src = data.url;
            preview.style.visibility = 'visible';
          }
          if (status) status.textContent = 'Enviado.';
        } catch {
          if (status) status.textContent = 'Falha no envio. Tente novamente.';
        }
      });
    });
  };

  serviceEditor?.querySelectorAll<HTMLElement>('[data-home-service-row]').forEach(wireServiceRow);
  updateServiceControls();

  serviceAdd?.addEventListener('click', () => {
    if (!serviceEditor || visibleServiceRows().length >= serviceLimit) return;
    const source = serviceEditor.querySelector<HTMLElement>('[data-home-service-row]');
    if (!source) return;
    const key = `new_${Date.now()}`;
    const row = source.cloneNode(true) as HTMLElement;
    row.classList.remove('is-pending-delete');
    row.hidden = false;
    delete row.dataset.serviceBound;
    rewriteServiceRowNames(row, key);
    clearServiceRow(row, key);
    serviceEditor.appendChild(row);
    wireServiceRow(row);
    updateServiceControls();
    row.querySelector<HTMLInputElement>(`input[name="service_${key}_name"]`)?.focus();
  });

  const faqEditor = document.querySelector<HTMLElement>('[data-faq-editor]');
  const faqAdd = document.querySelector<HTMLButtonElement>('[data-faq-add]');

  const renumberFaqRows = () => {
    faqEditor?.querySelectorAll<HTMLElement>('[data-faq-row]').forEach((row, index) => {
      const label = row.querySelector('strong');
      if (label) label.textContent = `Pergunta ${index + 1}`;
    });
  };

  const wireFaqRow = (row: HTMLElement) => {
    row.querySelector<HTMLButtonElement>('[data-faq-remove]')?.addEventListener('click', () => {
      const rows = faqEditor?.querySelectorAll('[data-faq-row]').length ?? 0;
      if (rows <= 1) {
        row.querySelector<HTMLInputElement>('input[name="faq_question"]')!.value = '';
        row.querySelector<HTMLTextAreaElement>('textarea[name="faq_answer"]')!.value = '';
      } else {
        row.remove();
      }
      renumberFaqRows();
    });
  };

  faqEditor?.querySelectorAll<HTMLElement>('[data-faq-row]').forEach(wireFaqRow);

  faqAdd?.addEventListener('click', () => {
    if (!faqEditor) return;
    const row = document.createElement('div');
    row.className = 'faq-editor__item';
    row.dataset.faqRow = '';
    row.innerHTML = `
      <div class="faq-editor__head">
        <strong>Pergunta</strong>
        <button type="button" class="row-btn row-btn--danger" data-faq-remove>Excluir</button>
      </div>
      <div class="field">
        <label class="label">Pergunta</label>
        <input class="input" name="faq_question" value="" />
      </div>
      <div class="field">
        <label class="label">Resposta</label>
        <textarea class="textarea faq-editor__answer" name="faq_answer"></textarea>
      </div>
    `;
    faqEditor.appendChild(row);
    wireFaqRow(row);
    renumberFaqRows();
    row.querySelector<HTMLInputElement>('input[name="faq_question"]')?.focus();
  });
</script>
