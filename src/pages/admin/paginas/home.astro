---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import IconPicker from '../../../components/admin/IconPicker.astro';
import SectionColorFields from '../../../components/admin/SectionColorFields.astro';
import ImageUploadField from '../../../components/admin/ImageUploadField.astro';
import { getDB, writeAuditLog } from '../../../lib/db';
import { getHomeContent, updateHomeContent, HOME_SECTION_KEYS } from '../../../lib/pages';
import { getSettings, updateSetting } from '../../../lib/settings';
import { createService, slugExists, updateService, type Service } from '../../../lib/services';
import { slugify } from '../../../lib/urls';

const db = getDB();
const MAX_HOME_SERVICES = 10;
const homeServices = Astro.locals.services
  .filter((service) => service.status !== 'archived')
  .slice(0, MAX_HOME_SERVICES);

if (Astro.request.method === 'POST') {
  const current = await getHomeContent(db);
  // Missão/visão/valores, "como atuamos" e "para quem atuamos" são
  // compartilhados com Quem Somos/Serviços (ver src/lib/settings.ts) —
  // não fazem parte do documento da Home.
  const currentSettings = await getSettings(db);
  const form = await Astro.request.formData();
  const text = (key: string, fallback: string) => String(form.get(key) ?? fallback);
  const lines = (key: string, fallback: string[]) =>
    String(form.get(key) ?? fallback.join('\n'))
      .split('\n')
      .map((l) => l.trim())
      .filter(Boolean);
  const faqQuestions = form.getAll('faq_question').map((value) => String(value).trim());
  const faqAnswers = form.getAll('faq_answer').map((value) => String(value).trim());
  const updatedFaqItems = faqQuestions
    .map((question, index) => ({
      question,
      answer: faqAnswers[index] ?? '',
    }))
    .filter((item) => item.question && item.answer)
    .slice(0, 24);
  const slideTitles = form.getAll('hero_slide_title').map((value) => String(value).trim());
  const slideTexts = form.getAll('hero_slide_text').map((value) => String(value).trim());
  const slideImages = form.getAll('hero_slide_image').map((value) => String(value).trim());
  const slideAlts = form.getAll('hero_slide_alt').map((value) => String(value).trim());
  const updatedHeroSlides = slideTitles
    .map((title, index) => ({
      title,
      text: slideTexts[index] ?? '',
      image: slideImages[index] ?? '',
      alt: slideAlts[index] ?? '',
    }))
    .filter((item) => item.title && item.text && item.image)
    .slice(0, 12);
  const rawHeroSlideInterval = Number(
    form.get('hero_slide_interval') ?? current.heroSlideIntervalSeconds
  );
  const heroSlideIntervalSeconds = Number.isFinite(rawHeroSlideInterval)
    ? Math.min(30, Math.max(3, Math.round(rawHeroSlideInterval)))
    : current.heroSlideIntervalSeconds;

  const servicesById = new Map(Astro.locals.services.map((service) => [service.id, service]));
  const serviceKeys = form
    .getAll('home_service_key')
    .map((value) => String(value))
    .filter(Boolean)
    .slice(0, MAX_HOME_SERVICES);

  async function uniqueServiceSlug(name: string): Promise<string> {
    const base = slugify(name) || 'servico';
    let candidate = base;
    let suffix = 2;
    while (await slugExists(db, candidate)) {
      candidate = `${base}-${suffix}`;
      suffix += 1;
    }
    return candidate;
  }

  for (const key of serviceKeys) {
    const fieldPrefix = `service_${key}`;
    const action = text(`${fieldPrefix}_action`, 'save');
    const desiredStatus = text(`${fieldPrefix}_status`, 'published') === 'published'
      ? 'published'
      : 'draft';

    if (key.startsWith('new_')) {
      if (action === 'delete') continue;
      const name = text(`${fieldPrefix}_name`, '').trim();
      if (!name) continue;
      const summary = text(`${fieldPrefix}_summary`, '').trim();
      const highlights = [0, 1, 2]
        .map((index) => ({
          icon: text(`${fieldPrefix}_highlight_${index}_icon`, 'check-circle'),
          title: text(`${fieldPrefix}_highlight_${index}_title`, '').trim(),
          text: text(`${fieldPrefix}_highlight_${index}_text`, '').trim(),
        }))
        .filter((item) => item.title || item.text);

      await createService(
        db,
        {
          slug: await uniqueServiceSlug(name),
          name,
          shortName: text(`${fieldPrefix}_short`, name),
          icon: text(`${fieldPrefix}_icon`, 'stethoscope'),
          summary,
          heroTitle: name,
          heroLead: summary,
          image: text(`${fieldPrefix}_image`, ''),
          imageAlt: text(`${fieldPrefix}_alt`, ''),
          intro: summary ? [summary] : [],
          highlights,
          blocks: [],
          deliverables: [],
          audience: [],
          whatsappMessage: text(`${fieldPrefix}_wa`, ''),
          seoTitle: name,
          seoDescription: summary,
          status: desiredStatus,
          featured: false,
        },
        Astro.locals.user?.id
      );
      continue;
    }

    const service = servicesById.get(Number(key));
    if (!service) continue;
    const updatedHighlights = service.highlights.map((item, index) => {
      if (index > 2) return item;
      return {
        ...item,
        icon: text(`${fieldPrefix}_highlight_${index}_icon`, item.icon),
        title: text(`${fieldPrefix}_highlight_${index}_title`, item.title),
        text: text(`${fieldPrefix}_highlight_${index}_text`, item.text),
      };
    });

    await updateService(
      db,
      service.slug,
      {
        slug: service.slug,
        name: text(`${fieldPrefix}_name`, service.name),
        icon: text(`${fieldPrefix}_icon`, service.icon),
        shortName: text(`${fieldPrefix}_short`, service.shortName),
        summary: text(`${fieldPrefix}_summary`, service.summary),
        heroTitle: service.heroTitle,
        heroLead: service.heroLead,
        image: text(`${fieldPrefix}_image`, service.image),
        imageAlt: text(`${fieldPrefix}_alt`, service.imageAlt),
        whatsappMessage: text(`${fieldPrefix}_wa`, service.whatsappMessage),
        seoTitle: service.seo.title,
        seoDescription: service.seo.description,
        status: action === 'delete' ? 'archived' : (desiredStatus as Service['status']),
        featured: service.featured,
        intro: service.intro,
        deliverables: service.deliverables,
        audience: service.audience,
        highlights: updatedHighlights,
        blocks: service.blocks,
      },
      service
    );
  }

  const updatedBenefits = current.benefits.items.map((item, index) => ({
    ...item,
    icon: text(`benefit_icon_${index}`, item.icon),
    title: text(`benefit_title_${index}`, item.title),
    text: text(`benefit_text_${index}`, item.text),
  }));

  const updatedVpPoints = current.valueProposition.points.map((item, index) => ({
    ...item,
    icon: text(`vp_point_icon_${index}`, item.icon),
    title: text(`vp_point_title_${index}`, item.title),
    text: text(`vp_point_text_${index}`, item.text),
  }));

  const updatedEloNodes = current.elo.nodes.map((node, index) => ({
    ...node,
    icon: text(`elo_node_icon_${index}`, node.icon),
    label: text(`elo_node_label_${index}`, node.label),
    text: text(`elo_node_text_${index}`, node.text),
  }));

  const updatedSteps = currentSettings.howWeWork.steps.map((step, index) => ({
    ...step,
    icon: text(`how_step_icon_${index}`, step.icon),
    title: text(`how_step_title_${index}`, step.title),
    text: text(`how_step_text_${index}`, step.text),
  }));

  const updatedValues = currentSettings.missionVisionValues.values.map((value, index) => ({
    ...value,
    icon: text(`mvv_value_icon_${index}`, value.icon),
    title: text(`mvv_value_title_${index}`, value.title),
    text: text(`mvv_value_text_${index}`, value.text),
  }));

  const updatedSegmentItems = currentSettings.clientSegments.items.map((item, index) => ({
    ...item,
    icon: text(`seg_item_icon_${index}`, item.icon),
    label: text(`seg_item_label_${index}`, item.label),
    detail: text(`seg_item_detail_${index}`, item.detail),
    behavior: text(`seg_item_behavior_${index}`, item.behavior),
  }));

  const updatedHowWeWork = {
    ...currentSettings.howWeWork,
    eyebrow: text('how_eyebrow', currentSettings.howWeWork.eyebrow),
    title: text('how_title', currentSettings.howWeWork.title),
    text: text('how_text', currentSettings.howWeWork.text),
    steps: updatedSteps,
  };

  const updatedMissionVisionValues = {
    ...currentSettings.missionVisionValues,
    eyebrow: text('mvv_eyebrow', currentSettings.missionVisionValues.eyebrow),
    title: text('mvv_title', currentSettings.missionVisionValues.title),
    mission: {
      ...currentSettings.missionVisionValues.mission,
      title: text('mvv_mission_title', currentSettings.missionVisionValues.mission.title),
      text: text('mvv_mission_text', currentSettings.missionVisionValues.mission.text),
    },
    vision: {
      ...currentSettings.missionVisionValues.vision,
      title: text('mvv_vision_title', currentSettings.missionVisionValues.vision.title),
      text: text('mvv_vision_text', currentSettings.missionVisionValues.vision.text),
    },
    values: updatedValues,
  };

  const updatedClientSegments = {
    ...currentSettings.clientSegments,
    eyebrow: text('seg_eyebrow', currentSettings.clientSegments.eyebrow),
    title: text('seg_title', currentSettings.clientSegments.title),
    text: text('seg_text', currentSettings.clientSegments.text),
    items: updatedSegmentItems,
  };

  const updated = {
    hero: {
      ...current.hero,
      eyebrow: text('hero_eyebrow', current.hero.eyebrow),
      title: text('hero_title', current.hero.title),
      titleHighlight: text('hero_title2', current.hero.titleHighlight),
      lead: text('hero_lead', current.hero.lead),
      primaryCta: {
        label: text('cta1', current.hero.primaryCta.label),
        href: text('cta1url', current.hero.primaryCta.href),
      },
      secondaryCta: {
        label: text('cta2', current.hero.secondaryCta.label),
        href: text('cta2url', current.hero.secondaryCta.href),
      },
      image: text('hero_image', current.hero.image),
      imageAlt: text('hero_alt', current.hero.imageAlt),
      pillars: lines('pillars', current.hero.pillars),
    },
    valueProposition: {
      ...current.valueProposition,
      eyebrow: text('vp_eyebrow', current.valueProposition.eyebrow),
      title: text('vp_title', current.valueProposition.title),
      text: text('vp_text', current.valueProposition.text),
      image: text('vp_image', current.valueProposition.image),
      imageAlt: text('vp_alt', current.valueProposition.imageAlt),
      points: updatedVpPoints,
    },
    heroSlides: updatedHeroSlides.length ? updatedHeroSlides : current.heroSlides,
    heroSlideIntervalSeconds,
    elo: {
      ...current.elo,
      eyebrow: text('elo_eyebrow', current.elo.eyebrow),
      title: text('elo_title', current.elo.title),
      text: text('elo_text', current.elo.text),
      nodes: updatedEloNodes,
    },
    benefits: { ...current.benefits, items: updatedBenefits },
    finalCta: {
      ...current.finalCta,
      eyebrow: text('cta_eyebrow', current.finalCta.eyebrow),
      title: text('cta_title', current.finalCta.title),
      text: text('cta_text', current.finalCta.text),
      primary: {
        label: text('cta_primary_label', current.finalCta.primary.label),
        href: text('cta_primary_href', current.finalCta.primary.href),
      },
    },
    promoVideo: {
      title: text('video_title', current.promoVideo.title),
      text: text('video_text', current.promoVideo.text),
      url: text('video_url', current.promoVideo.url),
    },
    sectionStyles: Object.fromEntries(
      HOME_SECTION_KEYS.map((key) => [
        key,
        {
          // Espalha o que já existe primeiro: este formulário só edita bg/text,
          // e sobrescrever o registro inteiro apagaria imagem, escurecimento,
          // altura mínima e espaçamento configurados no Editor Visual.
          ...current.sectionStyles[key],
          bg: text(`style_${key}_bg`, current.sectionStyles[key].bg),
          text: text(`style_${key}_text`, current.sectionStyles[key].text),
        },
      ])
    ) as typeof current.sectionStyles,
    // Ordem, visibilidade e aparência da página são definidas no Editor
    // Visual; o formulário não as edita, então repassa o que já está salvo
    // em vez de zerar. `bands`/`indicators` seguem a mesma regra: só o
    // Editor Visual grava neles.
    pageStyle: current.pageStyle,
    sectionOrder: current.sectionOrder,
    hiddenSections: current.hiddenSections,
    layouts: current.layouts,
    overlays: current.overlays,
    bands: current.bands,
    indicators: current.indicators,
    faqItems: updatedFaqItems.length ? updatedFaqItems : current.faqItems,
  };

  await updateHomeContent(db, updated, Astro.locals.user?.id);
  await updateSetting(db, 'howWeWork', updatedHowWeWork, Astro.locals.user?.id);
  await updateSetting(db, 'missionVisionValues', updatedMissionVisionValues, Astro.locals.user?.id);
  await updateSetting(db, 'clientSegments', updatedClientSegments, Astro.locals.user?.id);
  await writeAuditLog(db, {
    userId: Astro.locals.user?.id,
    userName: Astro.locals.user?.name ?? '',
    action: 'page.update',
    target: 'Página: Home',
    ip: Astro.request.headers.get('cf-connecting-ip') ?? '',
  });

  return Astro.redirect('/admin/paginas/home?saved=1');
}

const {
  hero,
  heroSlides,
  heroSlideIntervalSeconds,
  valueProposition,
  elo,
  benefits,
  finalCta,
  promoVideo,
  faqItems,
  sectionStyles,
  updatedAt,
} = await getHomeContent(db);
const { howWeWork, missionVisionValues, clientSegments } = await getSettings(db);
const justSaved = Astro.url.searchParams.get('saved') === '1';

function formatDate(iso: string): string {
  if (!iso) return '—';
  const [datePart, timePart] = iso.split(' ');
  const [y, m, d] = (datePart ?? '').split('-');
  const hm = (timePart ?? '').slice(0, 5);
  return `${d}/${m}/${y} ${hm}`;
}
---

<AdminLayout
  title="Editar Home"
  description="Edite em um só lugar o que aparece na página inicial: carrossel, ícones e abas de serviços, matérias, perguntas frequentes e contato."
  active="/admin/paginas"
>
  <div slot="actions">
    <a href="/" class="btn btn--secondary btn--sm" target="_blank" rel="noopener">
      <Icon name="eye" size={16} />
      Pré-visualizar
    </a>
  </div>

  {
    justSaved && (
      <div
        class="form-alert form-alert--success"
        role="status"
        style="margin-bottom: var(--sp-5)"
      >
        <Icon name="check-circle" size={18} />
        <span>Home salva. Já vale para o site publicado.</span>
      </div>
    )
  }

  <form class="editor-layout" method="post" id="form-home">
    <div class="stack-panels">
      <!-- edição da seção hero -->
      <section class="panel">
        <div class="panel__head">
          <h2 class="panel__title">Carrossel do topo</h2>
          <span class="badge badge--brand">Home</span>
        </div>
        <div class="panel__body">
          <div class="form-section">
            <h3 class="form-section__title">Carrossel do topo</h3>
            <p class="hint">
              Estes slides controlam as imagens, títulos e textos que aparecem no topo da Home.
              Use imagens horizontais, com área limpa à esquerda para o texto.
            </p>
            <div class="field">
              <label class="label" for="hero_slide_interval">
                Tempo de troca automática (segundos)
              </label>
              <input
                class="input"
                id="hero_slide_interval"
                name="hero_slide_interval"
                type="number"
                min="3"
                max="30"
                step="1"
                value={heroSlideIntervalSeconds}
              />
              <span class="hint">Use entre 3 e 30 segundos. Padrão: 6.</span>
            </div>
            <div class="hero-slide-editor" data-hero-slide-editor>
              {
                heroSlides.map((slide, index) => (
                  <div class="hero-slide-editor__item" data-hero-slide-row>
                    <div class="hero-slide-editor__head">
                      <strong>Slide {index + 1}</strong>
                      <button
                        type="button"
                        class="row-btn row-btn--danger"
                        data-hero-slide-remove
                      >
                        Excluir
                      </button>
                    </div>
                    <div class="field">
                      <label class="label">Título</label>
                      <input class="input" name="hero_slide_title" value={slide.title} />
                    </div>
                    <div class="field">
                      <label class="label">Texto</label>
                      {/* prettier-ignore */}
                      <textarea class="textarea hero-slide-editor__text" name="hero_slide_text">{slide.text}</textarea>
                    </div>
                    <div class="field hero-slide-editor__image" data-hero-slide-upload>
                      <label class="label">Imagem</label>
                      <div class="image-upload__row">
                        <img
                          class="image-upload__preview"
                          src={slide.image}
                          alt=""
                          width="120"
                          height="90"
                          data-hero-slide-preview
                        />
                        <div class="image-upload__controls">
                          <input class="input" name="hero_slide_image" value={slide.image} data-hero-slide-url />
                          <label class="btn btn--secondary btn--sm image-upload__btn">
                            <Icon name="upload" size={14} />
                            Enviar arquivo
                            <input
                              type="file"
                              accept="image/jpeg,image/png,image/webp"
                              style="display:none"
                              data-hero-slide-file
                            />
                          </label>
                          <span class="hint" data-hero-slide-status></span>
                        </div>
                      </div>
                    </div>
                    <div class="field">
                      <label class="label">Texto alternativo</label>
                      <input class="input" name="hero_slide_alt" value={slide.alt} />
                    </div>
                  </div>
                ))
              }
            </div>
            <button type="button" class="btn btn--secondary btn--sm" data-hero-slide-add>
              <Icon name="plus" size={16} />
              Adicionar slide
            </button>
          </div>

        </div>
      </section>

      <section class="panel">
        <div class="panel__head">
          <h2 class="panel__title">Ícones e abas de serviços da Home</h2>
          <span class="badge badge--brand">Home</span>
        </div>
        <div class="panel__body">
          <p class="hint">
            Edite aqui os cartões de ícones e o conteúdo das abas que aparecem logo abaixo do
            carrossel da página inicial. O limite é de {MAX_HOME_SERVICES} serviços. Serviços
            inativos ficam salvos no painel, mas não aparecem no site.
          </p>
          <div class="home-service-editor" data-home-service-editor data-service-limit={MAX_HOME_SERVICES}>
            {
              homeServices.map((service, serviceIndex) => (
                <section class="home-service-card" data-home-service-row>
                  <input type="hidden" name="home_service_key" value={service.id} />
                  <input type="hidden" name={`service_${service.id}_action`} value="save" data-service-action />
                  <div class="home-service-card__head">
                    <span class="order">{String(serviceIndex + 1).padStart(2, '0')}</span>
                    <div>
                      <h3>{service.name}</h3>
                      <span>{service.shortName || service.slug}</span>
                    </div>
                    <div class="home-service-card__actions">
                      <label class="field field--inline">
                        <span class="label">Status</span>
                        <select class="select select--sm" name={`service_${service.id}_status`}>
                          <option value="published" selected={service.status === 'published'}>
                            Ativo
                          </option>
                          <option value="draft" selected={service.status !== 'published'}>
                            Inativo
                          </option>
                        </select>
                      </label>
                      <button type="button" class="row-btn row-btn--danger" data-service-delete>
                        Excluir
                      </button>
                    </div>
                  </div>

                  <div class="form-grid form-grid--2">
                    <div class="field">
                      <label class="label" for={`service_${service.id}_name`}>Título da aba</label>
                      <input
                        class="input"
                        id={`service_${service.id}_name`}
                        name={`service_${service.id}_name`}
                        value={service.name}
                      />
                    </div>
                    <div class="field">
                      <label class="label" for={`service_${service.id}_short`}>
                        Texto do ícone
                      </label>
                      <input
                        class="input"
                        id={`service_${service.id}_short`}
                        name={`service_${service.id}_short`}
                        value={service.shortName}
                      />
                    </div>
                  </div>

                  <div class="form-grid form-grid--2">
                    <IconPicker
                      name={`service_${service.id}_icon`}
                      value={service.icon}
                      label="Ícone do cartão"
                    />
                    <div class="field">
                      <label class="label" for={`service_${service.id}_wa`}>
                        Mensagem do WhatsApp
                      </label>
                      <input
                        class="input"
                        id={`service_${service.id}_wa`}
                        name={`service_${service.id}_wa`}
                        value={service.whatsappMessage}
                      />
                    </div>
                  </div>

                  <div class="field">
                    <label class="label" for={`service_${service.id}_summary`}>
                      Texto principal da aba
                    </label>
                    {/* prettier-ignore */}
                    <textarea class="textarea" id={`service_${service.id}_summary`} name={`service_${service.id}_summary`} style="min-height:92px">{service.summary}</textarea>
                  </div>

                  <ImageUploadField
                    id={`service_${service.id}_image`}
                    name={`service_${service.id}_image`}
                    value={service.image}
                    label="Imagem da aba"
                  />

                  <div class="field">
                    <label class="label" for={`service_${service.id}_alt`}>
                      Texto alternativo da imagem
                    </label>
                    <input
                      class="input"
                      id={`service_${service.id}_alt`}
                      name={`service_${service.id}_alt`}
                      value={service.imageAlt}
                    />
                  </div>

                  <div class="form-section home-service-card__highlights">
                    <h4 class="form-section__title">Destaques da aba</h4>
                    {service.highlights.slice(0, 3).map((item, index) => (
                      <div class="home-highlight-row">
                        <IconPicker
                          name={`service_${service.id}_highlight_${index}_icon`}
                          value={item.icon}
                          label={`Ícone ${index + 1}`}
                        />
                        <div class="home-highlight-row__fields">
                          <input
                            class="input"
                            name={`service_${service.id}_highlight_${index}_title`}
                            value={item.title}
                            aria-label={`Título do destaque ${index + 1}`}
                          />
                          <input
                            class="input"
                            name={`service_${service.id}_highlight_${index}_text`}
                            value={item.text}
                            aria-label={`Texto do destaque ${index + 1}`}
                          />
                        </div>
                      </div>
                    ))}
                  </div>
                </section>
              ))
            }
          </div>
          <button
            type="button"
            class="btn btn--secondary btn--sm"
            data-home-service-add
            disabled={homeServices.length >= MAX_HOME_SERVICES}
          >
            <Icon name="plus" size={16} />
            Adicionar serviço
          </button>
          <span class="hint" data-home-service-count>
            {homeServices.length} de {MAX_HOME_SERVICES} serviços cadastrados nesta tela.
          </span>
        </div>
      </section>

      <!-- proposta de valor -->
      <section class="panel" hidden>
        <div class="panel__head">
          <h2 class="panel__title">Seção: Proposta de valor</h2>
          <span class="badge badge--brand">Em edição</span>
        </div>
        <div class="panel__body">
          <SectionColorFields sectionKey="proposta" value={sectionStyles.proposta} />
          <div class="form-section">
            <div class="field">
              <label class="label" for="vp_eyebrow">Rótulo (eyebrow)</label>
              <input
                class="input"
                id="vp_eyebrow"
                name="vp_eyebrow"
                value={valueProposition.eyebrow}
              />
            </div>
            <div class="field">
              <label class="label" for="vp_title">Título</label>
              <input
                class="input"
                id="vp_title"
                name="vp_title"
                value={valueProposition.title}
