---
/**
 * Hub do Editor Visual — ponto de entrada único do fluxo:
 *   Conteúdo → Editor Visual → Páginas → selecionar uma página → Aparência
 *
 * Migração incremental (ver plano apresentado antes de começar): cada página
 * convertida para o banco entra em `MIGRATED_PAGES` com suas 4 ações. As
 * demais, listadas em `data/admin.ts`, aparecem como "Migração pendente" —
 * um estado deliberadamente temporário, não uma resposta definitiva.
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { pages } from '../../../data/admin';

interface PageAction {
  label: string;
  href: string;
  icon: string;
  hint: string;
}

/** Próxima página migrada entra aqui, com suas 4 ações. */
const MIGRATED_PAGES: Record<string, PageAction[]> = {
  Home: [
    {
      label: 'Editar conteúdo',
      href: '/admin/paginas/home',
      icon: 'edit',
      hint: 'Textos, ícones e imagens de cada seção, em formulário.',
    },
    {
      label: 'Editor visual',
      href: '/admin/editor/home',
      icon: 'pointer',
      hint: 'Arraste, redimensione e posicione elementos na página real.',
    },
    {
      label: 'Aparência',
      href: '/admin/editor/home/aparencia',
      icon: 'palette',
      hint: 'Cores globais, desta página e de cada seção.',
    },
    {
      label: 'Configurações da página',
      href: '/admin/paginas/home#pagina-config',
      icon: 'settings',
      hint: 'SEO e demais ajustes específicos da Home.',
    },
  ],
  'Quem Somos': [
    {
      label: 'Editar conteúdo',
      href: '/admin/paginas/quem-somos',
      icon: 'edit',
      hint: 'Textos de abertura de cada seção, em formulário.',
    },
    {
      label: 'Editor visual',
      href: '/admin/editor/quem-somos',
      icon: 'pointer',
      hint: 'Arraste, redimensione e posicione elementos na página real.',
    },
    {
      label: 'Aparência',
      href: '/admin/editor/quem-somos/aparencia',
      icon: 'palette',
      hint: 'Cores globais, desta página e de cada seção.',
    },
    {
      label: 'Configurações da página',
      href: '/admin/paginas/quem-somos#pagina-config',
      icon: 'settings',
      hint: 'Itens de lista e elementos livres ficam no Editor Visual.',
    },
  ],
  Contato: [
    {
      label: 'Editar conteúdo',
      href: '/admin/paginas/contato',
      icon: 'edit',
      hint: 'Textos e sobrescritas sobre os dados globais da empresa.',
    },
    {
      label: 'Editor visual',
      href: '/admin/editor/contato',
      icon: 'pointer',
      hint: 'O formulário é um bloco protegido — mova-o sem quebrar os campos.',
    },
    {
      label: 'Aparência',
      href: '/admin/editor/contato/aparencia',
      icon: 'palette',
      hint: 'Cores globais, desta página e de cada seção.',
    },
    {
      label: 'Configurações da página',
      href: '/admin/paginas/contato#pagina-config',
      icon: 'settings',
      hint: 'Elementos livres e formas ficam no Editor Visual.',
    },
  ],
  Serviços: [
    {
      label: 'Editar conteúdo',
      href: '/admin/paginas/servicos',
      icon: 'edit',
      hint: 'Textos de abertura, "Como atuamos" e chamada final.',
    },
    {
      label: 'Editor visual',
      href: '/admin/editor/servicos/moldura',
      icon: 'pointer',
      hint: 'A grade de serviços continua vindo de Conteúdo → Serviços.',
    },
    {
      label: 'Aparência',
      href: '/admin/editor/servicos/aparencia',
      icon: 'palette',
      hint: 'Cores globais, desta página e de cada seção.',
    },
    {
      label: 'Configurações da página',
      href: '/admin/paginas/servicos#pagina-config',
      icon: 'settings',
      hint: 'Os serviços individuais continuam em Conteúdo → Serviços.',
    },
    {
      label: 'Serviços individuais',
      href: '/admin/editor/servicos',
      icon: 'layers',
      hint: 'Lista automática da tabela `services` — cada serviço com Editor Visual e Aparência próprios.',
    },
  ],
  'Política de Privacidade': [
    {
      label: 'Editar conteúdo',
      href: '/admin/paginas/politica',
      icon: 'edit',
      hint: 'Abertura, aviso e data de atualização.',
    },
    {
      label: 'Editor visual',
      href: '/admin/editor/politica',
      icon: 'pointer',
      hint: 'As seções numeradas são editáveis, reordenáveis e duplicáveis aqui.',
    },
    {
      label: 'Aparência',
      href: '/admin/editor/politica/aparencia',
      icon: 'palette',
      hint: 'Cores globais, desta página e de cada seção.',
    },
    {
      label: 'Configurações da página',
      href: '/admin/paginas/politica#pagina-config',
      icon: 'settings',
      hint: 'SEO e demais ajustes específicos.',
    },
  ],
  Conteúdos: [
    {
      label: 'Editar conteúdo',
      href: '/admin/paginas/conteudos',
      icon: 'edit',
      hint: 'Abertura e chamada final.',
    },
    {
      label: 'Editor visual',
      href: '/admin/editor/conteudos',
      icon: 'pointer',
      hint: 'A grade de matérias continua vindo de Conteúdo → Matérias.',
    },
    {
      label: 'Aparência',
      href: '/admin/editor/conteudos/aparencia',
      icon: 'palette',
      hint: 'Cores globais, desta página e de cada seção.',
    },
    {
      label: 'Configurações da página',
      href: '/admin/paginas/conteudos#pagina-config',
      icon: 'settings',
      hint: 'As matérias individuais continuam em Conteúdo → Matérias.',
    },
  ],
};
---

<AdminLayout
  title="Editor Visual"
  description="Selecione uma página para editar seu conteúdo, layout visual e aparência."
  active="/admin/editor"
>
  <section class="panel">
    <div class="panel__head">
      <h2 class="panel__title">Páginas do site</h2>
    </div>
    <div class="panel__body stack">
      {
        pages.map((page) => {
          const actions = MIGRATED_PAGES[page.title];
          const isMigrated = Boolean(actions);
          return (
            <div class:list={['page-card', { 'page-card--active': isMigrated }]}>
              <div class="page-card__head">
                <div>
                  <p class="page-card__title">{page.title}</p>
                  <span class="kbd">{page.slug}</span>
                </div>
                <span class:list={['badge', isMigrated ? 'badge--success' : 'badge--warning']}>
                  {isMigrated ? 'Editável' : 'Migração pendente'}
                </span>
              </div>

              {actions ? (
                <div class="page-card__actions">
                  {actions.map((action) => (
                    <a class="page-action" href={action.href}>
                      <Icon name={action.icon} size={16} />
                      <span>
                        <strong>{action.label}</strong>
                        <small>{action.hint}</small>
                      </span>
                    </a>
                  ))}
                </div>
              ) : (
                <p class="muted small">
                  Ainda gerenciada como conteúdo estático — Editor Visual e Aparência própria
                  chegam nas próximas rodadas de migração.
                </p>
              )}
            </div>
          );
        })
      }
    </div>
  </section>
</AdminLayout>

<style>
  .page-card {
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    padding: var(--sp-5);
  }

  .page-card--active {
    border-color: var(--c-accent-300);
  }

  .page-card__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--sp-3);
    margin-bottom: var(--sp-3);
  }

  .page-card__title {
    font-weight: 600;
    margin-bottom: 0.15rem;
  }

  .page-card__actions {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    gap: var(--sp-3);
  }

  .page-action {
    display: flex;
    align-items: flex-start;
    gap: var(--sp-3);
    padding: var(--sp-3);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    color: inherit;
    text-decoration: none;
    transition: border-color 0.15s ease;
  }

  .page-action:hover {
    border-color: var(--c-accent-500);
  }

  .page-action strong {
    display: block;
    font-size: var(--fs-sm);
  }

  .page-action small {
    display: block;
    color: var(--text-muted);
    font-size: var(--fs-xs);
    margin-top: 0.15rem;
  }
</style>
