---
/**
 * Editor visual da Quem Somos.
 *
 * Mesma moldura da Home (ver src/pages/admin/editor/home.astro) — o
 * runtime de edição (`public/editor-runtime.js`) já é genérico, dirigido só
 * por atributos `data-edit`/`data-overlay`/`data-section`, então a mesma
 * "moldura" de painéis serve para qualquer página. O que muda é apenas a
 * fonte do conteúdo (`getQuemSomosContent`) e o endpoint de gravação
 * (`/admin/api/document-content`, com `slug`).
 *
 * Diferença deliberada desta primeira página migrada: sem arrastar para
 * reordenar seções (a Home tem seções fixas intercaladas com trechos não
 * editáveis — serviços, conteúdos — que exigem "slots"; a Quem Somos não
 * tem esse encaixe, então a ordem das 5 seções é sempre a mesma).
 */
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import { getDB } from '../../../lib/db';
import { getQuemSomosContent, QUEM_SOMOS_SECTION_KEYS } from '../../../lib/documents';
import { iconPaths } from '../../../data/icons';

const db = getDB();
const content = await getQuemSomosContent(db);

const SECTION_LABELS: Record<string, string> = {
  about: 'Nossa atuação',
  elo: 'O modelo Essencial',
  howWeWork: 'Como atuamos',
  mvv: 'Missão, visão e valores',
  segments: 'Para quem atuamos',
};

const bootstrap = {
  sectionOrder: content.sectionOrder,
  hiddenSections: content.hiddenSections,
  layouts: content.layouts,
  overlays: content.overlays,
  sectionStyles: content.sectionStyles,
  labels: SECTION_LABELS,
  keys: QUEM_SOMOS_SECTION_KEYS,
  icons: iconPaths,
};

// `<` escapado para o JSON nunca poder fechar a própria tag <script>.
const bootstrapJson = JSON.stringify(bootstrap).replace(/</g, '\\u003c');
---

<AdminLayout
  title="Editor visual — Quem Somos"
  description="Clique em qualquer elemento da página para editar no lugar."
  active="/admin/editor"
>
  <div slot="actions">
    <a href="/admin/editor/quem-somos/aparencia" class="btn btn--secondary btn--sm">
      <Icon name="palette" size={16} />
      Aparência
    </a>
    <a href="/admin/paginas/quem-somos" class="btn btn--secondary btn--sm">
      <Icon name="edit" size={16} />
      Editar por formulário
    </a>
  </div>

  <script type="application/json" id="editor-bootstrap" set:html={bootstrapJson} />

  <div class="editor">
    <!-- ------------------------------------------------------- topo -->
    <div class="editor__topbar">
      <div class="editor__group">
        <button type="button" class="ed-btn" data-undo disabled title="Desfazer (Ctrl+Z)">
          <Icon name="refresh" size={16} />
          Desfazer
        </button>
        <button type="button" class="ed-btn" data-redo disabled title="Refazer (Ctrl+Shift+Z)">
          <Icon name="refresh" size={16} />
          Refazer
        </button>
      </div>

      <div class="editor__group" role="group" aria-label="Largura de visualização">
        <button type="button" class="ed-btn is-active" data-device="desktop">
          <Icon name="monitor" size={16} />
          Computador
        </button>
        <button type="button" class="ed-btn" data-device="tablet">
          <Icon name="tablet" size={16} />
          Tablet
        </button>
        <button type="button" class="ed-btn" data-device="mobile">
          <Icon name="smartphone" size={16} />
          Celular
        </button>
      </div>

      <div class="editor__group editor__group--end">
        <span class="ed-status" data-status data-state="idle">Tudo salvo</span>
        <a href="/" target="_blank" rel="noopener" class="ed-btn">
          <Icon name="eye" size={16} />
          Ver site
        </a>
      </div>
    </div>

    <div class="editor__body">
      <!-- --------------------------------------------------- lateral -->
      <nav class="editor__rail" aria-label="Ferramentas">
        <button type="button" class="rail-btn is-active" data-tool="sections">
          <Icon name="layers" size={20} />
          <span>Seções</span>
        </button>
        <button type="button" class="rail-btn" data-tool="props">
          <Icon name="edit" size={20} />
          <span>Elemento</span>
        </button>
        <button type="button" class="rail-btn" data-tool="layers">
          <Icon name="list" size={20} />
          <span>Camadas</span>
        </button>
        <button type="button" class="rail-btn" data-tool="add">
          <Icon name="plus" size={20} />
          <span>Adicionar</span>
        </button>
        <button type="button" class="rail-btn" data-tool="colors">
          <Icon name="palette" size={20} />
          <span>Cores</span>
        </button>
      </nav>

      <aside class="editor__panel">
        <!-- Seções ------------------------------------------------- -->
        <div class="panel-pane is-open" data-pane="sections">
          <h2 class="panel-title">Seções da página</h2>
          <p class="panel-hint">
            Arraste para trocar a ordem. O olho liga e desliga a seção no site.
          </p>
          <ul class="section-list" data-section-list></ul>
        </div>

        <!-- Elemento selecionado ---------------------------------- -->
        <div class="panel-pane" data-pane="props">
          <div class="panel-empty" data-props-empty>
            <span class="panel-empty__icon"><Icon name="pointer" size={22} /></span>
            <p>Clique em um texto, imagem, vídeo ou ícone da página para editar aqui.</p>
          </div>

          <div class="panel-form" data-props-form hidden>
            <h2 class="panel-title" data-props-label>Elemento</h2>
            <p class="panel-path" data-props-path></p>

            <!-- texto -->
            <div class="field" data-props-text hidden>
              <label class="label" for="prop-text">Conteúdo</label>
              <textarea class="textarea" id="prop-text" rows="5"></textarea>
              <p class="panel-hint">Também dá para digitar direto na página.</p>
            </div>

            <!-- imagem / vídeo -->
            <div class="field" data-props-media hidden>
              <span class="label" data-media-label>Arquivo</span>
              <div class="media-box">
                <img data-media-preview alt="" hidden />
                <video data-media-video controls hidden></video>
                <span class="media-box__empty" data-media-empty>Sem arquivo</span>
              </div>
              <label class="btn btn--secondary btn--sm ed-upload">
                <Icon name="upload" size={16} />
                <span data-media-btn-label>Enviar arquivo</span>
                <input type="file" data-media-file hidden />
              </label>
              <input class="input" data-media-url placeholder="/media/arquivo.jpg" />
              <p class="panel-hint" data-media-status></p>
            </div>

            <!-- ícone -->
            <div class="field" data-props-icon hidden>
              <span class="label">Ícone</span>
              <input
                class="input"
                data-icon-search
                placeholder="Buscar ícone (coração, hospital…)"
              />
              <div class="icon-grid" data-icon-grid></div>
              <label class="btn btn--secondary btn--sm ed-upload">
                <Icon name="upload" size={16} />
                Enviar ícone próprio
                <input
                  type="file"
                  accept="image/png,image/jpeg,image/webp"
                  data-icon-file
                  hidden
                />
              </label>
              <p class="panel-hint" data-icon-status></p>
            </div>

            <!-- posição, tamanho e estilo -->
            <div class="field" data-props-layout hidden>
              <span class="label">Posição e estilo</span>
              <p class="panel-hint" data-layout-scope></p>
              <p class="panel-hint">
                Setas movem 1px, Shift+setas move 10px. Segure
                <kbd>Alt</kbd> arrastando para desativar o encaixe.
              </p>

              <div class="prop-grid">
                <label>
                  Corpo
                  <input type="number" step="0.125" min="0" max="12" data-prop="fontSize" />
                </label>
                <label>
                  Peso
                  <select data-prop="weight">
                    <option value="0">herda</option>
                    <option value="400">normal</option>
                    <option value="600">semibold</option>
                    <option value="700">bold</option>
                    <option value="800">extra</option>
                  </select>
                </label>
                <label>
                  Largura %
                  <input type="number" step="1" min="0" max="100" data-prop="w" />
                </label>
                <label>
                  Camada
                  <input type="number" step="1" min="0" max="99" data-prop="z" />
                </label>
              </div>

              <div class="prop-row">
                <span>Cor</span>
                <input type="color" data-prop-color-swatch />
                <input type="text" data-prop="color" placeholder="herda" />
              </div>

              <div class="prop-row" role="group" aria-label="Alinhamento">
                <span>Alinhar</span>
                <button type="button" class="ed-btn" data-align="left">E</button>
                <button type="button" class="ed-btn" data-align="center">C</button>
                <button type="button" class="ed-btn" data-align="right">D</button>
                <button type="button" class="ed-btn" data-align="">—</button>
              </div>

              <div class="prop-row">
                <button type="button" class="ed-btn" data-layer="front">Trazer à frente</button>
                <button type="button" class="ed-btn" data-layer="back">Enviar p/ trás</button>
              </div>

              <div class="prop-row">
                <span>Girar</span>
                <input type="range" min="-180" max="180" step="1" data-prop-rotate />
                <span class="bg-field__readout" data-rotate-readout>0°</span>
              </div>

              <div class="prop-row">
                <label class="prop-check">
                  <input type="checkbox" data-prop-lock />
                  Bloquear
                </label>
                <label class="prop-check">
                  <input type="checkbox" data-prop-hide />
                  Ocultar
                </label>
                <button type="button" class="ed-btn" data-layout-reset>Reiniciar</button>
              </div>

              <div class="prop-row">
                <button type="button" class="ed-btn" data-el-duplicate>
                  <Icon name="copy" size={15} />
                  Duplicar
                </button>
                <button type="button" class="ed-btn ed-btn--danger" data-el-delete>
                  <Icon name="trash" size={15} />
                  Excluir
                </button>
              </div>
              <p class="panel-hint" data-el-actions-hint></p>
            </div>

            <!-- propriedades específicas de forma -->
            <div class="field" data-props-shape hidden>
              <span class="label">Forma</span>

              <div class="prop-row">
                <span>Preenche</span>
                <input type="color" data-shape-fill />
              </div>
              <div class="prop-row">
                <span>Borda</span>
                <input type="color" data-shape-stroke />
                <input
                  type="number"
                  min="0"
                  max="20"
                  step="1"
                  data-shape-stroke-width
                  style="width:52px"
                  title="Espessura da borda (px)"
                />
              </div>

              <span class="label">Link (opcional)</span>
              <div class="field">
                <select class="select" data-shape-link-page>
                  <option value="">— nenhum —</option>
                  <option value="/">Início</option>
                  <option value="/quem-somos">Quem Somos</option>
                  <option value="/servicos">Serviços</option>
                  <option value="/conteudos">Conteúdos</option>
                  <option value="/contato">Contato</option>
                  <option value="__external">URL externa…</option>
                </select>
                <input
                  type="text"
                  class="input"
                  data-shape-link-external
                  placeholder="https://…"
                  hidden
                  style="margin-top:0.4rem"
                />
              </div>
              <label class="prop-check">
                <input type="checkbox" data-shape-link-blank />
                Abrir em nova aba
              </label>
            </div>

            <!-- item de lista -->
            <div class="field" data-props-item hidden>
              <span class="label">Item da lista</span>
              <div class="cluster">
                <button type="button" class="ed-btn" data-item-up>
                  <Icon name="chevron-left" size={15} />
                  Antes
                </button>
                <button type="button" class="ed-btn" data-item-down>
                  Depois
                  <Icon name="chevron-right" size={15} />
                </button>
                <button type="button" class="ed-btn" data-item-duplicate>
                  <Icon name="copy" size={15} />
                  Duplicar
                </button>
                <button type="button" class="ed-btn ed-btn--danger" data-item-remove>
                  <Icon name="trash" size={15} />
                  Excluir
                </button>
              </div>
              <p class="panel-hint">
                Duplicar e excluir recarregam a pré-visualização para renumerar os itens.
              </p>
            </div>
          </div>
        </div>

        <!-- Camadas ----------------------------------------------- -->
        <div class="panel-pane" data-pane="layers">
          <h2 class="panel-title">Camadas</h2>
          <div class="field">
            <label class="label" for="layer-section">Seção</label>
            <select class="select" id="layer-section" data-layer-section></select>
          </div>
          <p class="panel-hint">
            Arraste para mudar a ordem visual. O olho oculta no site, o cadeado trava a
            manipulação e o lápis renomeia a camada.
          </p>
          <ul class="layer-list" data-layer-list></ul>
        </div>

        <!-- Adicionar elemento livre ------------------------------ -->
        <div class="panel-pane" data-pane="add">
          <h2 class="panel-title">Adicionar elemento</h2>
          <p class="panel-hint">
            O elemento entra sobreposto à seção escolhida e pode ser arrastado e redimensionado
            livremente, sem deslocar o conteúdo existente.
          </p>

          <div class="field">
            <label class="label" for="add-section">Seção</label>
            <select class="select" id="add-section" data-add-section></select>
          </div>

          <div class="add-grid">
            <button type="button" class="add-card" draggable="true" data-add="text">
              <Icon name="edit" size={18} />
              Texto
            </button>
            <button type="button" class="add-card" draggable="true" data-add="image">
              <Icon name="image" size={18} />
              Imagem
            </button>
            <button type="button" class="add-card" draggable="true" data-add="video">
              <Icon name="play" size={18} />
              Vídeo
            </button>
            <button type="button" class="add-card" draggable="true" data-add="icon">
              <Icon name="star" size={18} />
              Ícone
            </button>
            <button
              type="button"
              class="add-card"
              data-add="shape"
              title="Clique para escolher a silhueta antes de inserir"
            >
              <Icon name="square" size={18} />
              Forma
            </button>
            <a class="add-card" href="/admin/midia" target="_blank" rel="noopener">
              <Icon name="upload" size={18} />
              Uploads
            </a>
          </div>

          <p class="panel-hint">
            Clique para inserir no meio da seção escolhida, ou arraste o cartão até o ponto
            exato da pré-visualização.
          </p>
          <p class="panel-hint" data-add-status></p>

          <!-- Seletor de forma: aparece ao clicar "Forma", antes de inserir -->
          <div class="shape-picker" data-shape-picker hidden>
            <p class="label">Escolha a forma</p>
            <div class="shape-grid">
              <button type="button" class="shape-card" data-shape="rect" title="Retângulo">
                <span class="shape-swatch shape-swatch--rect"></span>
              </button>
              <button
                type="button"
                class="shape-card"
                data-shape="rounded"
                title="Retângulo arredondado"
              >
                <span class="shape-swatch shape-swatch--rounded"></span>
              </button>
              <button
                type="button"
                class="shape-card"
                data-shape="ellipse"
                title="Círculo/elipse"
              >
                <span class="shape-swatch shape-swatch--ellipse"></span>
              </button>
              <button type="button" class="shape-card" data-shape="triangle" title="Triângulo">
                <span class="shape-swatch shape-swatch--triangle"></span>
              </button>
              <button type="button" class="shape-card" data-shape="diamond" title="Losango">
                <span class="shape-swatch shape-swatch--diamond"></span>
              </button>
              <button type="button" class="shape-card" data-shape="arrow" title="Seta">
                <span class="shape-swatch shape-swatch--arrow"></span>
              </button>
            </div>
            <button type="button" class="ed-btn" data-shape-cancel>Cancelar</button>
          </div>

          <div class="field">
            <span class="label">Fundo da seção</span>
            <p class="panel-hint">
              Cor, imagem e escurecimento ficam na aba
              <button type="button" class="link-like" data-goto-colors>Cores</button>.
            </p>
          </div>

          <h3 class="panel-title" style="margin-top:var(--sp-5)">Elementos livres</h3>
          <ul class="overlay-list" data-overlay-list></ul>
        </div>

        <!-- Cores -------------------------------------------------- -->
        <div class="panel-pane" data-pane="colors">
          <h2 class="panel-title">Cores por seção</h2>
          <p class="panel-hint">
            Deixe em branco para herdar a paleta desta página ou o padrão global, definidos em
            <a href="/admin/editor/quem-somos/aparencia">Aparência</a>.
          </p>
          <div class="color-list" data-color-list></div>
        </div>
      </aside>

      <!-- ----------------------------------------------------- tela -->
      <div class="editor__canvas">
        <div class="editor__frame" data-frame>
          <iframe
            src="/quem-somos?__edit=1"
            title="Pré-visualização da Quem Somos"
            data-preview
            loading="eager"
          ></iframe>
        </div>
      </div>
    </div>
  </div>
</AdminLayout>

<style>
  /* As classes do painel definem `display`, que sozinho venceria o atributo
     `hidden`. Sem isto, campos escondidos continuariam visíveis. */
  .editor [hidden] {
    display: none !important;
  }

  .editor {
    display: flex;
    flex-direction: column;
    height: calc(100vh - 132px);
    min-height: 520px;
    border: 1px solid var(--line);
    border-radius: var(--r-lg);
    overflow: hidden;
    background: var(--c-white);
  }

  /* ------------------------------------------------------------ topo */
  .editor__topbar {
    display: flex;
    align-items: center;
    gap: var(--sp-4);
    flex-wrap: wrap;
    padding: var(--sp-3) var(--sp-4);
    border-bottom: 1px solid var(--line);
    background: var(--c-ink-50);
  }

  .editor__group {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .editor__group--end {
    margin-left: auto;
  }

  .ed-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.7rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: var(--c-white);
    color: var(--text-strong);
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    cursor: pointer;
    text-decoration: none;
  }

  .ed-btn:hover:not(:disabled) {
    border-color: var(--c-brand-400);
    color: var(--c-brand-700);
  }

  .ed-btn:disabled {
    opacity: 0.45;
    cursor: not-allowed;
  }

  .ed-btn.is-active {
    background: var(--c-brand-600);
    border-color: var(--c-brand-600);
    color: #fff;
  }

  .ed-btn--danger:hover:not(:disabled) {
    border-color: var(--c-danger-500, #dc2626);
    color: var(--c-danger-600, #b91c1c);
  }

  .ed-status {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    padding: 0.25rem 0.6rem;
    border-radius: var(--r-pill);
    background: var(--c-white);
    border: 1px solid var(--line);
  }

  .ed-status[data-state='saving'] {
    color: var(--c-accent-700);
    border-color: var(--c-accent-300);
  }

  .ed-status[data-state='error'] {
    color: #b91c1c;
    border-color: #fca5a5;
  }

  /* ------------------------------------------------------- corpo */
  .editor__body {
    display: grid;
    grid-template-columns: 84px 328px 1fr;
    flex: 1;
    min-height: 0;
  }

  .editor__rail {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: var(--sp-3) 0.4rem;
    border-right: 1px solid var(--line);
    background: var(--c-ink-50);
  }

  .rail-btn {
    display: grid;
    justify-items: center;
    gap: 0.25rem;
    padding: 0.6rem 0.2rem;
    border: 0;
    border-radius: var(--r-sm);
    background: none;
    color: var(--text-muted);
    font-size: 0.6875rem;
    cursor: pointer;
  }

  .rail-btn:hover {
    background: var(--c-white);
    color: var(--c-brand-700);
  }

  .rail-btn.is-active {
    background: var(--c-brand-600);
    color: #fff;
  }

  .editor__panel {
    border-right: 1px solid var(--line);
    overflow-y: auto;
    padding: var(--sp-4);
  }

  .panel-pane {
    display: none;
  }

  .panel-pane.is-open {
    display: block;
  }

  .panel-title {
    font-size: var(--fs-sm);
    margin-bottom: 0.35rem;
  }

  .panel-hint {
    font-size: var(--fs-xs);
    color: var(--text-faint);
    line-height: var(--lh-relaxed);
    margin-bottom: var(--sp-3);
  }

  .panel-path {
    font-family: var(--font-mono);
    font-size: 0.6875rem;
    color: var(--text-faint);
    margin-bottom: var(--sp-3);
    word-break: break-all;
  }

  .panel-empty {
    display: grid;
    justify-items: center;
    gap: var(--sp-3);
    padding: var(--sp-8) var(--sp-4);
    text-align: center;
    color: var(--text-faint);
    font-size: var(--fs-xs);
    line-height: var(--lh-relaxed);
  }

  .panel-empty__icon {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--c-ink-50);
  }

  /* ------------------------------------------------------- campos */
  .media-box {
    display: grid;
    place-items: center;
    min-height: 110px;
    margin-bottom: var(--sp-2);
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--c-ink-50);
    overflow: hidden;
  }

  .media-box img,
  .media-box video {
    max-width: 100%;
    max-height: 160px;
    display: block;
  }

  .media-box__empty {
    font-size: var(--fs-xs);
    color: var(--text-faint);
  }

  .ed-upload {
    width: 100%;
    justify-content: center;
    margin-bottom: var(--sp-2);
  }

  .icon-grid {
    display: grid;
    grid-template-columns: repeat(6, 1fr);
    gap: 0.25rem;
    max-height: 210px;
    overflow-y: auto;
    margin: var(--sp-2) 0;
    padding: 0.25rem;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
  }

  /* --------------------------------------------------------- tela */
  .editor__canvas {
    overflow: auto;
    background: repeating-conic-gradient(var(--c-ink-100) 0% 25%, transparent 0% 50%) 50% / 18px
      18px;
    display: grid;
    place-items: start center;
    padding: var(--sp-4);
  }

  .editor__frame {
    width: 100%;
    max-width: 100%;
    height: 100%;
    transition: max-width 0.2s ease;
    box-shadow: var(--shadow-lg);
