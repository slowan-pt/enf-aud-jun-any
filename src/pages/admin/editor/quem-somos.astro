<script>
  interface SectionStyle {
    bg: string;
    text: string;
    image: string;
    overlay: string;
    minHeight: string;
    paddingY: string;
  }

  interface ElementLayout {
    /** 1 = sistema antigo (% do elemento); 2 = atual (cqw, % da seção). */
    v: number;
    x: number;
    y: number;
    w: number;
    h: number;
    z: number;
    fontSize: number;
    color: string;
    align: string;
    weight: number;
    /** Rotação em graus. */
    r: number;
    locked: boolean;
    /** Oculto no site; o conteúdo continua salvo. */
    hidden: boolean;
    /** Nome dado no painel de camadas. */
    label: string;
  }

  interface LayoutPair {
    desktop: ElementLayout;
    mobile: ElementLayout | null;
  }

  interface OverlayItem {
    id: string;
    section: string;
    kind: string;
    content: string;
    alt: string;
    text: string;
    fill: string;
    stroke: string;
    strokeWidth: number;
    href: string;
    linkTarget: string;
  }

  interface Bootstrap {
    sectionOrder: string[];
    hiddenSections: string[];
    layouts: Record<string, LayoutPair>;
    overlays: OverlayItem[];
    sectionStyles: Record<string, SectionStyle>;
    labels: Record<string, string>;
    keys: string[];
    icons: Record<string, string>;
  }

  type Op =
    | { op: 'set'; path: string; value: string }
    | { op: 'reorder'; path: string; from: number; to: number }
    | { op: 'duplicate' | 'remove'; path: string; index: number }
    | { op: 'sections'; order?: string[]; hidden?: string[] }
    | {
        op: 'layout';
        path: string;
        device: string;
        layout: ElementLayout | null;
        clear?: boolean;
      }
    | { op: 'overlay-add'; overlay: Record<string, unknown> }
    | {
        op: 'overlay-layout';
        id: string;
        device: string;
        layout: ElementLayout | null;
        clear?: boolean;
      }
    | { op: 'overlay-content'; id: string; content?: string; alt?: string }
    | { op: 'overlay-remove'; id: string }
    | {
        op: 'overlay-shape-style';
        id: string;
        text?: string;
        fill?: string;
        stroke?: string;
        strokeWidth?: number;
        href?: string;
        linkTarget?: string;
      }
    | {
        op: 'overlay-move-section';
        id: string;
        to: string;
        device: string;
        layout: ElementLayout | null;
      };

  interface Selection {
    path: string | null;
    overlay: string | null;
    key: string;
    kind: string;
    value: string;
    label: string;
    section: string;
    layout: ElementLayout;
    hasMobile: boolean;
  }

  const dataEl = document.getElementById('editor-bootstrap');
  if (!dataEl) throw new Error('bootstrap do editor ausente');
  const data = JSON.parse(dataEl.textContent || '{}') as Bootstrap;

  const frame = document.querySelector<HTMLElement>('[data-frame]')!;
  const preview = document.querySelector<HTMLIFrameElement>('[data-preview]')!;
  const statusEl = document.querySelector<HTMLElement>('[data-status]')!;
  const undoBtn = document.querySelector<HTMLButtonElement>('[data-undo]')!;
  const redoBtn = document.querySelector<HTMLButtonElement>('[data-redo]')!;

  let order = [...data.sectionOrder];
  let hidden = [...data.hiddenSections];
  const styles = data.sectionStyles;
  const layouts: Record<string, LayoutPair> = { ...data.layouts };
  let overlays: OverlayItem[] = [...data.overlays];
  let selection: Selection | null = null;
  let device = 'desktop';
  let migrationCount = 0;

  function emptyLayout(): ElementLayout {
    return {
      v: 2,
      x: 0,
      y: 0,
      w: 0,
      h: 0,
      z: 0,
      fontSize: 0,
      color: '',
      align: '',
      weight: 0,
      r: 0,
      locked: false,
      hidden: false,
      label: '',
    };
  }

  function layoutOf(key: string, forDevice: string): ElementLayout {
    const pair = layouts[key];
    if (!pair) return emptyLayout();
    return (forDevice === 'mobile' ? pair.mobile : pair.desktop) ?? emptyLayout();
  }

  /** Elemento existente e elemento livre gravam por operações diferentes. */
  function layoutOp(
    target: { overlay: string | null; path: string | null; device: string },
    layout: ElementLayout
  ): Op {
    return target.overlay
      ? { op: 'overlay-layout', id: target.overlay, device: target.device, layout }
      : { op: 'layout', path: target.path!, device: target.device, layout };
  }

  // ------------------------------------------------------------ estado
  const queue: Op[] = [];
  const undoStack: Op[][] = [];
  const redoStack: Op[][] = [];
  let saveTimer: number | undefined;

  function setStatus(state: 'idle' | 'dirty' | 'saving' | 'error', label: string) {
    statusEl.dataset.state = state;
    statusEl.textContent = label;
  }

  function refreshHistoryButtons() {
    undoBtn.disabled = undoStack.length === 0;
    redoBtn.disabled = redoStack.length === 0;
  }

  /** Envia a operação e agenda a gravação (o servidor aplica sobre o valor atual). */
  function push(operation: Op, inverse?: Op) {
    queue.push(operation);
    if (inverse) {
      undoStack.push([inverse]);
      redoStack.length = 0;
      if (undoStack.length > 60) undoStack.shift();
    }
    refreshHistoryButtons();
    setStatus('dirty', 'Alterações pendentes');
    window.clearTimeout(saveTimer);
    saveTimer = window.setTimeout(flush, 700);
  }

  async function flush() {
    if (queue.length === 0) return;
    const batch = queue.splice(0, queue.length);
    setStatus('saving', 'Salvando…');
    try {
      const response = await fetch('/admin/api/document-content', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ slug: 'quem-somos', ops: batch }),
      });
      if (!response.ok) throw new Error(String(response.status));
      setStatus('idle', 'Tudo salvo');
    } catch {
      // Devolve o lote para a fila: a próxima alteração tenta gravar de novo.
      queue.unshift(...batch);
      setStatus('error', 'Erro ao salvar — tentando de novo');
      window.clearTimeout(saveTimer);
      saveTimer = window.setTimeout(flush, 4000);
    }
  }

  window.addEventListener('beforeunload', (event) => {
    if (queue.length === 0) return;
    event.preventDefault();
    event.returnValue = '';
  });

  // ------------------------------------------------- ponte com o iframe
  function toFrame(message: Record<string, unknown>) {
    preview.contentWindow?.postMessage(message, window.location.origin);
  }

  /**
   * A Quem Somos não intercala seções fixas entre as editáveis (diferente da
   * Home, que precisa de "slots" para isso) — a posição na lista já É a
   * ordem visual.
   */
  function sendOrder() {
    const orderMap: Record<string, number> = {};
    order.forEach((key, index) => {
      orderMap[key] = index;
    });
    toFrame({ type: 'editor:section-order', orderMap });
  }

  /** Conteúdo de elemento existente e de elemento livre gravam diferente. */
  function contentOp(value: string): Op {
    if (selection?.overlay && selection.kind === 'shape') {
      // Em forma, `content` é a silhueta — o texto interno é outro campo. O
      // registro vai inteiro (fundo/borda não mudam aqui, mas precisam ir
      // junto para não serem apagados se este passo for desfeito/refeito).
      const item = currentOverlayItem();
      return {
        op: 'overlay-shape-style',
        id: selection.overlay,
        text: value,
        fill: item?.fill ?? '',
        stroke: item?.stroke ?? '',
        strokeWidth: item?.strokeWidth ?? 0,
        href: item?.href ?? '',
        linkTarget: item?.linkTarget ?? '_self',
      };
    }
    return selection?.overlay
      ? { op: 'overlay-content', id: selection.overlay, content: value }
      : { op: 'set', path: selection!.path!, value };
  }

  function applyValue(value: string, previous: string, kind: string) {
    if (!selection) return;
    const extra = kind === 'icon' ? { svgInner: data.icons[value] ?? '' } : undefined;
    toFrame({
      type: 'editor:set',
      path: selection.path,
      overlay: selection.overlay,
      value,
      extra,
    });
    push(contentOp(value), contentOp(previous));
  }

  window.addEventListener('message', (event) => {
    if (event.origin !== window.location.origin) return;
    const payload = event.data as { type?: string; element?: Selection };
    if (!payload || typeof payload.type !== 'string') return;

    if (payload.type === 'editor:ready') {
      toFrame({ type: 'editor:hidden-sections', hidden });
      toFrame({ type: 'editor:layouts', layouts });
      toFrame({ type: 'editor:device', device });
      return;
    }

    // Elemento movido ou redimensionado dentro da pré-visualização.
    if (payload.type === 'editor:layout') {
      const moved = event.data as {
        key: string;
        overlay: string | null;
        path: string | null;
        device: string;
        layout: ElementLayout;
        migration?: boolean;
      };
      const previous = layoutOf(moved.key, moved.device);
      layouts[moved.key] = layouts[moved.key] ?? { desktop: emptyLayout(), mobile: null };
      if (moved.device === 'mobile') layouts[moved.key].mobile = moved.layout;
      else layouts[moved.key].desktop = moved.layout;

      if (selection && selection.key === moved.key) {
        selection.layout = moved.layout;
        fillLayoutPanel(moved.layout);
      }

      // Conversão de posição antiga não é uma edição do usuário: grava, mas
      // não entra no desfazer (desfazê-la só devolveria o formato defeituoso).
      if (moved.migration) {
        push(layoutOp(moved, moved.layout));
        migrationCount += 1;
        setStatus('dirty', `Convertendo ${migrationCount} posição(ões) antiga(s)…`);
        return;
      }

      push(layoutOp(moved, moved.layout), layoutOp(moved, previous));
      return;
    }

    // Elemento livre foi solto numa seção diferente da que estava.
    if (payload.type === 'editor:overlay-move-section') {
      const moved = event.data as {
        id: string;
        from: string;
        to: string;
        device: string;
        layout: ElementLayout;
      };
      const item = overlays.find((entry) => entry.id === moved.id);
      if (!item) return;

      const previousSection = item.section;
      const previousLayout = layoutOf('overlay:' + moved.id, moved.device);
      item.section = moved.to;
      layouts['overlay:' + moved.id] = layouts['overlay:' + moved.id] ?? {
        desktop: emptyLayout(),
        mobile: null,
      };
      if (moved.device === 'mobile') layouts['overlay:' + moved.id].mobile = moved.layout;
      else layouts['overlay:' + moved.id].desktop = moved.layout;

      if (selection && selection.overlay === moved.id) {
        selection.section = moved.to;
        selection.layout = moved.layout;
        fillLayoutPanel(moved.layout);
      }

      // Desfazer devolve à seção de origem com a posição que tinha lá — não
      // basta reverter só a posição, senão o elemento voltaria mas na seção
      // errada.
      push(
        {
          op: 'overlay-move-section',
          id: moved.id,
          to: moved.to,
          device: moved.device,
          layout: moved.layout,
        },
        {
          op: 'overlay-move-section',
          id: moved.id,
          to: previousSection,
          device: moved.device,
          layout: previousLayout,
        }
      );
      renderOverlays();
      return;
    }

    // Clique numa área vazia do fundo de uma seção (não sobre um elemento):
    // seleciona a SEÇÃO, não um elemento — abre as propriedades de fundo,
    // altura e espaçamento daquela seção especificamente.
    if (payload.type === 'editor:select-section') {
      const info = event.data as { section: string };
      selection = null;
      showProps(null);
      focusSectionStyleRow(info.section);
      return;
    }

    if (payload.type === 'editor:select' && payload.element) {
      selection = payload.element;
      showProps(selection);
      openTool('props');
      return;
    }

    if (payload.type === 'editor:drop-resolved') {
      const drop = event.data as { kind: string; section: string; x: number; y: number };
      inserirElemento(
        drop.kind,
        drop.section,
        drop.x,
        drop.y,
        drop.kind === 'shape' ? pendingShapeType : undefined
      );
      return;
    }

    if (payload.type === 'editor:drop-missed') {
      addStatus.textContent = 'Solte sobre uma seção editável da página.';
      return;
    }

    if (payload.type === 'editor:inventory') {
      inventory = (event.data as { items: LayerItem[] }).items;
      renderLayers();
      return;
    }

    if (payload.type === 'editor:deselect') {
      selection = null;
      showProps(null);
      return;
    }

    // Item arrastado dentro da própria página: o runtime já moveu e renumerou,
    // aqui só registramos a operação para gravar.
    if (payload.type === 'editor:reorder') {
      const moved = event.data as { listPath: string; from: number; to: number };
      selection = null;
      showProps(null);
      push(
        { op: 'reorder', path: moved.listPath, from: moved.from, to: moved.to },
        { op: 'reorder', path: moved.listPath, from: moved.to, to: moved.from }
      );
      return;
    }

    if (payload.type === 'editor:change') {
      const change = event.data as {
        path: string | null;
        overlay: string | null;
        value: string;
      };
      if (!selection) return;
      const previous = selection.value;
      selection.value = change.value;
      if (selection.kind === 'shape') {
        const item = currentOverlayItem();
        if (item) item.text = change.value;
      }
      const textArea = document.querySelector<HTMLTextAreaElement>('#prop-text');
      if (textArea && document.activeElement !== textArea) textArea.value = change.value;
      push(contentOp(change.value), contentOp(previous));
    }
  });

  // ----------------------------------------------------- painéis/abas
  function openTool(tool: string) {
    document.querySelectorAll<HTMLElement>('[data-tool]').forEach((button) => {
      button.classList.toggle('is-active', button.dataset.tool === tool);
    });
    document.querySelectorAll<HTMLElement>('[data-pane]').forEach((pane) => {
      pane.classList.toggle('is-open', pane.dataset.pane === tool);
    });
  }

  document.querySelectorAll<HTMLElement>('[data-tool]').forEach((button) => {
    button.addEventListener('click', () => openTool(button.dataset.tool!));
  });

  // ------------------------------------------------ propriedades
  const propsEmpty = document.querySelector<HTMLElement>('[data-props-empty]')!;
  const propsForm = document.querySelector<HTMLElement>('[data-props-form]')!;
  const propsLabel = document.querySelector<HTMLElement>('[data-props-label]')!;
  const propsPath = document.querySelector<HTMLElement>('[data-props-path]')!;
  const textField = document.querySelector<HTMLElement>('[data-props-text]')!;
  const textArea = document.querySelector<HTMLTextAreaElement>('#prop-text')!;
  const mediaField = document.querySelector<HTMLElement>('[data-props-media]')!;
  const iconField = document.querySelector<HTMLElement>('[data-props-icon]')!;
  const itemField = document.querySelector<HTMLElement>('[data-props-item]')!;
  const shapeField = document.querySelector<HTMLElement>('[data-props-shape]')!;
  const layoutField = document.querySelector<HTMLElement>('[data-props-layout]')!;
  const layoutScope = document.querySelector<HTMLElement>('[data-layout-scope]')!;
  const colorSwatch = document.querySelector<HTMLInputElement>('[data-prop-color-swatch]')!;
  const lockBox = document.querySelector<HTMLInputElement>('[data-prop-lock]')!;

  /** Escreve os valores do layout selecionado nos campos, sem disparar eventos. */
  function fillLayoutPanel(layout: ElementLayout) {
    document.querySelectorAll<HTMLInputElement>('[data-prop]').forEach((input) => {
      const property = input.dataset.prop as keyof ElementLayout;
      input.value = String(layout[property] ?? '');
    });
    colorSwatch.value = layout.color || '#000000';
    lockBox.checked = layout.locked;
    hideBox.checked = layout.hidden;
    rotateRange.value = String(layout.r ?? 0);
    rotateReadout.textContent = `${layout.r ?? 0}°`;
    actionsHint.textContent = selection?.overlay
      ? 'Elemento livre: excluir remove de vez.'
      : 'Elemento da estrutura: duplicar cria uma cópia livre e excluir apenas oculta no site.';
    document.querySelectorAll<HTMLElement>('[data-align]').forEach((button) => {
      button.classList.toggle('is-active', button.dataset.align === layout.align);
    });
  }

  // ------------------------------------------------------- forma: propriedades
  const shapeFill = document.querySelector<HTMLInputElement>('[data-shape-fill]')!;
  const shapeStroke = document.querySelector<HTMLInputElement>('[data-shape-stroke]')!;
  const shapeStrokeWidth = document.querySelector<HTMLInputElement>(
    '[data-shape-stroke-width]'
  )!;
  const shapeLinkPage = document.querySelector<HTMLSelectElement>('[data-shape-link-page]')!;
  const shapeLinkExternal = document.querySelector<HTMLInputElement>(
    '[data-shape-link-external]'
  )!;
  const shapeLinkBlank = document.querySelector<HTMLInputElement>('[data-shape-link-blank]')!;

  function currentOverlayItem(): OverlayItem | null {
    if (!selection?.overlay) return null;
    return overlays.find((item) => item.id === selection!.overlay) ?? null;
  }

  function showShapeProps() {
    const item = currentOverlayItem();
    if (!item) return;

    shapeFill.value = /^#[0-9a-fA-F]{6}$/.test(item.fill) ? item.fill : '#12a794';
    shapeStroke.value = /^#[0-9a-fA-F]{6}$/.test(item.stroke) ? item.stroke : '#000000';
    shapeStrokeWidth.value = String(item.strokeWidth || 0);

    const known = ['/', '/quem-somos', '/servicos', '/conteudos', '/contato'];
    if (!item.href) {
      shapeLinkPage.value = '';
      shapeLinkExternal.hidden = true;
    } else if (known.includes(item.href)) {
      shapeLinkPage.value = item.href;
      shapeLinkExternal.hidden = true;
    } else {
      shapeLinkPage.value = '__external';
      shapeLinkExternal.hidden = false;
      shapeLinkExternal.value = item.href;
    }
    shapeLinkBlank.checked = item.linkTarget === '_blank';
  }

  /**
   * Manda o registro INTEIRO da forma para o iframe e para o histórico —
   * nunca um campo isolado. Um patch parcial, ao ser reaplicado num
   * desfazer/refazer, apagaria os campos que não vieram junto (fundo, borda,
   * texto), porque `applyShapeStyle` sempre redesenha a partir do que recebe.
   */
  function pushShapeStyle(patch: Partial<OverlayItem>) {
    const item = currentOverlayItem();
    if (!item) return;
    const previous = { ...item };
    Object.assign(item, patch);

    const full = {
      text: item.text,
      fill: item.fill,
      stroke: item.stroke,
      strokeWidth: item.strokeWidth,
      href: item.href,
      linkTarget: item.linkTarget,
    };
    const beforeFull = {
      text: previous.text,
      fill: previous.fill,
      stroke: previous.stroke,
      strokeWidth: previous.strokeWidth,
      href: previous.href,
      linkTarget: previous.linkTarget,
    };

    toFrame({ type: 'editor:shape-style', id: item.id, style: item });
    push(
      { op: 'overlay-shape-style', id: item.id, ...full },
      { op: 'overlay-shape-style', id: item.id, ...beforeFull }
    );
  }

  shapeFill.addEventListener('input', () => pushShapeStyle({ fill: shapeFill.value }));
  shapeStroke.addEventListener('input', () => pushShapeStyle({ stroke: shapeStroke.value }));
  shapeStrokeWidth.addEventListener('change', () =>
    pushShapeStyle({ strokeWidth: Number(shapeStrokeWidth.value) || 0 })
  );
  shapeLinkPage.addEventListener('change', () => {
    if (shapeLinkPage.value === '__external') {
      shapeLinkExternal.hidden = false;
      shapeLinkExternal.focus();
      return;
    }
    shapeLinkExternal.hidden = true;
    pushShapeStyle({ href: shapeLinkPage.value });
  });
  shapeLinkExternal.addEventListener('change', () =>
    pushShapeStyle({ href: shapeLinkExternal.value.trim() })
  );
  shapeLinkBlank.addEventListener('change', () =>
    pushShapeStyle({ linkTarget: shapeLinkBlank.checked ? '_blank' : '_self' })
  );

  /** Manda a mudança para a pré-visualização; ela devolve o layout já aplicado. */
  function setLayoutProp(property: keyof ElementLayout, value: string | number | boolean) {
    if (!selection) return;
    toFrame({ type: 'editor:layout-prop', property, value });
  }

  document.querySelectorAll<HTMLInputElement>('[data-prop]').forEach((input) => {
    input.addEventListener('change', () => {
      const property = input.dataset.prop as keyof ElementLayout;
      const numeric = ['fontSize', 'w', 'h', 'z', 'weight'].includes(property);
      setLayoutProp(property, numeric ? Number(input.value) : input.value);
      if (property === 'color') colorSwatch.value = input.value || '#000000';
    });
  });

  colorSwatch.addEventListener('input', () => {
    const hexField = document.querySelector<HTMLInputElement>('[data-prop="color"]')!;
    hexField.value = colorSwatch.value;
    setLayoutProp('color', colorSwatch.value);
  });

  document.querySelectorAll<HTMLElement>('[data-align]').forEach((button) => {
    button.addEventListener('click', () => setLayoutProp('align', button.dataset.align!));
  });

  document.querySelectorAll<HTMLElement>('[data-layer]').forEach((button) => {
    button.addEventListener('click', () => {
      if (!selection) return;
      const current = selection.layout.z;
      const next =
        button.dataset.layer === 'front' ? Math.min(99, current + 1) : Math.max(0, current - 1);
      setLayoutProp('z', next);
    });
  });

  lockBox.addEventListener('change', () => setLayoutProp('locked', lockBox.checked));

  const hideBox = document.querySelector<HTMLInputElement>('[data-prop-hide]')!;
  hideBox.addEventListener('change', () => setLayoutProp('hidden', hideBox.checked));

  const rotateRange = document.querySelector<HTMLInputElement>('[data-prop-rotate]')!;
  const rotateReadout = document.querySelector<HTMLElement>('[data-rotate-readout]')!;
  rotateRange.addEventListener('input', () => {
    rotateReadout.textContent = `${rotateRange.value}°`;
  });
  rotateRange.addEventListener('change', () => setLayoutProp('r', Number(rotateRange.value)));

  // ------------------------------------------- duplicar / excluir elemento
  const actionsHint = document.querySelector<HTMLElement>('[data-el-actions-hint]')!;

  /**
   * Duplicar um elemento existente não pode copiar a estrutura da página — ele
   * ocupa um lugar fixo no conteúdo. A cópia vira um elemento livre, com id
   * próprio e conteúdo independente, posicionado ao lado do original.
   */
  document.querySelector('[data-el-duplicate]')!.addEventListener('click', async () => {
    if (!selection) return;
    const origem = layoutOf(selection.key, device);
    const base = selection.overlay
      ? overlays.find((item) => item.id === selection!.overlay)
      : null;

    const copy = {
      id: newOverlayId(),
      section: selection.section,
      kind: base?.kind ?? kindToOverlay(selection.kind),
      content: base?.content ?? selection.value,
      alt: base?.alt ?? '',
      text: base?.text ?? '',
      fill: base?.fill ?? '',
      stroke: base?.stroke ?? '',
      strokeWidth: base?.strokeWidth ?? 0,
      href: base?.href ?? '',
      linkTarget: base?.linkTarget ?? '_self',
      desktop: { ...origem, x: origem.x + 4, y: origem.y + 4, hidden: false, locked: false },
      mobile: null,
    };

    overlays = [...overlays, copy as OverlayItem];
    push({ op: 'overlay-add', overlay: copy }, { op: 'overlay-remove', id: copy.id });
    renderOverlays();
    await reloadPreview();
  });

  /** O tipo do elemento existente vira o tipo equivalente de elemento livre. */
  function kindToOverlay(kind: string): string {
    if (kind === 'image' || kind === 'video' || kind === 'icon') return kind;
    return 'text';
  }

  document.querySelector('[data-el-delete]')!.addEventListener('click', async () => {
    if (!selection) return;

    // Elemento livre é removido de verdade; elemento existente é ocultado — ele
    // faz parte da estrutura da página e some do site, mas o conteúdo continua
    // gravado e pode voltar.
    if (selection.overlay) {
      if (
        !window.confirm('Excluir este elemento livre? A ação pode ser desfeita ao recarregar.')
      )
        return;
      const id = selection.overlay;
      overlays = overlays.filter((item) => item.id !== id);
      push({ op: 'overlay-remove', id });
      renderOverlays();
      await reloadPreview();
      return;
    }

    if (!window.confirm('Ocultar este elemento no site? O conteúdo continua salvo.')) return;
    hideBox.checked = true;
    setLayoutProp('hidden', true);
  });

  document.querySelector('[data-layout-reset]')!.addEventListener('click', () => {
    if (!selection) return;
    toFrame({ type: 'editor:layout-reset' });
  });

  function showProps(current: Selection | null) {
    propsEmpty.hidden = Boolean(current);
    propsForm.hidden = !current;
    if (!current) return;

    propsLabel.textContent = current.label || 'Elemento';
    propsPath.textContent = current.path;

    const isText =
      current.kind === 'text' || current.kind === 'multiline' || current.kind === 'shape';
    const isMedia = current.kind === 'image' || current.kind === 'video';

    textField.hidden = !isText;
    mediaField.hidden = !isMedia;
    iconField.hidden = current.kind !== 'icon';
    shapeField.hidden = current.kind !== 'shape';

    if (isText) textArea.value = current.value;
    if (isMedia) showMedia(current);
    if (current.kind === 'icon') showIcons(current.value);
    if (current.kind === 'shape') showShapeProps();

    const listInfo = current.path ? listOf(current.path) : null;
    itemField.hidden = !listInfo;

    layoutField.hidden = false;
    layoutScope.textContent =
      device === 'mobile'
        ? 'Editando a versão de celular. O desktop não muda.'
        : 'Editando a versão de computador.';
    fillLayoutPanel(current.layout);
  }

  /** `benefits.items.2.title` → lista `benefits.items`, índice 2. */
  function listOf(path: string): { path: string; index: number } | null {
    const parts = path.split('.');
    for (let i = parts.length - 1; i >= 0; i--) {
      if (/^\d+$/.test(parts[i]!)) {
        return { path: parts.slice(0, i).join('.'), index: Number(parts[i]) };
      }
    }
    return null;
  }

  textArea.addEventListener('input', () => {
    if (!selection) return;
    const previous = selection.value;
    const value = textArea.value;
    selection.value = value;
    toFrame({
      type: 'editor:set',
      path: selection.path,
      overlay: selection.overlay,
      value,
    });
    push(contentOp(value), contentOp(previous));
  });

  // ------------------------------------------------------ mídia
  const mediaPreview = document.querySelector<HTMLImageElement>('[data-media-preview]')!;
  const mediaVideo = document.querySelector<HTMLVideoElement>('[data-media-video]')!;
  const mediaEmpty = document.querySelector<HTMLElement>('[data-media-empty]')!;
  const mediaUrl = document.querySelector<HTMLInputElement>('[data-media-url]')!;
  const mediaFile = document.querySelector<HTMLInputElement>('[data-media-file]')!;
  const mediaStatus = document.querySelector<HTMLElement>('[data-media-status]')!;
  const mediaLabel = document.querySelector<HTMLElement>('[data-media-label]')!;
  const mediaBtnLabel = document.querySelector<HTMLElement>('[data-media-btn-label]')!;

  function showMedia(current: Selection) {
    const isVideo = current.kind === 'video';
    mediaLabel.textContent = isVideo ? 'Vídeo' : 'Imagem';
    mediaBtnLabel.textContent = isVideo ? 'Enviar vídeo' : 'Enviar imagem';
    mediaFile.accept = isVideo ? 'video/mp4,video/webm' : 'image/*';
    mediaUrl.value = current.value;
    mediaStatus.textContent = '';

    mediaPreview.hidden = isVideo || !current.value;
    mediaVideo.hidden = !isVideo || !current.value;
    mediaEmpty.hidden = Boolean(current.value);
    if (!isVideo && current.value) mediaPreview.src = current.value;
    if (isVideo && current.value) mediaVideo.src = current.value;
  }

  mediaUrl.addEventListener('change', () => {
    if (!selection) return;
    const previous = selection.value;
    selection.value = mediaUrl.value;
    applyValue(mediaUrl.value, previous, selection.kind);
    showMedia(selection);
  });

  mediaFile.addEventListener('change', async () => {
    const file = mediaFile.files?.[0];
    if (!file || !selection) return;
    mediaStatus.textContent = 'Enviando…';
    const body = new FormData();
    body.append('file', file);
    try {
      const response = await fetch('/admin/api/upload', { method: 'POST', body });
      const result = (await response.json()) as { url?: string; error?: string };
      if (!response.ok || !result.url) throw new Error(result.error || 'falha no envio');
      const previous = selection.value;
      selection.value = result.url;
      // A URL vem do servidor, então o caminho digitado nunca fica fora de sincronia.
      applyValue(result.url, previous, selection.kind);
      showMedia(selection);
      mediaStatus.textContent = 'Enviado.';
    } catch (error) {
      mediaStatus.textContent = `Erro: ${(error as Error).message}`;
    } finally {
      mediaFile.value = '';
    }
  });

  // ------------------------------------------------------ ícones
  const iconGrid = document.querySelector<HTMLElement>('[data-icon-grid]')!;
  const iconSearch = document.querySelector<HTMLInputElement>('[data-icon-search]')!;
  const iconFile = document.querySelector<HTMLInputElement>('[data-icon-file]')!;
  const iconStatus = document.querySelector<HTMLElement>('[data-icon-status]')!;
  const iconNames = Object.keys(data.icons).sort();

  function showIcons(activeName: string, filter = '') {
    const term = filter.trim().toLowerCase();
    const visible = term ? iconNames.filter((name) => name.includes(term)) : iconNames;
    iconGrid.replaceChildren();

    visible.slice(0, 180).forEach((name) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.title = name;
      button.className = name === activeName ? 'is-active' : '';

      const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
      svg.setAttribute('width', '20');
      svg.setAttribute('height', '20');
      svg.setAttribute('viewBox', '0 0 24 24');
      svg.setAttribute('fill', 'none');
      svg.setAttribute('stroke', 'currentColor');
      svg.setAttribute('stroke-width', '1.75');
      svg.setAttribute('stroke-linecap', 'round');
      svg.setAttribute('stroke-linejoin', 'round');
      svg.innerHTML = data.icons[name] ?? '';
      button.appendChild(svg);

      button.addEventListener('click', () => {
        if (!selection) return;
        const previous = selection.value;
        selection.value = name;
        applyValue(name, previous, 'icon');
        showIcons(name, iconSearch.value);
      });

      iconGrid.appendChild(button);
    });
  }

  iconSearch.addEventListener('input', () => {
    if (selection) showIcons(selection.value, iconSearch.value);
  });

  iconFile.addEventListener('change', async () => {
    const file = iconFile.files?.[0];
    if (!file || !selection) return;
    iconStatus.textContent = 'Enviando…';
    const body = new FormData();
    body.append('file', file);
    try {
      const response = await fetch('/admin/api/upload', { method: 'POST', body });
      const result = (await response.json()) as { url?: string; error?: string };
      if (!response.ok || !result.url) throw new Error(result.error || 'falha no envio');
      const previous = selection.value;
      selection.value = result.url;
      applyValue(result.url, previous, 'icon');
      iconStatus.textContent = 'Ícone aplicado.';
    } catch (error) {
      iconStatus.textContent = `Erro: ${(error as Error).message}`;
    } finally {
      iconFile.value = '';
    }
  });

  // ------------------------------------------------- itens de lista
  function moveItem(delta: number) {
    if (!selection) return;
    const info = selection.path ? listOf(selection.path) : null;
    if (!info) return;
    const to = info.index + delta;
    if (to < 0) return;
    toFrame({ type: 'editor:deselect' });
    push(
      { op: 'reorder', path: info.path, from: info.index, to },
      { op: 'reorder', path: info.path, from: to, to: info.index }
    );
    reloadPreview();
  }

  document.querySelector('[data-item-up]')!.addEventListener('click', () => moveItem(-1));
  document.querySelector('[data-item-down]')!.addEventListener('click', () => moveItem(1));

  document.querySelector('[data-item-duplicate]')!.addEventListener('click', () => {
    if (!selection) return;
    const info = selection.path ? listOf(selection.path) : null;
    if (!info) return;
    push({ op: 'duplicate', path: info.path, index: info.index });
    reloadPreview();
  });

  document.querySelector('[data-item-remove]')!.addEventListener('click', () => {
    if (!selection) return;
    const info = selection.path ? listOf(selection.path) : null;
    if (!info) return;
    if (!window.confirm('Excluir este item da lista?')) return;
    push({ op: 'remove', path: info.path, index: info.index });
    reloadPreview();
  });

  /** Operações que mudam índices exigem recarregar para renumerar `data-edit`. */
  async function reloadPreview() {
    window.clearTimeout(saveTimer);
    await flush();
    selection = null;
    showProps(null);
    preview.contentWindow?.location.reload();
  }

  // ------------------------------------------------- lista de seções
  const sectionList = document.querySelector<HTMLElement>('[data-section-list]')!;
  let dragKey: string | null = null;

  function renderSections() {
    sectionList.replaceChildren();

    order.forEach((key) => {
      const li = document.createElement('li');
      li.draggable = true;
      li.dataset.key = key;
      if (hidden.includes(key)) li.classList.add('is-off');

      const grip = document.createElement('span');
      grip.textContent = '⠿';
      grip.style.color = 'var(--text-faint)';
      li.appendChild(grip);

      const name = document.createElement('button');
      name.type = 'button';
      name.className = 'section-list__name';
      name.textContent = data.labels[key] ?? key;
      name.addEventListener('click', () =>
        toFrame({ type: 'editor:scroll-to-section', section: key })
      );
      li.appendChild(name);

      const toggle = document.createElement('button');
      toggle.type = 'button';
      toggle.className = 'section-list__toggle';
      toggle.title = hidden.includes(key) ? 'Mostrar seção' : 'Ocultar seção';
      toggle.textContent = hidden.includes(key) ? '🚫' : '👁';
      toggle.addEventListener('click', () => {
        const previous = [...hidden];
        hidden = hidden.includes(key) ? hidden.filter((k) => k !== key) : [...hidden, key];
        toFrame({ type: 'editor:hidden-sections', hidden });
        push({ op: 'sections', hidden }, { op: 'sections', hidden: previous });
        renderSections();
      });
      li.appendChild(toggle);

      li.addEventListener('dragstart', () => {
        dragKey = key;
        li.classList.add('is-dragging');
      });
      li.addEventListener('dragend', () => {
        dragKey = null;
        li.classList.remove('is-dragging');
        sectionList.querySelectorAll('li').forEach((n) => n.classList.remove('is-over'));
      });
      li.addEventListener('dragover', (event) => {
        event.preventDefault();
        li.classList.add('is-over');
      });
      li.addEventListener('dragleave', () => li.classList.remove('is-over'));
      li.addEventListener('drop', (event) => {
        event.preventDefault();
        li.classList.remove('is-over');
        if (!dragKey || dragKey === key) return;
        const previous = [...order];
        const next = order.filter((k) => k !== dragKey);
        next.splice(order.indexOf(key), 0, dragKey);
        order = next;
        sendOrder();
        push({ op: 'sections', order }, { op: 'sections', order: previous });
        renderSections();
      });

      sectionList.appendChild(li);
    });
  }

  renderSections();

  // ------------------------------------------------------ cores e fundos
  const colorList = document.querySelector<HTMLElement>('[data-color-list]')!;
  const HEX = /^#[0-9a-fA-F]{6}$/;

  /**
   * Espelha `sectionStyleAttr` (src/lib/pages.ts) para a pré-visualização
   * mostrar exatamente o que o servidor vai renderizar. Mudou lá, muda aqui.
   */
  function styleCss(style: SectionStyle): string {
    const parts: string[] = [];
    const bg = HEX.test(style.bg) ? style.bg : '';
    const image = /^(\/[\w\-./]*|https:\/\/[\w\-./?=&%]+)$/.test(style.image)
      ? style.image
      : '';
    const raw = Number(style.overlay);
    const overlay = Number.isFinite(raw) && raw > 0 && raw <= 100 ? Math.round(raw) / 100 : 0;

    if (image) {
      const layers: string[] = [];
      if (overlay > 0) {
        layers.push(`linear-gradient(rgba(0,0,0,${overlay}),rgba(0,0,0,${overlay}))`);
      }
      layers.push(`url("${image}")`);
      parts.push(`background-image:${layers.join(',')}`);
      parts.push('background-size:cover');
      parts.push('background-position:center');
      if (bg) parts.push(`background-color:${bg}`);
    } else if (bg) {
      parts.push(`background:${bg}`);
    }

    if (HEX.test(style.text)) parts.push(`color:${style.text}`);

    const minHeight = clampPx(style.minHeight, 0, 2000);
    if (minHeight > 0) parts.push(`min-height:${minHeight}px`);

    if (style.paddingY && Number.isFinite(Number(style.paddingY))) {
      parts.push(`padding-block:${clampPx(style.paddingY, 0, 300)}px`);
    }

    return parts.join(';');
  }

  function clampPx(value: string, min: number, max: number): number {
    const n = Number(value);
    if (!value || !Number.isFinite(n)) return 0;
    return Math.min(max, Math.max(min, Math.round(n)));
  }

  function styleOf(key: string): SectionStyle {
    return (
      styles[key] ?? { bg: '', text: '', image: '', overlay: '', minHeight: '', paddingY: '' }
    );
  }

  function commitStyle(key: string, property: keyof SectionStyle, value: string) {
    const previous = styleOf(key)[property];
    if (value === previous) return;
    styles[key] = { ...styleOf(key), [property]: value };
    toFrame({ type: 'editor:section-style', section: key, css: styleCss(styles[key]) });
    push(
      { op: 'set', path: `sectionStyles.${key}.${property}`, value },
      { op: 'set', path: `sectionStyles.${key}.${property}`, value: previous }
    );
  }

  function colorPair(key: string, property: 'bg' | 'text', label: string): HTMLElement {
    const pair = document.createElement('div');
    pair.className = 'color-pair';

    const caption = document.createElement('span');
    caption.textContent = label;
    pair.appendChild(caption);

    const swatch = document.createElement('input');
    swatch.type = 'color';
    swatch.value = styleOf(key)[property] || '#ffffff';
    pair.appendChild(swatch);

    const hex = document.createElement('input');
    hex.type = 'text';
    hex.value = styleOf(key)[property];
    hex.placeholder = 'herda';
    pair.appendChild(hex);

    const clear = document.createElement('button');
    clear.type = 'button';
    clear.className = 'color-clear';
    clear.title = 'Herdar o padrão do site';
    clear.textContent = '×';
    clear.addEventListener('click', () => {
      hex.value = '';
      swatch.value = '#ffffff';
      commitStyle(key, property, '');
    });
    pair.appendChild(clear);

    swatch.addEventListener('input', () => {
      hex.value = swatch.value;
      commitStyle(key, property, swatch.value);
    });
    hex.addEventListener('change', () => {
      const value = hex.value.trim();
      if (value && !HEX.test(value)) {
        hex.value = styleOf(key)[property];
        return;
      }
      if (value) swatch.value = value;
      commitStyle(key, property, value);
    });

    return pair;
  }

  function backgroundImageField(key: string): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'bg-field';

    const caption = document.createElement('span');
    caption.className = 'bg-field__caption';
    caption.textContent = 'Imagem de fundo';
    wrap.appendChild(caption);

    const thumb = document.createElement('div');
    thumb.className = 'bg-thumb';
    const paint = () => {
      const url = styleOf(key).image;
      thumb.style.backgroundImage = url ? `url("${url}")` : '';
      thumb.textContent = url ? '' : 'sem imagem';
    };
    paint();
    wrap.appendChild(thumb);

    const actions = document.createElement('div');
    actions.className = 'bg-field__actions';

    const upload = document.createElement('label');
    upload.className = 'btn btn--secondary btn--sm';
    upload.textContent = 'Enviar imagem';
    const file = document.createElement('input');
    file.type = 'file';
    file.accept = 'image/*';
    file.hidden = true;
    upload.appendChild(file);
    actions.appendChild(upload);

    const remove = document.createElement('button');
    remove.type = 'button';
    remove.className = 'ed-btn';
    remove.textContent = 'Remover';
    remove.addEventListener('click', () => {
      commitStyle(key, 'image', '');
      paint();
    });
    actions.appendChild(remove);
    wrap.appendChild(actions);

    file.addEventListener('change', async () => {
      const chosen = file.files?.[0];
      if (!chosen) return;
      upload.textContent = 'Enviando…';
      const body = new FormData();
      body.append('file', chosen);
      try {
        const response = await fetch('/admin/api/upload', { method: 'POST', body });
        const result = (await response.json()) as { url?: string; error?: string };
        if (!response.ok || !result.url) throw new Error(result.error || 'falha no envio');
        commitStyle(key, 'image', result.url);
        paint();
      } catch {
        window.alert('Não foi possível enviar a imagem.');
      } finally {
        upload.textContent = 'Enviar imagem';
        upload.appendChild(file);
        file.value = '';
      }
    });

    // Escurecimento: sem isto, texto claro some sobre foto clara.
    const overlayRow = document.createElement('div');
    overlayRow.className = 'color-pair';
    const overlayCaption = document.createElement('span');
    overlayCaption.textContent = 'Escurecer';
    overlayRow.appendChild(overlayCaption);

    const range = document.createElement('input');
    range.type = 'range';
    range.min = '0';
    range.max = '100';
    range.step = '5';
    range.value = styleOf(key).overlay || '0';
    const readout = document.createElement('span');
    readout.className = 'bg-field__readout';
    readout.textContent = `${range.value}%`;
    range.addEventListener('input', () => {
      readout.textContent = `${range.value}%`;
    });
    range.addEventListener('change', () => commitStyle(key, 'overlay', range.value));
    overlayRow.appendChild(range);
    overlayRow.appendChild(readout);
    wrap.appendChild(overlayRow);

    return wrap;
  }

  /**
   * Altura mínima, espaçamento interno e o botão de voltar ao automático.
   * Nunca usa `height` fixa com corte — só `min-height`: se o conteúdo for
   * mais alto, a seção cresce, e nada desaparece.
   */
  function dimensionsField(key: string): HTMLElement {
    const wrap = document.createElement('div');
    wrap.className = 'bg-field';

    const caption = document.createElement('span');
    caption.className = 'bg-field__caption';
    caption.textContent = 'Altura da seção';
    wrap.appendChild(caption);

    const row = document.createElement('div');
    row.className = 'color-pair';
    const label = document.createElement('span');
    label.textContent = 'Mínima';
    row.appendChild(label);

    const dec = document.createElement('button');
    dec.type = 'button';
    dec.className = 'ed-btn';
    dec.textContent = '−';
    dec.title = 'Diminuir 40px';
    row.appendChild(dec);

    const height = document.createElement('input');
    height.type = 'number';
    height.min = '0';
    height.max = '2000';
    height.step = '10';
    height.placeholder = 'auto';
    height.value = styleOf(key).minHeight;
    row.appendChild(height);

    const inc = document.createElement('button');
    inc.type = 'button';
    inc.className = 'ed-btn';
    inc.textContent = '+';
    inc.title = 'Aumentar 40px';
    row.appendChild(inc);

    const auto = document.createElement('button');
    auto.type = 'button';
    auto.className = 'ed-btn';
    auto.textContent = 'Auto';
    auto.title = 'Voltar à altura automática (a do conteúdo)';
    row.appendChild(auto);
    wrap.appendChild(row);

    const commitHeight = (value: string) => {
      height.value = value;
      commitStyle(key, 'minHeight', value);
    };
    height.addEventListener('change', () => {
      const n = Number(height.value);
      if (height.value && (!Number.isFinite(n) || n < 0)) {
        height.value = styleOf(key).minHeight;
        return;
      }
      commitHeight(height.value ? String(Math.min(2000, Math.round(n))) : '');
    });
    dec.addEventListener('click', () => {
      const current = Number(styleOf(key).minHeight) || 0;
      commitHeight(String(Math.max(0, current - 40)));
    });
    inc.addEventListener('click', () => {
      const current = Number(styleOf(key).minHeight) || 0;
      commitHeight(String(Math.min(2000, current + 40)));
    });
    auto.addEventListener('click', () => commitHeight(''));

    const padRow = document.createElement('div');
    padRow.className = 'color-pair';
    const padLabel = document.createElement('span');
    padLabel.textContent = 'Espaço';
    padRow.appendChild(padLabel);

    const padding = document.createElement('input');
    padding.type = 'number';
    padding.min = '0';
    padding.max = '300';
    padding.step = '8';
    padding.placeholder = 'padrão';
    padding.value = styleOf(key).paddingY;
    padding.title = 'Espaçamento interno vertical (topo e base)';
    padRow.appendChild(padding);
    padding.addEventListener('change', () => {
      const n = Number(padding.value);
      if (padding.value && (!Number.isFinite(n) || n < 0)) {
        padding.value = styleOf(key).paddingY;
        return;
      }
      commitStyle(key, 'paddingY', padding.value ? String(Math.min(300, Math.round(n))) : '');
    });

    const padReset = document.createElement('button');
    padReset.type = 'button';
    padReset.className = 'ed-btn';
    padReset.textContent = 'Herdar';
    padReset.title = 'Restaurar o espaçamento padrão do site';
    padReset.addEventListener('click', () => {
      padding.value = '';
      commitStyle(key, 'paddingY', '');
    });
    padRow.appendChild(padReset);
    wrap.appendChild(padRow);

    return wrap;
  }

  function renderColors() {
    colorList.replaceChildren();

    data.keys.forEach((key) => {
      const row = document.createElement('div');
      row.className = 'color-row';
      row.dataset.sectionRow = key;

      const title = document.createElement('p');
      title.className = 'color-row__title';
      title.textContent = data.labels[key] ?? key;
      row.appendChild(title);

      const fields = document.createElement('div');
      fields.className = 'color-row__fields';
      fields.appendChild(colorPair(key, 'bg', 'Fundo'));
      fields.appendChild(colorPair(key, 'text', 'Texto'));
      fields.appendChild(backgroundImageField(key));
      fields.appendChild(dimensionsField(key));
      row.appendChild(fields);

      colorList.appendChild(row);
    });
  }

  renderColors();

  // Link vindo do resumo em Aparência (#section=chave) — abre direto na
  // linha da seção em vez de deixar a pessoa procurar na lista.
  const hashSection = window.location.hash.match(/^#section=([a-zA-Z]+)$/)?.[1];
  if (hashSection) focusSectionStyleRow(hashSection);

  /** Abre a aba Cores e destaca a linha da seção clicada no fundo vazio. */
  function focusSectionStyleRow(key: string) {
    openTool('colors');
    const row = colorList.querySelector<HTMLElement>(`[data-section-row="${key}"]`);
    if (!row) return;
    row.scrollIntoView({ block: 'center', behavior: 'smooth' });
    row.classList.add('is-section-row-focused');
    window.setTimeout(() => row.classList.remove('is-section-row-focused'), 1600);
  }

  // ------------------------------------------------- desfazer/refazer
  function runHistory(from: Op[][], to: Op[][]) {
    const batch = from.pop();
    if (!batch) return;

    // Reordenar muda os índices dos caminhos, e mover entre seções muda a
    // seção em que o nó DOM vive — os dois casos são recarregados para voltar
    // a refletir exatamente o que foi gravado.
    const needsReload = batch.some(
      (operation) => operation.op === 'reorder' || operation.op === 'overlay-move-section'
    );

    batch.forEach((operation) => {
      // Cópia ANTES de qualquer mutação: o que muda para virar o inverso
      // (abaixo, só para 'layout'/'overlay-layout') é só para a pilha
      // oposta — o que foi de fato aplicado agora é o que precisa ser salvo.
      queue.push({ ...operation });
      if (operation.op === 'set') {
        const kind = operation.path.endsWith('.icon') ? 'icon' : 'text';
        const extra =
          kind === 'icon' ? { svgInner: data.icons[operation.value] ?? '' } : undefined;
        toFrame({ type: 'editor:set', path: operation.path, value: operation.value, extra });
      }
      if (operation.op === 'overlay-content' && typeof operation.content === 'string') {
        toFrame({
          type: 'editor:set',
          overlay: operation.id,
          value: operation.content,
        });
      }
      if (operation.op === 'overlay-shape-style') {
        toFrame({ type: 'editor:shape-style', id: operation.id, style: operation });
      }
      if (operation.op === 'sections') {
        if (operation.order) {
          order = operation.order;
          sendOrder();
          renderSections();
        }
        if (operation.hidden) {
          hidden = operation.hidden;
          toFrame({ type: 'editor:hidden-sections', hidden });
          renderSections();
        }
      }
      if (operation.op === 'overlay-move-section') {
        const item = overlays.find((entry) => entry.id === operation.id);
        if (item) item.section = operation.to;
        layouts['overlay:' + operation.id] = layouts['overlay:' + operation.id] ?? {
          desktop: emptyLayout(),
          mobile: null,
        };
        if (operation.device === 'mobile') {
          layouts['overlay:' + operation.id].mobile = operation.layout as ElementLayout;
        } else {
          layouts['overlay:' + operation.id].desktop = operation.layout as ElementLayout;
        }
      }
      // Desfazer/refazer mover, redimensionar ou girar (elemento existente ou
      // livre) — sem isto, o dado fica certo (o próximo reload mostraria a
      // posição desfeita), mas a pré-visualização ao vivo não muda nada, o
      // que parece um desfazer que "não fez nada".
      if (operation.op === 'layout' || operation.op === 'overlay-layout') {
        const key = operation.op === 'layout' ? operation.path : 'overlay:' + operation.id;
        layouts[key] = layouts[key] ?? { desktop: emptyLayout(), mobile: null };
        const previous = operation.device === 'mobile' ? layouts[key].mobile : layouts[key].desktop;

        if (operation.clear && operation.device === 'mobile') {
          layouts[key].mobile = null;
        } else if (operation.device === 'mobile') {
          layouts[key].mobile = operation.layout as ElementLayout;
        } else {
          layouts[key].desktop = operation.layout as ElementLayout;
        }
        toFrame({ type: 'editor:layouts', layouts });

        // O valor que esta operação acabou de substituir é exatamente o que
        // a pilha OPOSTA precisa (ver `to.push(batch)` no fim da função) —
        // sem isto, desfazer duas vezes ou refazer só reaplicava o mesmo
        // estado (a pilha de refazer recebia uma cópia do que já tinha sido
        // desfeito, em vez do estado seguinte).
        operation.layout = previous ?? emptyLayout();
        operation.clear = false;
      }
    });
    to.push(batch);
    refreshHistoryButtons();
    setStatus('dirty', 'Alterações pendentes');
    window.clearTimeout(saveTimer);
    if (needsReload) void reloadPreview();
    else saveTimer = window.setTimeout(flush, 700);
  }

  undoBtn.addEventListener('click', () => runHistory(undoStack, redoStack));
  redoBtn.addEventListener('click', () => runHistory(redoStack, undoStack));

  document.addEventListener('keydown', (event) => {
    const typing =
      document.activeElement instanceof HTMLTextAreaElement ||
      document.activeElement instanceof HTMLInputElement;
    if (typing) return;
    if (!(event.ctrlKey || event.metaKey)) return;
    if (event.key.toLowerCase() !== 'z') return;
    event.preventDefault();
    if (event.shiftKey) runHistory(redoStack, undoStack);
    else runHistory(undoStack, redoStack);
  });

  // ------------------------------------------------------ dispositivo
  document.querySelectorAll<HTMLElement>('[data-device]').forEach((button) => {
    button.addEventListener('click', () => {
      document
        .querySelectorAll<HTMLElement>('[data-device]')
        .forEach((other) => other.classList.toggle('is-active', other === button));
      frame.dataset.device = button.dataset.device!;

      // Celular tem configuração própria de posição/estilo; ao trocar de
      // largura o editor passa a gravar naquele conjunto.
      device = button.dataset.device === 'mobile' ? 'mobile' : 'desktop';
      toFrame({ type: 'editor:device', device });
      if (selection) {
        selection.layout = layoutOf(selection.key, device);
        showProps(selection);
      }
    });
  });

  // ------------------------------------------------- elementos livres
  const addSection = document.querySelector<HTMLSelectElement>('[data-add-section]')!;
  const addStatus = document.querySelector<HTMLElement>('[data-add-status]')!;
  const overlayList = document.querySelector<HTMLElement>('[data-overlay-list]')!;

  data.keys.forEach((key) => {
    const option = document.createElement('option');
    option.value = key;
    option.textContent = data.labels[key] ?? key;
    addSection.appendChild(option);
  });

  const DEFAULT_CONTENT: Record<string, string> = {
    text: 'Texto novo',
    image: '/images/hero-essencial.svg',
    video: '',
    icon: 'heart',
    shape: '',
  };

  const DEFAULT_WIDTH: Record<string, number> = {
    text: 30,
    image: 20,
    video: 30,
    icon: 8,
    shape: 15,
  };

  function newOverlayId(): string {
    return 'ov-' + Math.random().toString(36).slice(2, 10);
  }

  /** Cria um elemento livre na seção e posição indicadas. */
  function inserirElemento(
    kind: string,
    section: string,
    x: number,
    y: number,
    shapeType?: string
  ) {
    const content = kind === 'shape' ? (shapeType ?? 'rect') : (DEFAULT_CONTENT[kind] ?? '');
    const overlay = {
      id: newOverlayId(),
      section,
      kind,
      content,
      alt: '',
      text: kind === 'shape' ? 'Texto' : '',
      fill: '',
      stroke: '',
      strokeWidth: 0,
      href: '',
      linkTarget: '_self',
      desktop: { ...emptyLayout(), x, y, w: DEFAULT_WIDTH[kind] ?? 20 },
      mobile: null,
    };

    overlays = [...overlays, overlay as OverlayItem];
    push({ op: 'overlay-add', overlay }, { op: 'overlay-remove', id: overlay.id });
    addStatus.textContent = 'Elemento inserido.';
    renderOverlays();

    // Cria o nó ao vivo no iframe (sem recarregar): preserva a rolagem e a
    // seleção do que já estava sendo editado antes, e o novo elemento já
    // fica selecionado, com as propriedades abertas, pronto para mover.
    toFrame({
      type: 'editor:overlay-create',
      overlay: {
        ...overlay,
        svgInner: kind === 'icon' ? (data.icons[content] ?? '') : undefined,
      },
    });
  }

  // Clique insere no meio da parte visível da seção escolhida; arrastar
  // insere exatamente no ponto onde o cartão foi solto. Forma é diferente:
  // primeiro pergunta qual silhueta, só insere depois de escolhida.
  const shapePicker = document.querySelector<HTMLElement>('[data-shape-picker]')!;

  document.querySelectorAll<HTMLElement>('[data-add]').forEach((button) => {
    button.addEventListener('click', () => {
      if (button.dataset.add === 'shape') {
        shapePicker.hidden = false;
        return;
      }
      toFrame({
        type: 'editor:visible-insert-request',
        kind: button.dataset.add!,
        section: addSection.value,
      });
    });
  });

  document.querySelector('[data-shape-cancel]')!.addEventListener('click', () => {
    shapePicker.hidden = true;
  });

  document.querySelectorAll<HTMLElement>('[data-shape]').forEach((button) => {
    button.addEventListener('click', () => {
      shapePicker.hidden = true;
      pendingShapeType = button.dataset.shape!;
      toFrame({
        type: 'editor:visible-insert-request',
        kind: 'shape',
        section: addSection.value,
      });
    });
  });
  let pendingShapeType = 'rect';

  function renderOverlays() {
    overlayList.replaceChildren();

    if (overlays.length === 0) {
      const empty = document.createElement('li');
      empty.className = 'overlay-list__empty';
      empty.textContent = 'Nenhum elemento livre ainda.';
      overlayList.appendChild(empty);
      return;
    }

    overlays.forEach((overlay) => {
      const li = document.createElement('li');

      const name = document.createElement('button');
      name.type = 'button';
      name.className = 'section-list__name';
      const label =
        overlay.kind === 'text' ? overlay.content : overlay.content.split('/').pop();
      name.textContent = `${overlay.kind} · ${label}`;
      name.addEventListener('click', () =>
        toFrame({ type: 'editor:select-overlay', id: overlay.id })
      );
      li.appendChild(name);

      const duplicate = document.createElement('button');
      duplicate.type = 'button';
      duplicate.className = 'section-list__toggle';
      duplicate.title = 'Duplicar';
      duplicate.textContent = '⧉';
      duplicate.addEventListener('click', async () => {
        const copy = {
          ...overlay,
          id: newOverlayId(),
          desktop: { ...layoutOf('overlay:' + overlay.id, 'desktop') },
        };
        copy.desktop.x += 4;
        copy.desktop.y += 4;
        overlays = [...overlays, copy];
        push({ op: 'overlay-add', overlay: copy }, { op: 'overlay-remove', id: copy.id });
        renderOverlays();
        await reloadPreview();
      });
      li.appendChild(duplicate);

      const remove = document.createElement('button');
      remove.type = 'button';
      remove.className = 'section-list__toggle';
      remove.title = 'Excluir';
      remove.textContent = '✕';
      remove.addEventListener('click', async () => {
        if (!window.confirm('Excluir este elemento?')) return;
        overlays = overlays.filter((item) => item.id !== overlay.id);
        push({ op: 'overlay-remove', id: overlay.id });
        renderOverlays();
        await reloadPreview();
      });
      li.appendChild(remove);

      overlayList.appendChild(li);
    });
  }

  renderOverlays();

  // --------------------------------------------------- painel de camadas
  interface LayerItem {
    key: string;
    section: string;
    kind: string;
    overlay: string | null;
    path: string | null;
    label: string;
    text: string;
    locked: boolean;
    hidden: boolean;
    z: number;
  }

  let inventory: LayerItem[] = [];
  const layerSection = document.querySelector<HTMLSelectElement>('[data-layer-section]')!;
  const layerList = document.querySelector<HTMLElement>('[data-layer-list]')!;
  let layerDrag: string | null = null;

  data.keys.forEach((key) => {
    const option = document.createElement('option');
    option.value = key;
    option.textContent = data.labels[key] ?? key;
    layerSection.appendChild(option);
  });
  layerSection.addEventListener('change', renderLayers);

  function setLayerProp(item: LayerItem, property: keyof ElementLayout, value: unknown) {
    const previous = layoutOf(item.key, device);
    const next = { ...previous, [property]: value } as ElementLayout;
    layouts[item.key] = layouts[item.key] ?? { desktop: emptyLayout(), mobile: null };
    if (device === 'mobile') layouts[item.key].mobile = next;
    else layouts[item.key].desktop = next;

    const target = { overlay: item.overlay, path: item.path, device };
    push(layoutOp(target, next), layoutOp(target, previous));
    toFrame({ type: 'editor:layouts', layouts });
    toFrame({ type: 'editor:inventory-request' });
  }

  function renderLayers() {
    const section = layerSection.value;
    const mine = inventory.filter((item) => item.section === section).sort((a, b) => b.z - a.z);

    layerList.replaceChildren();

    if (mine.length === 0) {
      const empty = document.createElement('li');
      empty.className = 'overlay-list__empty';
      empty.textContent = 'Nada nesta seção.';
      layerList.appendChild(empty);
      return;
    }

    mine.forEach((item) => {
      const li = document.createElement('li');
      li.draggable = true;
      li.dataset.key = item.key;
      if (item.hidden) li.classList.add('is-off');

      const grip = document.createElement('span');
      grip.textContent = '\u283F';
      grip.style.color = 'var(--text-faint)';
      li.appendChild(grip);

      const name = document.createElement('button');
      name.type = 'button';
      name.className = 'section-list__name';
      name.title = item.text || item.key;
      name.textContent = item.label;
      name.addEventListener('click', () =>
        toFrame({ type: 'editor:select-key', key: item.key })
      );
      li.appendChild(name);

      const rename = document.createElement('button');
      rename.type = 'button';
      rename.className = 'section-list__toggle';
      rename.title = 'Renomear camada';
      rename.textContent = '\u270E';
      rename.addEventListener('click', () => {
        const novo = window.prompt('Nome da camada:', item.label);
        if (novo === null) return;
        setLayerProp(item, 'label', novo.slice(0, 60));
      });
      li.appendChild(rename);

      const lock = document.createElement('button');
      lock.type = 'button';
      lock.className = 'section-list__toggle';
      lock.title = item.locked ? 'Destravar' : 'Travar';
      lock.textContent = item.locked ? '\u{1F512}' : '\u{1F513}';
      lock.addEventListener('click', () => setLayerProp(item, 'locked', !item.locked));
      li.appendChild(lock);

      const eye = document.createElement('button');
      eye.type = 'button';
      eye.className = 'section-list__toggle';
      eye.title = item.hidden ? 'Mostrar no site' : 'Ocultar no site';
      eye.textContent = item.hidden ? '\u{1F6AB}' : '\u{1F441}';
      eye.addEventListener('click', () => setLayerProp(item, 'hidden', !item.hidden));
      li.appendChild(eye);

      li.addEventListener('dragstart', () => {
        layerDrag = item.key;
        li.classList.add('is-dragging');
      });
      li.addEventListener('dragend', () => {
        layerDrag = null;
        li.classList.remove('is-dragging');
      });
      li.addEventListener('dragover', (event) => event.preventDefault());
      li.addEventListener('drop', (event) => {
        event.preventDefault();
        if (!layerDrag || layerDrag === item.key) return;
        // A lista vai da camada mais alta para a mais baixa; soltar sobre um
        // item significa passar a ficar acima dele.
        const arrastado = inventory.find((n) => n.key === layerDrag);
        if (!arrastado) return;
        setLayerProp(arrastado, 'z', Math.max(0, Math.min(99, item.z + 1)));
      });

      layerList.appendChild(li);
    });
  }

  // --------------------------------------- inserir arrastando na página
  let dragKind: string | null = null;

  document.querySelectorAll<HTMLElement>('[data-add]').forEach((card) => {
    card.addEventListener('dragstart', (event) => {
      dragKind = card.dataset.add!;
      (event as DragEvent).dataTransfer?.setData('text/plain', dragKind);
    });
    card.addEventListener('dragend', () => {
      dragKind = null;
    });
  });

  // O iframe não recebe o drop vindo de fora, então a soltura é capturada na
  // moldura e o runtime converte o ponto em coordenada da seção.
  const canvas = document.querySelector<HTMLElement>('.editor__canvas')!;
  canvas.addEventListener('dragover', (event) => {
    if (dragKind) event.preventDefault();
  });
  canvas.addEventListener('drop', (event) => {
    if (!dragKind) return;
    event.preventDefault();
    const box = preview.getBoundingClientRect();
    toFrame({
      type: 'editor:drop-point',
      kind: dragKind,
      clientX: event.clientX - box.left,
      clientY: event.clientY - box.top,
    });
    dragKind = null;
  });

  document
    .querySelector('[data-goto-colors]')
    ?.addEventListener('click', () => openTool('colors'));
</script>
