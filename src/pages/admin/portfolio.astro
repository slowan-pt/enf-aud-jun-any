---
import AdminLayout from '../../layouts/AdminLayout.astro';
import Icon from '../../components/Icon.astro';
import { getDB, writeAuditLog } from '../../lib/db';
import { listPortfolioRequests, type PortfolioStatus } from '../../lib/portfolio';
import { approveAndSend, downloadUrl, refuse } from '../../lib/portfolio-flow';
import { updateSetting } from '../../lib/settings';
import { normalizePortfolioHero } from '../../lib/portfolio-files';

const db = getDB();
const { company, portfolio: files } = Astro.locals.settings;
let hero = Astro.locals.settings.portfolioHero;

const labels: Record<PortfolioStatus, string> = {
  pendente: 'Pendente',
  aprovado: 'Aprovado',
  recusado: 'Recusado',
};
const tone: Record<PortfolioStatus, string> = {
  pendente: 'badge--warning',
  aprovado: 'badge--success',
  recusado: 'badge--neutral',
};

let notice: { ok: boolean; text: string } | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = Number(form.get('id'));
  const action = String(form.get('action') ?? '');
  if (form.get('_form') === 'hero') {
    hero = normalizePortfolioHero({
      eyebrow: form.get('hero_eyebrow'),
      title: form.get('hero_title'),
      lead: form.get('hero_lead'),
    });
    await updateSetting(db, 'portfolioHero', hero, Astro.locals.user?.id);
    await writeAuditLog(db, {
      userId: Astro.locals.user?.id,
      userName: Astro.locals.user?.name ?? '',
      action: 'settings.update',
      target: 'Portfólio: texto do topo da página',
      ip: Astro.request.headers.get('cf-connecting-ip') ?? '',
    });
    notice = { ok: true, text: 'Texto do topo salvo. Já vale para o site.' };
  } else if (Number.isInteger(id) && id > 0) {
    let logged = '';
    if (action === 'aprovar') {
      const result = await approveAndSend(db, id, company.name, company.email);
      logged = 'aprovado';
      notice = result.mail.ok
        ? { ok: true, text: `Aprovado. Link enviado para ${result.request?.email}.` }
        : {
            ok: false,
            text: `Aprovado, mas o e-mail não saiu (${result.mail.error ?? 'erro'}). Copie o link da tabela e envie manualmente.`,
          };
    } else if (action === 'recusar') {
      await refuse(db, id);
      logged = 'recusado';
      notice = { ok: true, text: 'Pedido recusado / acesso revogado.' };
    }
    if (logged) {
      await writeAuditLog(db, {
        userId: Astro.locals.user?.id,
        userName: Astro.locals.user?.name ?? '',
        action: 'portfolio.decision',
        target: `Pedido de Portfólio #${id} ${logged}`,
        ip: Astro.request.headers.get('cf-connecting-ip') ?? '',
      });
    }
  }
}

const requests = await listPortfolioRequests(db);

function formatDate(iso: string | null): string {
  if (!iso) return '—';
  const [datePart, timePart] = iso.split(' ');
  const [y, m, d] = (datePart ?? '').split('-');
  return `${d}/${m}/${y} ${(timePart ?? '').slice(0, 5)}`;
}
---

<AdminLayout
  title="Portfólio"
  description="Pedidos de download do Portfólio (PDF). Aprove para enviar o link ao e-mail do solicitante."
  active="/admin/portfolio"
>
  <div slot="actions">
    <a href="/portfolio" target="_blank" rel="noopener" class="btn btn--secondary btn--sm">
      <Icon name="eye" size={16} /> Ver a página
    </a>
  </div>

  {
    notice && (
      <div
        class:list={['form-alert', notice.ok ? 'form-alert--success' : 'form-alert--error']}
        role="status"
        style="margin-bottom: var(--sp-5)"
      >
        <Icon name={notice.ok ? 'check-circle' : 'alert-circle'} size={18} />
        <span>{notice.text}</span>
      </div>
    )
  }

  <section class="panel file-panel">
    <div class="panel__head">
      <h2 class="panel__title">Texto do topo da página Portfólio</h2>
      <a href="/portfolio" target="_blank" rel="noopener" class="small">Ver a página</a>
    </div>
    <form method="post" class="panel__body file-panel__body">
      <input type="hidden" name="_form" value="hero" />
      <div class="field">
        <label class="label" for="hero_eyebrow">Etiqueta (letras pequenas acima do título)</label>
        <input class="input" id="hero_eyebrow" name="hero_eyebrow" value={hero.eyebrow} maxlength="80" />
      </div>
      <div class="field">
        <label class="label" for="hero_title">Título</label>
        <input class="input" id="hero_title" name="hero_title" value={hero.title} maxlength="120" />
      </div>
      <div class="field">
        <label class="label" for="hero_lead">Mensagem (texto abaixo do título)</label>
        <textarea class="textarea" id="hero_lead" name="hero_lead" rows="3" maxlength="400">{hero.lead}</textarea>
      </div>
      <div>
        <button type="submit" class="btn btn--sm"><Icon name="save" size={16} /> Salvar texto</button>
      </div>
    </form>
  </section>

  <section class="panel file-panel" data-file-panel>
    <div class="panel__head">
      <h2 class="panel__title">Arquivo do Portfólio</h2>
    </div>
    <div class="panel__body file-panel__body">
      <p class="small" style="margin: 0; text-align: left">
        {
          files.version
            ? `No ar agora: PDF enviado pelo painel (${files.pageCount} páginas).`
            : `No ar agora: o portfólio original do site (${files.pageCount} páginas).`
        }
        Envie um PDF novo e o site monta a revista sozinho, com o mesmo visual e o mesmo zoom. O
        PDF para download também passa a ser este.
      </p>
      <div class="file-panel__row">
        <label class="btn btn--sm file-panel__pick">
          <Icon name="upload" size={16} /> Enviar PDF novo
          <input type="file" accept="application/pdf" hidden data-pdf-input />
        </label>
        {
          files.version && (
            <button type="button" class="btn btn--ghost btn--sm" data-restore>
              Voltar ao portfólio original
            </button>
          )
        }
      </div>
      <progress class="file-panel__bar" value="0" max="100" hidden data-progress></progress>
      <p class="small file-panel__status" data-pdf-status role="status"></p>
      <span class="muted small">
        PDF de até 40 MB e 60 páginas. A conversão acontece no seu navegador (use Chrome ou Edge) e
        o site só muda quando tudo termina com sucesso.
      </span>
    </div>
  </section>

  <section class="panel">
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th>Pedido</th>
            <th>Solicitante</th>
            <th>Status</th>
            <th>Link / downloads</th>
            <th class="text-right">Ações</th>
          </tr>
        </thead>
        <tbody>
          {
            requests.length === 0 && (
              <tr>
                <td colspan="5">Nenhum pedido ainda.</td>
              </tr>
            )
          }
          {
            requests.map((r) => (
              <tr>
                <td class="nowrap muted small">{formatDate(r.created_at)}</td>
                <td>
                  <strong>{r.name}</strong>
                  <span class="table__sub">{r.role}{r.role && r.company ? ' — ' : ''}{r.company}</span>
                  <a class="small" href={`mailto:${r.email}`}>{r.email}</a>
                  <span class="table__sub">{r.phone}</span>
                </td>
                <td>
                  <span class:list={['badge', tone[r.status]]}>{labels[r.status]}</span>
                  {r.status === 'aprovado' && !r.mail_sent && (
                    <span class="table__sub">e-mail não enviado</span>
                  )}
                </td>
                <td class="small">
                  {r.status === 'aprovado' && r.download_token ? (
                    <>
                      <input
                        class="input input--sm"
                        readonly
                        value={downloadUrl(r.download_token)}
                        onclick="this.select()"
                        aria-label="Link de download"
                      />
                      <span class="table__sub">
                        válido até {formatDate(r.download_expires)} UTC · {r.downloads} download(s)
                      </span>
                    </>
                  ) : (
                    '—'
                  )}
                </td>
                <td>
                  <form method="post" class="actions">
                    <input type="hidden" name="id" value={r.id} />
                    {r.status !== 'aprovado' && (
                      <button type="submit" name="action" value="aprovar" class="btn btn--accent btn--sm">
                        <Icon name="check" size={16} /> Aprovar e enviar
                      </button>
                    )}
                    {r.status === 'aprovado' && (
                      <button type="submit" name="action" value="aprovar" class="btn btn--secondary btn--sm">
                        Novo link
                      </button>
                    )}
                    {r.status !== 'recusado' && (
                      <button type="submit" name="action" value="recusar" class="btn btn--ghost btn--sm">
                        {r.status === 'aprovado' ? 'Revogar' : 'Recusar'}
                      </button>
                    )}
                  </form>
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
    <div class="panel__foot">
      <span class="muted small">
        Ao aprovar, o solicitante recebe um e-mail com um link que vale 7 dias. Recusar ou revogar
        derruba o link na hora.
      </span>
    </div>
  </section>
</AdminLayout>

<style>
  .text-right {
    text-align: right !important;
  }

  .nowrap {
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: var(--sp-2);
  }

  .file-panel {
    margin-bottom: var(--sp-5);
  }

  .file-panel__body {
    display: grid;
    gap: var(--sp-3);
  }

  .file-panel__row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
    align-items: center;
  }

  .file-panel__pick {
    cursor: pointer;
  }

  .file-panel__bar {
    width: 100%;
    max-width: 420px;
  }

  .file-panel__status {
    margin: 0;
    text-align: left;
    min-height: 1.2em;
  }
</style>

<script is:inline type="module">
  const input = document.querySelector('[data-pdf-input]');
  const status = document.querySelector('[data-pdf-status]');
  const bar = document.querySelector('[data-progress]');
  const restore = document.querySelector('[data-restore]');
  const panel = document.querySelector('[data-file-panel]');
  let busy = false;

  const say = (text, error) => {
    status.textContent = text;
    status.style.color = error ? '#b42318' : '';
  };
  const progress = (value) => {
    bar.hidden = value == null;
    if (value != null) bar.value = value;
  };

  async function post(url, body, json) {
    const res = await fetch(url, {
      method: 'POST',
      body: json ? JSON.stringify(body) : body,
      headers: json ? { 'Content-Type': 'application/json' } : undefined,
    });
    const data = await res.json().catch(() => ({}));
    if (!res.ok) throw new Error(data.error || 'Falha ao enviar (' + res.status + ').');
    return data;
  }

  const toWebp = (canvas, quality) =>
    new Promise((resolve, reject) =>
      canvas.toBlob(
        (blob) =>
          blob && blob.type === 'image/webp'
            ? resolve(blob)
            : reject(new Error('Este navegador não gera imagens WebP. Use Chrome ou Edge.')),
        'image/webp',
        quality
      )
    );

  async function convertAndSend(file) {
    if (file.size > 40 * 1024 * 1024) throw new Error('O PDF passa de 40 MB.');
    say('Carregando o conversor…');
    // O conversor usa requestAnimationFrame, que o navegador pausa em aba escondida:
    // com isto a conversão segue mesmo se você trocar de aba.
    window.requestAnimationFrame = (cb) => setTimeout(() => cb(performance.now()), 16);
    const pdfjs = await import('/vendor/pdf.min.mjs');
    pdfjs.GlobalWorkerOptions.workerSrc = '/vendor/pdf.worker.min.mjs';

    const doc = await pdfjs.getDocument({ data: await file.arrayBuffer() }).promise;
    const count = doc.numPages;
    if (count > 60) throw new Error('O PDF tem ' + count + ' páginas (o máximo é 60).');

    const first = (await doc.getPage(1)).getViewport({ scale: 1 });
    const ratio = first.width / first.height;
    const version = Date.now().toString(36) + Math.random().toString(36).slice(2, 6);
    const total = count * 2 + 2;
    let done = 0;
    const step = (text) => {
      done += 1;
      progress(Math.round((done / total) * 100));
      say(text);
    };

    const canvas = document.createElement('canvas');
    const ctx = canvas.getContext('2d');
    for (let n = 1; n <= count; n++) {
      const page = await doc.getPage(n);
      const base = page.getViewport({ scale: 1 });
      for (const [prefix, width, quality] of [['pagina', 1800, 0.84], ['zoom', 2800, 0.88]]) {
        const viewport = page.getViewport({ scale: width / base.width });
        canvas.width = Math.round(viewport.width);
        canvas.height = Math.round(viewport.height);
        await page.render({ canvasContext: ctx, viewport, background: '#ffffff' }).promise;
        const blob = await toWebp(canvas, quality);
        const body = new FormData();
        body.append('version', version);
        body.append('name', prefix + '-' + n + '.webp');
        body.append('file', blob, prefix + '-' + n + '.webp');
        await post('/admin/api/portfolio-arquivo', body);
        step('Página ' + n + ' de ' + count + (prefix === 'zoom' ? ' (alta resolução)' : '') + '…');
      }
      page.cleanup();
    }

    const pdfBody = new FormData();
    pdfBody.append('version', version);
    pdfBody.append('name', 'portfolio.pdf');
    pdfBody.append('file', file, 'portfolio.pdf');
    await post('/admin/api/portfolio-arquivo', pdfBody);
    step('Enviando o PDF para download…');

    await post('/admin/api/portfolio-publicar', { version, pageCount: count, ratio }, true);
    step('Publicando…');
    progress(100);
    say('Pronto! O novo Portfólio já está no ar. Atualizando a página…');
    setTimeout(() => location.reload(), 1200);
  }

  input?.addEventListener('change', async () => {
    const file = input.files && input.files[0];
    input.value = '';
    if (!file || busy) return;
    if (!/\.pdf$/i.test(file.name) && file.type !== 'application/pdf') {
      say('Escolha um arquivo PDF.', true);
      return;
    }
    busy = true;
    panel.style.opacity = '0.85';
    try {
      await convertAndSend(file);
    } catch (error) {
      progress(null);
      say('Nada mudou no site. ' + ((error && error.message) || 'Não foi possível converter o PDF.'), true);
      busy = false;
      panel.style.opacity = '';
    }
  });

  restore?.addEventListener('click', async () => {
    if (busy || !confirm('Voltar ao portfólio original do site?')) return;
    busy = true;
    try {
      await post('/admin/api/portfolio-publicar', { restore: true }, true);
      location.reload();
    } catch (error) {
      say(error.message, true);
      busy = false;
    }
  });
</script>
