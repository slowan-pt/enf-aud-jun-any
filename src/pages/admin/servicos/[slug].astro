---
import AdminLayout from '../../../layouts/AdminLayout.astro';
import Icon from '../../../components/Icon.astro';
import IconPicker from '../../../components/admin/IconPicker.astro';
import ImageUploadField from '../../../components/admin/ImageUploadField.astro';
import { getDB, writeAuditLog } from '../../../lib/db';
import { findBySlug, updateService, slugExists, type Service } from '../../../lib/services';
import { slugify } from '../../../lib/urls';
import { generateItemId } from '../../../lib/service-item-ids';
import { MAX_HIGHLIGHTS, DEFAULT_ASIDE, type ServiceAside } from '../../../lib/service-template';
import { iconPaths } from '../../../data/icons';
import type { ServiceBlock, ServiceHighlight } from '../../../lib/services';

const iconNames = Object.keys(iconPaths).sort();
import { createRedirect } from '../../../lib/redirects';


/** Lê os cards do formulário. Linhas vazias somem; no máximo 4; o id de quem já existia é mantido. */
function readHighlights(form: FormData): ServiceHighlight[] {
  const ids = form.getAll('hl_id').map(String);
  const icons = form.getAll('hl_icon').map(String);
  const titles = form.getAll('hl_title').map(String);
  const texts = form.getAll('hl_text').map(String);
  const out: ServiceHighlight[] = [];
  titles.forEach((title, index) => {
    const t = title.trim();
    const body = (texts[index] ?? '').trim();
    if (!t && !body) return;
    out.push({
      id: ids[index]?.trim() || generateItemId(),
      icon: icons[index] || 'check-circle',
      title: t,
      text: body,
    });
  });
  return out.slice(0, MAX_HIGHLIGHTS);
}

/** Lê os blocos: título, texto opcional e lista opcional (um item por linha). */
function readBlocks(form: FormData): ServiceBlock[] {
  const ids = form.getAll('bl_id').map(String);
  const titles = form.getAll('bl_title').map(String);
  const texts = form.getAll('bl_text').map(String);
  const lists = form.getAll('bl_items').map(String);
  const out: ServiceBlock[] = [];
  titles.forEach((title, index) => {
    const t = title.trim();
    const body = (texts[index] ?? '').trim();
    const items = (lists[index] ?? '')
      .split('\n')
      .map((line) => line.trim())
      .filter(Boolean);
    if (!t && !body && !items.length) return;
    const block: ServiceBlock = { id: ids[index]?.trim() || generateItemId(), title: t };
    if (body) block.text = body;
    if (items.length) block.items = items;
    out.push(block);
  });
  return out;
}

const slug = Astro.params.slug ?? '';
const db = getDB();

let slugError = '';

if (Astro.request.method === 'POST') {
  const existing = findBySlug(Astro.locals.services, slug);
  if (existing) {
    const form = await Astro.request.formData();
    const text = (key: string, fallback: string) => String(form.get(key) ?? fallback);
    const lines = (key: string, fallback: string[]) =>
      String(form.get(key) ?? fallback.join('\n'))
        .split('\n')
        .map((l) => l.trim())
        .filter(Boolean);

    const requestedSlug = slugify(text('slug', existing.slug)) || existing.slug;
    if (requestedSlug !== existing.slug && (await slugExists(db, requestedSlug))) {
      slugError = 'Já existe um serviço com esse slug.';
    } else {
      await updateService(
        db,
        slug,
        {
          slug: requestedSlug,
          name: text('nome', existing.name),
          icon: text('icone', existing.icon),
          shortName: text('nome_curto', existing.shortName),
          summary: text('resumo', existing.summary),
          heroTitle: text('hero_titulo', existing.heroTitle),
          heroLead: text('hero_lead', existing.heroLead),
          image: text('imagem', existing.image),
          imageAlt: text('alt', existing.imageAlt),
          whatsappMessage: text('wa', existing.whatsappMessage),
          seoTitle: text('seo_title', existing.seo.title),
          seoDescription: text('seo_desc', existing.seo.description),
          status: text('status', existing.status) as Service['status'],
          featured: form.get('featured') === 'on',
          intro: lines('intro', existing.intro),
          deliverables: lines('entregaveis', existing.deliverables),
          audience: lines('publico', existing.audience),
          heroBg: text('hero_bg', existing.heroBg),
          heroBgAlt: text('hero_bg_alt', existing.heroBgAlt),
          aside: Object.fromEntries(
            (Object.keys(DEFAULT_ASIDE) as (keyof ServiceAside)[]).map((key) => [
              key,
              text(`aside_${key}`, existing.aside[key]).trim(),
            ])
          ) as unknown as ServiceAside,
          ...(form.has('hl_present') ? { highlights: readHighlights(form) } : {}),
          ...(form.has('bl_present') ? { blocks: readBlocks(form) } : {}),
        },
        existing
      );

      if (requestedSlug !== existing.slug) {
        await createRedirect(db, {
          from: `/servicos/${existing.slug}`,
          to: `/servicos/${requestedSlug}`,
          code: 301,
        });
      }

      await writeAuditLog(db, {
        userId: Astro.locals.user?.id,
        userName: Astro.locals.user?.name ?? '',
        action: 'service.update',
        target: `Serviço: ${existing.name}`,
        ip: Astro.request.headers.get('cf-connecting-ip') ?? '',
      });
      return Astro.redirect(`/admin/servicos/${requestedSlug}?saved=1`);
    }
  }
}

const service = findBySlug(Astro.locals.services, slug);
if (!service) return Astro.rewrite('/404');
const justSaved = Astro.url.searchParams.get('saved') === '1';

function formatDate(iso: string): string {
  const [datePart] = iso.split(' ');
  const [y, m, d] = (datePart ?? '').split('-');
  return `${d}/${m}/${y}`;
}
---

<AdminLayout
  title={`Serviço: ${service.name}`}
  description="Edição do serviço — conteúdo, mídia, CTA de WhatsApp contextual, ordenação e SEO próprio."
  active="/admin/servicos"
>
  <div slot="actions">
    <a href="/admin/servicos" class="btn btn--ghost btn--sm">
      <Icon name="arrow-left" size={16} />
      Voltar
    </a>
    <a
      href={`/servicos/${service.slug}`}
      class="btn btn--secondary btn--sm"
      target="_blank"
      rel="noopener"
    >
      <Icon name="eye" size={16} />
      Ver no site
    </a>
  </div>

  {
    justSaved && (
      <div
        class="form-alert form-alert--success"
        role="status"
        style="margin-bottom: var(--sp-5)"
      >
        <Icon name="check-circle" size={18} />
        <span>Serviço salvo. Já vale para o site publicado.</span>
      </div>
    )
  }
  {
    slugError && (
      <div class="form-alert form-alert--error" role="alert" style="margin-bottom: var(--sp-5)">
        <Icon name="alert-circle" size={18} />
        <span>{slugError}</span>
      </div>
    )
  }

  <form class="editor-layout" method="post" id="form-servico">
    <div class="panel" data-tabs>
      <div class="tabs">
        <button type="button" class="tab is-active" data-tab="conteudo" aria-selected="true"
          >Conteúdo</button
        >
        <button type="button" class="tab" data-tab="detalhes" aria-selected="false"
          >Cards e lateral</button
        >
        <button type="button" class="tab" data-tab="midia" aria-selected="false"
          >Mídia e ícone</button
        >
        <button type="button" class="tab" data-tab="seo" aria-selected="false">SEO</button>
      </div>

      <!-- CONTEÚDO -->
      <div class="panel__body" data-tab-panel="conteudo">
        <div class="form-section">
          <div class="form-grid form-grid--2">
            <div class="field">
              <label class="label" for="nome">Nome do serviço</label>
              <input class="input" id="nome" name="nome" value={service.name} />
            </div>
            <div class="field">
              <label class="label" for="nome_curto">Nome curto (menus e cards)</label>
              <input
                class="input"
                id="nome_curto"
                name="nome_curto"
                value={service.shortName}
              />
            </div>
          </div>

          <div class="field">
            <label class="label" for="slug">Slug</label>
            <input class="input" id="slug" name="slug" value={service.slug} />
            <span class="hint">
              Mudar o slug cria automaticamente um redirecionamento 301 do endereço antigo para
              o novo — links já publicados continuam funcionando.
            </span>
          </div>

          <div class="field">
            <label class="label" for="resumo">Resumo (card e listagens)</label>
            <textarea class="textarea" id="resumo" name="resumo" style="min-height:96px"
              >{service.summary}</textarea
            >
          </div>

          <div class="field">
            <label class="label" for="hero_titulo">Título da página</label>
            <input
              class="input"
              id="hero_titulo"
              name="hero_titulo"
              value={service.heroTitle}
            />
          </div>

          <div class="field">
            <label class="label" for="hero_lead">Subtítulo da página</label>
            <textarea class="textarea" id="hero_lead" name="hero_lead" style="min-height:96px"
              >{service.heroLead}</textarea
            >
          </div>

          <div class="field">
            <label class="label" for="intro">Introdução (um parágrafo por linha)</label>
            <textarea class="textarea" id="intro" name="intro" style="min-height:180px"
              >{service.intro.join('\n')}</textarea
            >
            <span class="hint">Cada linha vira um parágrafo na página do serviço.</span>
          </div>
        </div>
        <div class="form-section">
          <h3 class="form-section__title">Blocos de conteúdo (o texto principal da página)</h3>
          <p class="hint">
            Cada bloco tem título, um texto (opcional) e uma lista com marcadores (opcional, um
            item por linha).
          </p>
          <input type="hidden" name="bl_present" value="1" />
          <div class="rows" data-rows="bl">
            {
              service.blocks.map((block) => (
                <div class="edit-row" data-row>
                  <input type="hidden" name="bl_id" value={block.id ?? ''} />
                  <div class="edit-row__head">
                    <span class="label">Bloco</span>
                    <span class="edit-row__tools">
                      <button type="button" class="btn btn--ghost btn--sm" data-up aria-label="Subir">↑</button>
                      <button type="button" class="btn btn--ghost btn--sm" data-down aria-label="Descer">↓</button>
                      <button type="button" class="btn btn--ghost btn--sm" data-remove>
                        <Icon name="trash" size={14} /> Remover
                      </button>
                    </span>
                  </div>
                  <input class="input" name="bl_title" value={block.title} placeholder="Título do bloco" />
                  <textarea class="textarea" name="bl_text" placeholder="Texto do bloco (opcional)" style="min-height:96px">{block.text ?? ''}</textarea>
                  <textarea class="textarea" name="bl_items" placeholder="Lista com marcadores — um item por linha (opcional)" style="min-height:96px">{(block.items ?? []).join('\n')}</textarea>
                </div>
              ))
            }
          </div>
          <button type="button" class="btn btn--secondary btn--sm" data-add="bl">
            <Icon name="plus" size={14} /> Adicionar bloco
          </button>
          <template data-template="bl">
            <div class="edit-row" data-row>
              <input type="hidden" name="bl_id" value="" />
              <div class="edit-row__head">
                <span class="label">Bloco</span>
                <span class="edit-row__tools">
                  <button type="button" class="btn btn--ghost btn--sm" data-up aria-label="Subir">↑</button>
                  <button type="button" class="btn btn--ghost btn--sm" data-down aria-label="Descer">↓</button>
                  <button type="button" class="btn btn--ghost btn--sm" data-remove>
                    <Icon name="trash" size={14} /> Remover
                  </button>
                </span>
              </div>
              <input class="input" name="bl_title" placeholder="Título do bloco" />
              <textarea class="textarea" name="bl_text" placeholder="Texto do bloco (opcional)" style="min-height:96px"></textarea>
              <textarea class="textarea" name="bl_items" placeholder="Lista com marcadores — um item por linha (opcional)" style="min-height:96px"></textarea>
            </div>
          </template>
        </div>

      </div>

      <!-- BLOCOS -->
      <div class="panel__body" data-tab-panel="detalhes" hidden>
        <div class="form-section">
          <h3 class="form-section__title">Destaques (cards) — até {MAX_HIGHLIGHTS}</h3>
          <p class="hint">
            Os cards logo abaixo do topo da página. Altere, remova ou adicione, até {MAX_HIGHLIGHTS}.
          </p>
          <input type="hidden" name="hl_present" value="1" />
          <div class="rows" data-rows="hl" data-max={MAX_HIGHLIGHTS}>
            {
              service.highlights.map((item) => (
                <div class="edit-row" data-row>
                  <input type="hidden" name="hl_id" value={item.id ?? ''} />
                  <div class="edit-row__head">
                    <select class="select" name="hl_icon" aria-label="Ícone do card">
                      {iconNames.map((name) => (
                        <option value={name} selected={name === item.icon}>
                          {name}
                        </option>
                      ))}
                    </select>
                    <button type="button" class="btn btn--ghost btn--sm" data-remove>
                      <Icon name="trash" size={14} /> Remover
                    </button>
                  </div>
                  <input class="input" name="hl_title" value={item.title} placeholder="Título do card" />
                  <textarea class="textarea" name="hl_text" placeholder="Texto do card" style="min-height:72px">{item.text}</textarea>
                </div>
              ))
            }
          </div>
          <button type="button" class="btn btn--secondary btn--sm" data-add="hl">
            <Icon name="plus" size={14} /> Adicionar card
          </button>
          <template data-template="hl">
            <div class="edit-row" data-row>
              <input type="hidden" name="hl_id" value="" />
              <div class="edit-row__head">
                <select class="select" name="hl_icon" aria-label="Ícone do card">
                  {iconNames.map((name) => (
                    <option value={name} selected={name === 'check-circle'}>{name}</option>
                  ))}
                </select>
                <button type="button" class="btn btn--ghost btn--sm" data-remove>
                  <Icon name="trash" size={14} /> Remover
                </button>
              </div>
              <input class="input" name="hl_title" placeholder="Título do card" />
              <textarea class="textarea" name="hl_text" placeholder="Texto do card" style="min-height:72px"></textarea>
            </div>
          </template>
        </div>

        <div class="form-section">
          <h3 class="form-section__title">Barra lateral — textos</h3>
          <div class="form-grid form-grid--2">
            <div class="field">
              <label class="label" for="aside_deliverablesTitle">Título da 1ª lista</label>
              <input class="input" id="aside_deliverablesTitle" name="aside_deliverablesTitle" value={service.aside.deliverablesTitle} />
            </div>
            <div class="field">
              <label class="label" for="aside_audienceTitle">Título da 2ª lista</label>
              <input class="input" id="aside_audienceTitle" name="aside_audienceTitle" value={service.aside.audienceTitle} />
            </div>
          </div>
          <div class="field">
            <label class="label" for="aside_ctaTitle">Título do bloco de contato</label>
            <input class="input" id="aside_ctaTitle" name="aside_ctaTitle" value={service.aside.ctaTitle} />
          </div>
          <div class="field">
            <label class="label" for="aside_ctaText">Texto do bloco de contato</label>
            <textarea class="textarea" id="aside_ctaText" name="aside_ctaText" style="min-height:80px">{service.aside.ctaText}</textarea>
          </div>
          <div class="form-grid form-grid--2">
            <div class="field">
              <label class="label" for="aside_whatsappLabel">Texto do botão WhatsApp</label>
              <input class="input" id="aside_whatsappLabel" name="aside_whatsappLabel" value={service.aside.whatsappLabel} placeholder="vazio = telefone do site" />
            </div>
            <div class="field">
              <label class="label" for="aside_ctaButtonLabel">Texto do 2º botão</label>
              <input class="input" id="aside_ctaButtonLabel" name="aside_ctaButtonLabel" value={service.aside.ctaButtonLabel} />
            </div>
          </div>
        </div>

        <div class="form-section">
          <h3 class="form-section__title">O que entregamos (um item por linha)</h3>
          <textarea class="textarea" name="entregaveis" style="min-height:140px"
            >{service.deliverables.join('\n')}</textarea
          >
        </div>

        <div class="form-section">
          <h3 class="form-section__title">Público-alvo (um item por linha)</h3>
          <textarea class="textarea" name="publico" style="min-height:110px"
            >{service.audience.join('\n')}</textarea
          >
        </div>
      </div>

      <!-- MÍDIA -->
      <div class="panel__body" data-tab-panel="midia" hidden>
        <div class="form-section">
          <ImageUploadField
            id="imagem"
            name="imagem"
            value={service.image}
            label="Imagem principal"
          />

          <div class="field">
            <label class="label" for="alt">Texto alternativo</label>
            <input class="input" id="alt" name="alt" value={service.imageAlt} />
          </div>

          <ImageUploadField
            id="hero_bg"
            name="hero_bg"
            value={service.heroBg}
            label="Imagem de fundo do topo (substitui o fundo azul; vazio = azul)"
          />

          <div class="field">
            <label class="label" for="hero_bg_alt">Texto alternativo do fundo do topo</label>
            <input class="input" id="hero_bg_alt" name="hero_bg_alt" value={service.heroBgAlt} />
          </div>

          <div class="form-grid form-grid--2">
            <div class="field">
              <IconPicker name="icone" value={service.icon} label="Ícone do serviço" />
            </div>
            <div class="field">
              <label class="label" for="ordem">Ordem de exibição</label>
              <input
                class="input"
                id="ordem"
                name="ordem"
                type="number"
                value={service.order}
                min="1"
                disabled
              />
            </div>
          </div>

          <div class="field">
            <label class="label" for="wa">Mensagem de WhatsApp contextual</label>
            <textarea class="textarea" id="wa" name="wa" style="min-height:88px"
              >{service.whatsappMessage}</textarea
            >
            <span class="hint">Usada no botão flutuante e nos CTAs desta página.</span>
          </div>
        </div>
      </div>

      <!-- SEO -->
      <div class="panel__body" data-tab-panel="seo" hidden>
        <div class="form-section">
          <div class="field">
            <label class="label" for="seo_title">SEO Title</label>
            <input class="input" id="seo_title" name="seo_title" value={service.seo.title} />
          </div>
          <div class="field">
            <label class="label" for="seo_desc">Meta description</label>
            <textarea class="textarea" id="seo_desc" name="seo_desc" style="min-height:96px"
              >{service.seo.description}</textarea
            >
          </div>
          <div class="field">
            <label class="label" for="canonical">URL canônica</label>
            <input
              class="input"
              id="canonical"
              value={`https://essencialsaudeauditoria.com.br/servicos/${service.slug}`}
              disabled
            />
          </div>
        </div>
      </div>

      <div class="panel__foot">
        <span class="muted small">Última atualização: {formatDate(service.updatedAt)}</span>
        <button type="submit" class="btn btn--sm">
          <Icon name="save" size={16} />
          Salvar serviço
        </button>
      </div>
    </div>

    <aside class="editor-side">
      <section class="panel">
        <div class="panel__head">
          <h2 class="panel__title">Publicação</h2>
        </div>
        <div class="panel__body stack">
          <div class="field">
            <label class="label" for="status">Status</label>
            <select class="select" id="status" name="status">
              <option value="published" selected={service.status === 'published'}
                >Publicado</option
              >
              <option value="draft" selected={service.status === 'draft'}>Rascunho</option>
              <option value="archived" selected={service.status === 'archived'}
                >Arquivado</option
              >
            </select>
          </div>
          <label class="checkbox">
            <input type="checkbox" name="featured" checked={service.featured} />
            <span>Exibir como serviço em destaque</span>
          </label>
          <button type="submit" class="btn btn--block">
            <Icon name="save" size={16} />
            Salvar e atualizar status
          </button>
        </div>
      </section>

      <section class="panel">
        <div class="panel__head">
          <h2 class="panel__title">Pré-visualização do card</h2>
        </div>
        <div class="panel__body">
          <article class="card">
            <span class="icon-badge">
              <Icon name={service.icon} size={22} />
            </span>
            <h3>{service.name}</h3>
            <p>{service.summary}</p>
          </article>
        </div>
      </section>
    </aside>
  </form>
</AdminLayout>

<script>
  const form = document.getElementById('form-servico');
  const rowsOf = (key: string) => form?.querySelector<HTMLElement>(`[data-rows="${key}"]`);

  function refreshLimit(key: string) {
    const rows = rowsOf(key);
    const max = Number(rows?.dataset.max ?? 0);
    const add = form?.querySelector<HTMLButtonElement>(`[data-add="${key}"]`);
    if (rows && add && max) add.disabled = rows.querySelectorAll('[data-row]').length >= max;
  }

  form?.addEventListener('click', (event) => {
    const target = event.target as HTMLElement;
    const add = target.closest<HTMLElement>('[data-add]');
    if (add) {
      const key = add.dataset.add!;
      const rows = rowsOf(key);
      const template = form.querySelector<HTMLTemplateElement>(`[data-template="${key}"]`);
      const max = Number(rows?.dataset.max ?? 0);
      if (!rows || !template || (max && rows.querySelectorAll('[data-row]').length >= max)) return;
      rows.appendChild(template.content.cloneNode(true));
      refreshLimit(key);
      return;
    }
    const row = target.closest<HTMLElement>('[data-row]');
    if (!row) return;
    const rows = row.parentElement!;
    if (target.closest('[data-remove]')) {
      if (window.confirm('Remover este item? A alteração vale ao salvar.')) {
        row.remove();
        refreshLimit(rows.dataset.rows!);
      }
    } else if (target.closest('[data-up]') && row.previousElementSibling) {
      rows.insertBefore(row, row.previousElementSibling);
    } else if (target.closest('[data-down]') && row.nextElementSibling) {
      rows.insertBefore(row.nextElementSibling, row);
    }
  });

  refreshLimit('hl');
</script>

<style>
  .edit-row {
    display: grid;
    gap: var(--sp-3);
    padding: var(--sp-4);
    margin-bottom: var(--sp-3);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--c-ink-50);
  }

  .edit-row__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--sp-3);
  }

  .edit-row__head .select {
    max-width: 220px;
  }

  .order {
    display: grid;
    place-items: center;
    width: 28px;
    height: 28px;
    border-radius: var(--r-xs);
    background: var(--c-ink-100);
    color: var(--c-ink-600);
    font-size: var(--fs-xs);
    font-variant-numeric: tabular-nums;
  }

  .image-picker {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--sp-4);
    align-items: center;
    padding: var(--sp-4);
    border: 1px solid var(--line);
    border-radius: var(--r-md);
    background: var(--c-ink-50);
