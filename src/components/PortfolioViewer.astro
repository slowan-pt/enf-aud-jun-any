---
/**
 * Revista do Portfólio (páginas que viram, com zoom) + formulário de pedido do PDF.
 * Usado em /portfolio e no fim de Quem Somos.
 */
import Icon from './Icon.astro';
import { DEFAULT_PORTFOLIO_FILES, pageImageUrls } from '../lib/portfolio-files';
import { DEFAULT_SITE_TEXTS } from '../lib/site-texts';

const files = Astro.locals.settings?.portfolio ?? DEFAULT_PORTFOLIO_FILES;
const form = (Astro.locals.settings?.siteTexts ?? DEFAULT_SITE_TEXTS).portfolioForm;
const pages = pageImageUrls(files);
// Proporção da página (largura/altura): o padrão é A4 em pé.
const pageW = 550;
const pageH = Math.round(pageW / files.ratio);
const dims = {
  width: pageW,
  height: pageH,
  minWidth: 240,
  maxWidth: 640,
  minHeight: Math.round(240 / files.ratio),
  maxHeight: Math.round(640 / files.ratio),
};
---
<section class="section section--tight">
  <div class="container">
    <div class="flipbook" data-flipbook data-pages={JSON.stringify(pages)} data-dims={JSON.stringify(dims)}>
      <div class="flipbook__view" data-view>
        <div class="flipbook__stage" data-stage>
          <img class="flipbook__fallback" src={pages[0]} alt="Portfólio — capa" />
        </div>
        <div class="flipbook__zoomview" data-zoomview hidden>
          <div class="flipbook__zoominner" data-zoominner></div>
        </div>
      </div>
      <div class="flipbook__bar">
        <button type="button" class="btn btn--ghost btn--sm" data-prev aria-label="Página anterior">
          <Icon name="arrow-left" size={16} /> Anterior
        </button>
        <span class="flipbook__count" data-count aria-live="polite">1 / {pages.length}</span>
        <button type="button" class="btn btn--ghost btn--sm" data-next aria-label="Próxima página">
          Próxima <Icon name="arrow-right" size={16} />
        </button>
        <button type="button" class="btn btn--ghost btn--sm" data-zoom aria-pressed="false">
          <Icon name="search" size={16} /> <span data-zoom-label>Zoom</span>
        </button>
        <button type="button" class="btn btn--ghost btn--sm" data-full aria-label="Tela cheia">
          Tela cheia
        </button>
      </div>
      <p class="flipbook__hint" data-hint></p>
    </div>
  </div>
</section>

<section class="section section--subtle" id="receber">
  <div class="container container--narrow">
    <div class="request" data-request>
      <h2 class="title-md">{form.title}</h2>
      <p class="request__lead">
        {form.lead}
      </p>

      <form class="request__form" method="post" action="/api/portfolio" novalidate data-request-form data-success={form.success}>
        <div class="request__hp" aria-hidden="true">
          <label>Não preencha <input type="text" name="website" tabindex="-1" autocomplete="off" /></label>
        </div>
        <label class="request__field">
          <span>Nome completo</span>
          <input class="input" type="text" name="nome" autocomplete="name" maxlength="150" required />
        </label>
        <label class="request__field">
          <span>E-mail</span>
          <input class="input" type="email" name="email" autocomplete="email" required />
        </label>
        <label class="request__field">
          <span>Telefone (com DDD)</span>
          <input class="input" type="tel" name="telefone" autocomplete="tel" inputmode="tel" required />
        </label>
        <label class="request__field">
          <span>Empresa</span>
          <input class="input" type="text" name="empresa" autocomplete="organization" maxlength="200" required />
        </label>
        <label class="request__field">
          <span>Cargo</span>
          <input class="input" type="text" name="cargo" autocomplete="organization-title" maxlength="150" required />
        </label>
        <label class="request__consent">
          <input type="checkbox" name="consentimento" />
          <span>
            Concordo com o tratamento dos meus dados para análise deste pedido e envio do material,
            conforme a{' '}
            <a href="/politica-de-privacidade" data-popup target="_blank" rel="noopener">Política de Privacidade</a>.
          </span>
        </label>
        <button type="submit" class="btn btn--primary request__submit">
          <Icon name="download" size={18} /> {form.button}
        </button>
        <p class="request__msg" role="status" data-msg></p>
      </form>
    </div>
  </div>
</section>


<style>
  .flipbook {
    display: grid;
    justify-items: center;
    gap: var(--sp-4);
  }

  .flipbook__stage {
    width: 100%;
    max-width: 1180px;
    display: grid;
    justify-items: center;
  }

  .flipbook__view {
    position: relative;
    width: 100%;
    max-width: 1180px;
    overflow: hidden;
    border-radius: var(--r-md);
  }

  .flipbook__stage {
    transition: transform 0.18s ease-out;
  }

  .flipbook__view.is-zoom .flipbook__stage {
    visibility: hidden;
  }

  /* Ampliação: camada com as imagens em alta resolução (não as da revista), então o
     texto fica nítido como no PDF original. O JavaScript move/escala o conteúdo. */
  .flipbook__zoomview {
    position: absolute;
    inset: 0;
    z-index: 4;
    overflow: hidden;
    background: #fff;
    touch-action: none;
    cursor: default;
  }

  .flipbook__zoomview[hidden] {
    display: none;
  }

  .flipbook__zoominner {
    position: absolute;
    inset: 0;
    display: flex;
    transform-origin: 0 0;
  }

  .flipbook__zoominner.is-right {
    justify-content: flex-end;
  }

  .flipbook :global(.flipbook__zoominner img) {
    display: block;
    flex: none;
    width: 50%;
    height: 100%;
    object-fit: fill;
    user-select: none;
    -webkit-user-drag: none;
  }

  .flipbook :global(.flipbook__zoominner.is-full img) {
    width: 100%;
  }

  @media (pointer: fine) {
    .flipbook__stage {
      cursor: zoom-in;
    }
  }

  /* Celular: a revista ocupa a largura inteira da tela (a página fica ~10% maior e mais legível). */
  @media (max-width: 640px) {
    .flipbook__view,
    .flipbook__stage {
      width: 100vw;
      max-width: 100vw;
      margin-inline: calc(50% - 50vw);
      border-radius: 0;
    }
  }

  .flipbook :global(.flipbook__page) {
    background: #fff;
    overflow: hidden;
  }

  .flipbook :global(.flipbook__page img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: fill;
    pointer-events: none;
    user-select: none;
    -webkit-user-drag: none;
  }

  .flipbook__fallback {
    max-width: 420px;
    width: 100%;
    height: auto;
    border-radius: var(--r-md);
    box-shadow: var(--shadow-md);
  }

  .flipbook__bar {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: var(--sp-3);
  }

  .flipbook__count {
    min-width: 4.5rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
    color: var(--text-muted);
  }

  .flipbook__hint {
    margin: 0;
    font-size: var(--fs-xs);
    color: var(--text-faint);
    text-align: center;
  }

  .flipbook :global(.btn.is-active) {
    background: var(--c-accent-600);
    color: #fff;
  }

  .flipbook:fullscreen {
    background: #0b1626;
    padding: var(--sp-4);
    align-content: center;
  }

  .flipbook:fullscreen .flipbook__count,
  .flipbook:fullscreen .flipbook__hint {
    color: #cfd8e3;
  }

  .request {
    display: grid;
    gap: var(--sp-4);
    padding: clamp(1.25rem, 3vw, 2rem);
    background: var(--c-white);
    border: 1px solid var(--line);
    border-radius: var(--r-xl);
    box-shadow: var(--shadow-sm);
  }

  .request__lead {
    margin: 0;
    color: var(--text-muted);
    text-align: left;
  }

  .request__form {
    display: grid;
    gap: var(--sp-4);
  }

  .request__field {
    display: grid;
    gap: 0.35rem;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    color: var(--text-strong);
  }

  .request__consent {
    display: flex;
    gap: var(--sp-2);
    align-items: flex-start;
    font-size: var(--fs-xs);
    line-height: 1.5;
    color: var(--text-muted);
  }

  .request__consent input {
    margin-top: 0.2rem;
    flex: none;
  }

  .request__consent span {
    text-align: left;
  }

  .request__submit {
    justify-self: stretch;
  }

  .request__msg {
    min-height: 1.2em;
    margin: 0;
    font-size: var(--fs-sm);
    font-weight: var(--fw-medium);
    text-align: left;
  }

  .request__msg[data-state='ok'] {
    color: var(--c-accent-700);
  }

  .request__msg[data-state='error'] {
    color: var(--c-danger-600);
  }

  .request__hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
</style>

<style is:global>
  /* Estilos exigidos pelo modo HTML da biblioteca da revista (page-flip, MIT). */
  .stf__parent {
    position: relative;
    display: block;
    box-sizing: border-box;
    transform: translateZ(0);
    touch-action: pan-y;
  }
  .stf__wrapper {
    position: relative;
    width: 100%;
    box-sizing: border-box;
  }
  .stf__block {
    position: absolute;
    width: 100%;
    height: 100%;
    box-sizing: border-box;
    perspective: 2000px;
  }
  .stf__item {
    display: none;
    position: absolute;
    transform-style: preserve-3d;
  }
  .stf__outerShadow,
  .stf__innerShadow,
  .stf__hardShadow,
  .stf__hardInnerShadow {
    position: absolute;
    left: 0;
    top: 0;
  }
</style>

<script is:inline src="/vendor/page-flip.browser.js"></script>
<script is:inline>
  (function () {
    // ---------- revista (páginas que viram) ----------
    var root = document.querySelector('[data-flipbook]');
    var stage = root && root.querySelector('[data-stage]');
    if (root && stage && window.St && window.St.PageFlip) {
      var urls = JSON.parse(root.getAttribute('data-pages') || '[]');
      stage.innerHTML = '';
      var dims = JSON.parse(root.getAttribute('data-dims') || '{}');
      // Modo HTML: cada página é uma <img> de verdade. O navegador reduz a imagem com
      // qualidade e usa a densidade de pixels do aparelho (o modo canvas desenhava em
      // baixa resolução e ficava borrado, principalmente no celular).
      var items = urls.map(function (url, i) {
        var page = document.createElement('div');
        page.className = 'flipbook__page';
        if (i === 0 || i === urls.length - 1) page.setAttribute('data-density', 'hard');
        var img = new Image();
        img.src = url;
        img.alt = 'Página ' + (i + 1) + ' do Portfólio';
        img.decoding = 'async';
        img.draggable = false;
        page.appendChild(img);
        return page;
      });
      var flip = new window.St.PageFlip(stage, {
        width: dims.width || 550,
        height: dims.height || 778,
        size: 'stretch',
        minWidth: dims.minWidth || 240,
        maxWidth: dims.maxWidth || 560,
        minHeight: dims.minHeight || 340,
        maxHeight: dims.maxHeight || 792,
        showCover: true,
        usePortrait: true,
        maxShadowOpacity: 0.45,
        flippingTime: 800,
        mobileScrollSupport: false,
        disableFlipByClick: true,
      });
      flip.loadFromHTML(items);
      var count = root.querySelector('[data-count]');
      var update = function () {
        if (count) count.textContent = flip.getCurrentPageIndex() + 1 + ' / ' + flip.getPageCount();
      };
      flip.on('flip', update);
      flip.on('init', update);
      var go = function (dir) {
        if (Z.on) exitZoom();
        if (dir > 0) flip.flipNext();
        else flip.flipPrev();
      };
      root.querySelector('[data-prev]').addEventListener('click', function () { go(-1); });
      root.querySelector('[data-next]').addEventListener('click', function () { go(1); });
      var full = root.querySelector('[data-full]');
      if (full) {
        if (!root.requestFullscreen) full.hidden = true;
        full.addEventListener('click', function () {
          if (document.fullscreenElement) document.exitFullscreen();
          else root.requestFullscreen();
        });
      }
      // ---------- zoom ----------
      // Computador: um clique amplia no ponto clicado; mover o mouse percorre a página
      // (roda do mouse ajusta o nível). Celular: gesto de pinça com dois dedos amplia e
      // mantém o zoom ao soltar; com um dedo você arrasta a página ampliada.
      var view = root.querySelector('[data-view]');
      var zoomview = root.querySelector('[data-zoomview]');
      var inner = root.querySelector('[data-zoominner]');
      var zoomBtn = root.querySelector('[data-zoom]');
      var zoomLabel = root.querySelector('[data-zoom-label]');
      var hint = root.querySelector('[data-hint]');
      var coarse = window.matchMedia && window.matchMedia('(pointer: coarse)').matches;
      var HINT_OFF = coarse
        ? 'Deslize para virar a página · use dois dedos para ampliar.'
        : 'Clique na página para ampliar · arraste o canto ou use as setas para virar.';
      var HINT_ON = coarse
        ? 'Arraste com um dedo para mover · pince com dois dedos para ajustar · toque em “Sair do zoom” para voltar.'
        : 'Mova o mouse para percorrer a página · role o mouse para ajustar o zoom · “Sair do zoom” ou Esc para voltar.';
      if (hint) hint.textContent = HINT_OFF;

      var Z = { on: false, s: 1, tx: 0, ty: 0, W: 1, H: 1 };
      var START = 2.6;
      var MAXS = 5;
      var lastTouch = 0;
      var lastMouse = null;

      function measure() {
        var b = view.getBoundingClientRect();
        Z.W = b.width || 1;
        Z.H = b.height || 1;
      }
      function clampPan() {
        Z.tx = Math.min(0, Math.max(Z.W * (1 - Z.s), Z.tx));
        Z.ty = Math.min(0, Math.max(Z.H * (1 - Z.s), Z.ty));
      }
      function apply(smooth) {
        inner.style.transition = smooth ? 'transform 0.14s ease-out' : 'none';
        inner.style.transform = 'translate3d(' + Z.tx + 'px,' + Z.ty + 'px,0) scale(' + Z.s + ')';
      }
      function rel(clientX, clientY) {
        var b = view.getBoundingClientRect();
        return { x: clientX - b.left, y: clientY - b.top };
      }
      // Com o mouse, a parte da página sob o cursor é a que aparece (ponto fixo = fração do cursor).
      function followMouse(p) {
        Z.tx = -(p.x / Z.W) * (Z.s - 1) * Z.W;
        Z.ty = -(p.y / Z.H) * (Z.s - 1) * Z.H;
        clampPan();
        apply(true);
      }

      function buildZoomPages() {
        var i = flip.getCurrentPageIndex();
        var total = flip.getPageCount();
        var shown = [i];
        var mode = 'is-full';
        if (flip.getOrientation() !== 'portrait') {
          if (i === 0) {
            shown = [0];
            mode = 'is-right'; // a capa fica na metade direita, como na revista
          } else {
            var left = i % 2 === 1 ? i : i - 1;
            shown = left + 1 < total ? [left, left + 1] : [left];
            mode = '';
          }
        }
        inner.className = 'flipbook__zoominner ' + mode;
        inner.innerHTML = '';
        shown.forEach(function (n) {
          var img = new Image();
          img.alt = 'Página ' + (n + 1) + ' ampliada';
          img.decoding = 'async';
          img.draggable = false;
          img.src = urls[n]; // já em cache: aparece na hora
          var hi = new Image(); // troca pela versão de altíssima resolução quando chegar
          hi.onload = function () { img.src = hi.src; };
          hi.src = urls[n].replace('pagina-', 'zoom-');
          inner.appendChild(img);
        });
      }

      function setUi(on) {
        view.classList.toggle('is-zoom', on);
        zoomview.hidden = !on;
        zoomBtn.setAttribute('aria-pressed', String(on));
        zoomBtn.classList.toggle('is-active', on);
        if (zoomLabel) zoomLabel.textContent = on ? 'Sair do zoom' : 'Zoom';
        if (hint) hint.textContent = on ? HINT_ON : HINT_OFF;
      }
      function enterZoom(x, y, scale) {
        buildZoomPages();
        measure();
        Z.on = true;
        Z.s = scale;
        Z.tx = x - x * scale;
        Z.ty = y - y * scale;
        clampPan();
        apply(false);
        setUi(true);
      }
      function exitZoom() {
        Z.on = false;
        setUi(false);
      }

      zoomBtn.addEventListener('click', function () {
        if (Z.on) exitZoom();
        else {
          measure();
          enterZoom(Z.W / 2, Z.H / 2, START);
        }
      });

      // --- computador ---
      var downX = 0;
      var downY = 0;
      view.addEventListener('mousedown', function (e) { downX = e.clientX; downY = e.clientY; }, true);
      view.addEventListener('click', function (e) {
        if (Date.now() - lastTouch < 800) return; // clique "fantasma" depois de um toque
        if (Z.on) return;
        if (Math.abs(e.clientX - downX) > 6 || Math.abs(e.clientY - downY) > 6) return; // foi arrasto (virar página)
        measure();
        var p = rel(e.clientX, e.clientY);
        enterZoom(p.x, p.y, START);
      });
      view.addEventListener('mousemove', function (e) {
        if (!Z.on || Date.now() - lastTouch < 800) return;
        lastMouse = rel(e.clientX, e.clientY);
        followMouse(lastMouse);
      });
      view.addEventListener('wheel', function (e) {
        if (!Z.on) return;
        e.preventDefault();
        Z.s = Math.min(MAXS, Math.max(1.3, Z.s * (e.deltaY < 0 ? 1.12 : 1 / 1.12)));
        followMouse(rel(e.clientX, e.clientY));
      }, { passive: false });

      // --- celular: pinça e arrastar ---
      var T = { mode: null, dist: 0, mid: null, last: null };
      var rel0 = function (t) { return rel(t.clientX, t.clientY); };
      var spread = function (a, b) { return Math.hypot(a.x - b.x, a.y - b.y) || 1; };
      view.addEventListener('touchstart', function (e) {
        lastTouch = Date.now();
        if (e.touches.length === 2) {
          e.preventDefault();
          e.stopPropagation();
          var a = rel0(e.touches[0]);
          var b = rel0(e.touches[1]);
          T.mode = 'pinch';
          T.dist = spread(a, b);
          T.mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
          if (!Z.on) enterZoom(T.mid.x, T.mid.y, 1);
        } else if (e.touches.length === 1 && Z.on) {
          e.stopPropagation();
          T.mode = 'pan';
          T.last = rel0(e.touches[0]);
        }
      }, { capture: true, passive: false });
      view.addEventListener('touchmove', function (e) {
        lastTouch = Date.now();
        if (!Z.on && e.touches.length < 2) return; // um dedo fora do zoom: deixa virar página
        e.preventDefault();
        e.stopPropagation();
        if (e.touches.length === 2 && T.mode === 'pinch') {
          var a = rel0(e.touches[0]);
          var b = rel0(e.touches[1]);
          var dist = spread(a, b);
          var mid = { x: (a.x + b.x) / 2, y: (a.y + b.y) / 2 };
          var ns = Math.min(MAXS, Math.max(1, Z.s * (dist / T.dist)));
          // O ponto da página sob os dedos continua sob os dedos enquanto você pinça.
          var cx = (T.mid.x - Z.tx) / Z.s;
          var cy = (T.mid.y - Z.ty) / Z.s;
          Z.s = ns;
          Z.tx = mid.x - cx * ns;
          Z.ty = mid.y - cy * ns;
          clampPan();
          apply(false);
          T.dist = dist;
          T.mid = mid;
        } else if (e.touches.length === 1 && T.mode === 'pan') {
          var p = rel0(e.touches[0]);
          Z.tx += p.x - T.last.x;
          Z.ty += p.y - T.last.y;
          T.last = p;
          clampPan();
          apply(false);
        }
      }, { capture: true, passive: false });
      var touchEnd = function (e) {
        lastTouch = Date.now();
        if (e.touches.length === 0) {
          T.mode = null;
          // Voltou ao tamanho normal com a pinça: sai do zoom sozinho.
          if (Z.on && Z.s < 1.08) exitZoom();
        } else if (e.touches.length === 1 && Z.on) {
          T.mode = 'pan'; // sobrou um dedo: ele passa a arrastar
          T.last = rel0(e.touches[0]);
        }
      };
      view.addEventListener('touchend', touchEnd, { capture: true });
      view.addEventListener('touchcancel', touchEnd, { capture: true });

      window.addEventListener('resize', function () { if (Z.on) exitZoom(); });

      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && Z.on) exitZoom();
        var t = e.target && e.target.tagName;
        if (t === 'INPUT' || t === 'TEXTAREA' || t === 'SELECT') return;
        if (e.key === 'ArrowLeft') go(-1);
        if (e.key === 'ArrowRight') go(1);
      });
    }

    // ---------- formulário de pedido ----------
    var form = document.querySelector('[data-request-form]');
    if (!form) return;
    var msg = form.querySelector('[data-msg]');
    var show = function (text, state) { msg.textContent = text; msg.dataset.state = state; };
    form.addEventListener('submit', function (event) {
      event.preventDefault();
      var button = form.querySelector('button[type="submit"]');
      button.disabled = true;
      show('Enviando…', 'ok');
      fetch(form.action, { method: 'POST', body: new FormData(form) })
        .then(function (res) {
          return res.json().catch(function () { return null; }).then(function (payload) { return { res: res, payload: payload }; });
        })
        .then(function (r) {
          if (r.res.ok && r.payload && r.payload.success) {
            form.reset();
            show(form.getAttribute('data-success') || 'Recebemos o seu pedido!', 'ok');
          } else if (r.res.status === 422 && r.payload && r.payload.fields) {
            show(Object.values(r.payload.fields)[0] || 'Verifique os campos.', 'error');
          } else {
            show((r.payload && r.payload.message) || 'Não foi possível enviar agora. Tente novamente.', 'error');
          }
        })
        .catch(function () { show('Falha de conexão. Tente novamente.', 'error'); })
        .then(function () { button.disabled = false; });
    });
  })();
</script>
