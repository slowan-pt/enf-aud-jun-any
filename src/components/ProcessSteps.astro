---
import Icon from './Icon.astro';
import { howWeWork as defaultHowWeWork } from '../data/institutional';

interface Props {
  /** Passe o conteúdo vindo do banco (Home); sem prop, usa o padrão estático. */
  steps?: typeof defaultHowWeWork.steps;
  /** Caminho no JSON da página; sem ele os passos não entram no editor visual. */
  editPath?: string;
}

const { steps = defaultHowWeWork.steps, editPath } = Astro.props;
const at = (index: number, field: string) =>
  editPath ? `${editPath}.${index}.${field}` : undefined;
---

<ol class="steps" data-edit-list={editPath}>
  {
    steps.map((step, index) => (
      <li class="step" data-reveal data-edit-item={editPath ? index : undefined}>
        <span class="step__rail" aria-hidden="true" />
        <span class="step__num" data-edit={at(index, 'number')} data-edit-label="Número">
          {step.number}
        </span>
        <span class="step__icon">
          <Icon
            name={step.icon}
            size={20}
            data-edit={at(index, 'icon')}
            data-edit-kind={editPath ? 'icon' : undefined}
            data-edit-value={editPath ? step.icon : undefined}
            data-edit-label="Ícone"
          />
        </span>
        <h3
          class="step__title"
          data-edit={at(index, 'title')}
          data-edit-label="Título da etapa"
        >
          {step.title}
        </h3>
        <p
          class="step__text"
          data-edit={at(index, 'text')}
          data-edit-kind={editPath ? 'multiline' : undefined}
          data-edit-label="Texto da etapa"
        >
          {step.text}
        </p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--sp-6);
    counter-reset: step;
  }

  @media (min-width: 680px) {
    .steps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: var(--sp-8) var(--sp-6);
    }
  }

  @media (min-width: 1040px) {
    .steps {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .step {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-areas:
      'rail rail'
      'num icon'
      'title title'
      'text text';
    align-items: center;
    gap: 0.5rem 0.75rem;
    padding-top: var(--sp-5);
  }

  .step__rail {
    grid-area: rail;
    height: 2px;
    width: 100%;
    background: linear-gradient(90deg, var(--c-brand-300), var(--c-brand-100));
    border-radius: 2px;
    margin-bottom: var(--sp-3);
  }

  .step__num {
    grid-area: num;
    font-family: var(--font-display);
    font-size: 1.5rem;
    font-weight: var(--fw-bold);
    color: var(--c-brand-500);
    line-height: 1;
  }

  .step__icon {
    grid-area: icon;
    justify-self: start;
    display: inline-grid;
    place-items: center;
    width: 38px;
    height: 38px;
    border-radius: var(--r-sm);
    background: var(--c-accent-50);
    border: 1px solid var(--c-accent-100);
    color: var(--c-accent-600);
  }

  .step__title {
    grid-area: title;
    font-size: var(--fs-lg);
    margin-top: var(--sp-2);
  }

  .step__text {
    grid-area: text;
    font-size: var(--fs-sm);
    line-height: var(--lh-relaxed);
    color: var(--text-muted);
  }
</style>
