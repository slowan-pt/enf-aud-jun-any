---
/**
 * Par de seletores de cor "fundo" / "texto" para uma seção específica da
 * Home. Cada um é uma paleta de verdade (input type=color, clique abre o
 * seletor do navegador) sincronizada com um campo hex — vazio = herda a
 * paleta global (Configurações → Aparência).
 */
import Icon from '../Icon.astro';
import type { SectionStyle } from '../../lib/pages';

interface Props {
  sectionKey: string;
  value: SectionStyle;
}

const { sectionKey, value } = Astro.props;
const fields: Array<{ key: 'bg' | 'text'; label: string }> = [
  { key: 'bg', label: 'Fundo' },
  { key: 'text', label: 'Texto' },
];
---

<details class="section-colors">
  <summary>Cor desta seção (opcional)</summary>
  <div class="section-colors__row">
    {
      fields.map((f) => (
        <div class="field">
          <label class="label" for={`style_${sectionKey}_${f.key}`}>
            {f.label}
          </label>
          <div class="color-swatch-row" data-color-field>
            <input
              type="color"
              value={value[f.key] || '#ffffff'}
              data-color-swatch
              aria-label={`Escolher cor: ${f.label}`}
            />
            <input
              class="input"
              id={`style_${sectionKey}_${f.key}`}
              name={`style_${sectionKey}_${f.key}`}
              value={value[f.key]}
              placeholder="herda o padrão do site"
              data-color-hex
            />
            <button
              type="button"
              class="row-btn"
              data-color-clear
              title="Herdar o padrão do site"
            >
              <Icon name="close" size={14} />
            </button>
          </div>
        </div>
      ))
    }
  </div>
</details>

<style>
  .section-colors {
    margin-bottom: var(--sp-4);
    padding: var(--sp-3);
    border: 1px dashed var(--line-strong);
    border-radius: var(--r-sm);
    background: var(--c-ink-50);
  }

  .section-colors summary {
    cursor: pointer;
    font-size: var(--fs-xs);
    font-weight: var(--fw-medium);
    color: var(--text-faint);
  }

  .section-colors__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--sp-3);
    margin-top: var(--sp-3);
  }

  .color-swatch-row {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .color-swatch-row input[type='color'] {
    width: 34px;
    height: 34px;
    flex: none;
    padding: 2px;
    border: 1px solid var(--line);
    border-radius: var(--r-sm);
    background: none;
    cursor: pointer;
  }

  .color-swatch-row .input {
    min-width: 0;
    font-family: var(--font-mono);
    font-size: var(--fs-xs);
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-color-field]').forEach((row) => {
    if (row.dataset.bound) return;
    row.dataset.bound = '1';

    const swatch = row.querySelector<HTMLInputElement>('[data-color-swatch]');
    const hex = row.querySelector<HTMLInputElement>('[data-color-hex]');
    const clear = row.querySelector<HTMLButtonElement>('[data-color-clear]');

    swatch?.addEventListener('input', () => {
      if (hex) hex.value = swatch.value;
    });

    hex?.addEventListener('input', () => {
      if (swatch && /^#[0-9a-fA-F]{6}$/.test(hex.value)) swatch.value = hex.value;
    });

    clear?.addEventListener('click', () => {
      if (hex) hex.value = '';
      if (swatch) swatch.value = '#ffffff';
    });
  });
</script>
