---
import Icon from './Icon.astro';
import { waLink } from '../data/site';

interface Props {
  eyebrow?: string;
  title: string;
  text?: string;
  primaryLabel?: string;
  primaryHref?: string;
  whatsappMessage?: string;
  /** Sobrescreve o fundo em degradê (ex.: "background:#0d8b7d"). Vazio herda o padrão. */
  style?: string;
  /** Prefixo do caminho no JSON da página; sem ele a faixa não entra no editor visual. */
  editPath?: string;
  /** Chave da seção usada pelo editor visual (ordem, visibilidade e cor). */
  sectionKey?: string;
  sectionLabel?: string;
  /** Posição/visibilidade da faixa, definidas no editor visual. */
  sectionStyle?: string;
  sectionClass?: string;
}

const { company, whatsapp } = Astro.locals.settings;
const {
  eyebrow,
  title,
  text,
  primaryLabel = 'Solicitar uma apresentação',
  primaryHref = '/contato',
  whatsappMessage = whatsapp.defaultMessage,
  style,
  editPath,
  sectionKey,
  sectionLabel,
  sectionStyle,
  sectionClass,
} = Astro.props;
const at = (field: string) => (editPath ? `${editPath}.${field}` : undefined);
---

<section
  class:list={['cta-band', sectionClass]}
  style={sectionStyle}
  data-section={sectionKey}
  data-section-label={sectionLabel}
>
  <div class="container">
    <div class="cta-band__inner" data-reveal style={style}>
      <div class="cta-band__text">
        {
          eyebrow && (
            <p class="eyebrow" data-edit={at('eyebrow')} data-edit-label="Etiqueta">
              {eyebrow}
            </p>
          )
        }
        <h2 class="title-md" data-edit={at('title')} data-edit-label="Título">{title}</h2>
        {
          text && (
            <p
              data-edit={at('text')}
              data-edit-kind={editPath ? 'multiline' : undefined}
              data-edit-label="Texto"
            >
              {text}
            </p>
          )
        }
      </div>
      <div class="cta-band__actions">
        <a href={primaryHref} class="btn btn--on-brand btn--lg">
          <span data-edit={at('primary.label')} data-edit-label="Botão">{primaryLabel}</span>
          <Icon name="arrow-right" size={18} class="icon--arrow" />
        </a>
        <a
          href={waLink(whatsapp.number, whatsappMessage)}
          class="btn btn--outline-on-brand btn--lg"
          target="_blank"
          rel="noopener"
        >
          <Icon name="whatsapp" size={18} />
          {company.phoneDisplay}
        </a>
      </div>
    </div>
  </div>
</section>

<style>
  .cta-band {
    padding-block: var(--section-y-sm);
    background: var(--c-white);
  }

  .cta-band__inner {
    position: relative;
    overflow: hidden;
    display: grid;
    gap: var(--sp-6);
    align-items: center;
    padding: clamp(1.75rem, 4vw, 3.25rem);
    border-radius: var(--r-xl);
    background:
      radial-gradient(120% 130% at 100% 0%, rgba(18, 167, 148, 0.28), transparent 55%),
      linear-gradient(120deg, var(--c-brand-900), var(--c-brand-700));
    color: var(--text-on-brand);
    box-shadow: var(--shadow-lg);
  }

  @media (min-width: 900px) {
    .cta-band__inner {
      grid-template-columns: 1.15fr auto;
      gap: var(--sp-10);
    }
  }

  .cta-band__inner::after {
    content: '';
    position: absolute;
    right: -60px;
    bottom: -90px;
    width: 260px;
    height: 260px;
    border-radius: 50%;
    border: 1px solid rgba(255, 255, 255, 0.12);
    pointer-events: none;
  }

  .cta-band__text h2 {
    color: #fff;
  }

  .cta-band__text .eyebrow {
    color: var(--c-accent-300);
  }

  .cta-band__text p {
    margin-top: var(--sp-3);
    color: rgba(234, 243, 251, 0.82);
    font-size: var(--fs-md);
    max-width: 52ch;
  }

  .cta-band__actions {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    gap: var(--sp-3);
  }

  @media (max-width: 559px) {
    .cta-band__actions .btn {
      width: 100%;
    }
  }
</style>
