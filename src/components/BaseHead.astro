---
import { seo } from '../data/site';

const { company, seo: seoSettings, theme } = Astro.locals.settings;

interface Props {
  title?: string;
  description?: string;
  /** Caminho canônico. Se omitido, usa a URL atual. */
  path?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  /** Blocos JSON-LD já montados pela página. */
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
}

const {
  title,
  description = seo.defaultDescription,
  path,
  ogImage = seoSettings.ogDefaultImage,
  ogType = 'website',
  noindex = false,
  jsonLd = [],
  publishedTime,
  modifiedTime,
} = Astro.props;

const fullTitle = title ? seo.titleTemplate.replace('%s', title) : seo.defaultTitle;
const canonicalPath = path ?? Astro.url.pathname;
const canonical = new URL(canonicalPath, seo.siteUrl).href.replace(/(.+)\/$/, '$1');
const ogImageUrl = new URL(ogImage, seo.siteUrl).href;

/** Organização — apenas propriedades confirmadas. Nada fictício. */
const organizationLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: company.name,
  url: seo.siteUrl,
  email: company.email,
  telephone: company.phone,
  description: company.description,
  address: {
    '@type': 'PostalAddress',
    streetAddress: `${company.address.line1}, ${company.address.line2}`,
    addressLocality: company.address.city,
    addressRegion: company.address.state,
    postalCode: company.address.zip,
    addressCountry: company.address.country,
  },
  areaServed: 'BR',
};

const websiteLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: seo.siteName,
  url: seo.siteUrl,
  inLanguage: 'pt-BR',
};

const blocks = [organizationLd, websiteLd, ...jsonLd];

// Só habilita o GA se o ID informado em Configurações seguir o formato
// esperado (G-XXXXXXXXXX) — evita injetar valor inválido no script inline.
const gaId = /^G-[A-Z0-9]{4,12}$/.test(seoSettings.gaId) ? seoSettings.gaId : '';
const gaInlineScript = gaId
  ? `window.dataLayer=window.dataLayer||[];window.gtag=function(){window.dataLayer.push(arguments)};gtag('js',new Date());gtag('config',${JSON.stringify(gaId)});`
  : '';

/**
 * Paleta global (Configurações → Aparência): 4 cores-base editáveis, das
 * quais o resto do degradê de marca/destaque é derivado com color-mix() —
 * evita precisar de uma biblioteca de cor só para clarear/escurecer.
 * Valida formato hex antes de injetar, por segurança (defesa em profundidade).
 */
const HEX = /^#[0-9a-fA-F]{6}$/;
const safeHex = (value: string, fallback: string) => (HEX.test(value) ? value : fallback);
const brand = safeHex(theme.brandColor, '#06203a');
const accent = safeHex(theme.accentColor, '#0d8b7d');
const background = safeHex(theme.backgroundColor, '#ffffff');
const heading = safeHex(theme.headingColor, '#06203a');
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />
<meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow'} />
<meta name="author" content={company.name} />
<meta name="theme-color" content={seo.themeColor} />
<meta name="generator" content={Astro.generator} />

<style
  set:html={`:root {
  --c-brand-950: color-mix(in srgb, ${brand} 92%, black) !important;
  --c-brand-900: ${brand} !important;
  --c-brand-800: color-mix(in srgb, ${brand} 85%, white) !important;
  --c-brand-700: color-mix(in srgb, ${brand} 68%, white) !important;
  --c-brand-600: color-mix(in srgb, ${brand} 52%, white) !important;
  --c-brand-500: color-mix(in srgb, ${brand} 38%, white) !important;
  --c-brand-400: color-mix(in srgb, ${brand} 26%, white) !important;
  --c-brand-300: color-mix(in srgb, ${brand} 16%, white) !important;
  --c-brand-200: color-mix(in srgb, ${brand} 9%, white) !important;
  --c-brand-100: color-mix(in srgb, ${brand} 5%, white) !important;
  --c-brand-50: color-mix(in srgb, ${brand} 2%, white) !important;
  --c-accent-700: color-mix(in srgb, ${accent} 88%, black) !important;
  --c-accent-600: ${accent} !important;
  --c-accent-500: color-mix(in srgb, ${accent} 82%, white) !important;
  --c-accent-300: color-mix(in srgb, ${accent} 45%, white) !important;
  --c-accent-100: color-mix(in srgb, ${accent} 15%, white) !important;
  --c-accent-50: color-mix(in srgb, ${accent} 6%, white) !important;
  --c-white: ${background} !important;
  --bg: ${background} !important;
  --bg-subtle: color-mix(in srgb, ${background} 96%, ${brand}) !important;
  --bg-muted: color-mix(in srgb, ${background} 90%, ${brand}) !important;
  --text-strong: ${heading} !important;
  --focus: ${accent} !important;
}`}
></style>
{
  seoSettings.gscVerification && (
    <meta name="google-site-verification" content={seoSettings.gscVerification} />
  )
}

<!-- Open Graph -->
<meta property="og:site_name" content={seo.siteName} />
<meta property="og:type" content={ogType} />
<meta property="og:locale" content={seo.locale} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={ogImageUrl} />
{publishedTime && <meta property="article:published_time" content={publishedTime} />}
{modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}

<!-- Twitter / X -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImageUrl} />

<!-- Ícones -->
<link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
<link rel="icon" href="/favicon-192.png" type="image/png" sizes="192x192" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />

{
  blocks.map((block) => (
    <script type="application/ld+json" set:html={JSON.stringify(block)} is:inline />
  ))
}

{gaId && <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} />}
{gaId && <script is:inline set:html={gaInlineScript} />}
