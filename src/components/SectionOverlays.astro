---
/**
 * Elementos criados no editor visual e sobrepostos a uma seção.
 *
 * Eles são posicionados de forma absoluta (em % da seção) porque são
 * acréscimos: não participam do fluxo, então mover um deles não desloca nada
 * do conteúdo original. Ainda assim saem como HTML de verdade — parágrafo,
 * imagem ou ícone — e não como desenho em canvas.
 */
import Icon from './Icon.astro';
import { safeMediaUrl, safeHref } from '../lib/urls';
import type { Overlay } from '../lib/pages';

interface Props {
  section: string;
  overlays: Overlay[];
}

const { section, overlays } = Astro.props;
// Atributos usados só pelo editor não vão para o HTML de quem visita o site.
// É limpeza de marcação, não controle de acesso — quem autoriza e valida é o
// servidor, em toda requisição.
const edit = Boolean(Astro.locals.editMode);
const ed = <T,>(value: T): T | undefined => (edit ? value : undefined);

const mine = overlays.filter((item) => item.section === section);

const HEX = /^#[0-9a-fA-F]{6}$/;

/**
 * Contorno via SVG, não CSS: um `border` reto não acompanha uma silhueta
 * recortada (triângulo, losango, seta) — teria que desenhar por cima do
 * clip-path, o que produz uma linha reta sem relação com o desenho. Com SVG,
 * `stroke` segue exatamente o `<polygon>`/`<rect>`/`<ellipse>`, em qualquer
 * forma. Mesma tabela de pontos usada por `public/editor-runtime.js`.
 */
const POLY_POINTS: Record<string, string> = {
  triangle: '50,2 98,98 2,98',
  diamond: '50,2 98,50 50,98 2,50',
  arrow: '2,35 60,35 60,10 98,50 60,90 60,65 2,65',
};

const SVG_BG_STYLE = 'position:absolute;inset:0;width:100%;height:100%;pointer-events:none';

function shapeGeometry(overlay: Overlay) {
  const fill = HEX.test(overlay.fill) ? overlay.fill : '#12a794';
  const strokeWidth = Math.min(20, Math.max(0, Math.round(Number(overlay.strokeWidth) || 0)));
  const hasStroke = strokeWidth > 0 && HEX.test(overlay.stroke);
  return {
    fill,
    stroke: hasStroke ? overlay.stroke : 'none',
    strokeWidth: hasStroke ? strokeWidth : 0,
    points: POLY_POINTS[overlay.content],
  };
}
---

{
  mine.map((overlay) =>
    overlay.kind === 'text' ? (
      <p
        class="overlay overlay--text"
        data-overlay={overlay.id}
        data-edit-kind={ed('multiline')}
      >
        {overlay.content}
      </p>
    ) : overlay.kind === 'shape' ? (
      overlay.href && safeHref(overlay.href) ? (
        <a
          class="overlay overlay--shape"
          data-shape={overlay.content}
          data-overlay={overlay.id}
          data-edit-kind={ed('shape')}
          href={safeHref(overlay.href)}
          target={overlay.linkTarget === '_blank' ? '_blank' : undefined}
          rel={overlay.linkTarget === '_blank' ? 'noopener' : undefined}
        >
          <svg
            class="overlay__shape-bg"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            style={SVG_BG_STYLE}
            aria-hidden="true"
          >
            {overlay.content === 'ellipse' ? (
              <ellipse
                cx="50"
                cy="50"
                rx="49"
                ry="49"
                fill={shapeGeometry(overlay).fill}
                stroke={shapeGeometry(overlay).stroke}
                stroke-width={shapeGeometry(overlay).strokeWidth}
                vector-effect="non-scaling-stroke"
              />
            ) : shapeGeometry(overlay).points ? (
              <polygon
                points={shapeGeometry(overlay).points}
                fill={shapeGeometry(overlay).fill}
                stroke={shapeGeometry(overlay).stroke}
                stroke-width={shapeGeometry(overlay).strokeWidth}
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"
              />
            ) : (
              <rect
                x="1"
                y="1"
                width="98"
                height="98"
                rx={overlay.content === 'rounded' ? 14 : 0}
                ry={overlay.content === 'rounded' ? 14 : 0}
                fill={shapeGeometry(overlay).fill}
                stroke={shapeGeometry(overlay).stroke}
                stroke-width={shapeGeometry(overlay).strokeWidth}
                vector-effect="non-scaling-stroke"
              />
            )}
          </svg>
          <span class="overlay__shape-text" style="position:relative;z-index:1">
            {overlay.text}
          </span>
        </a>
      ) : (
        <span
          class="overlay overlay--shape"
          data-shape={overlay.content}
          data-overlay={overlay.id}
          data-edit-kind={ed('shape')}
        >
          <svg
            class="overlay__shape-bg"
            viewBox="0 0 100 100"
            preserveAspectRatio="none"
            style={SVG_BG_STYLE}
            aria-hidden="true"
          >
            {overlay.content === 'ellipse' ? (
              <ellipse
                cx="50"
                cy="50"
                rx="49"
                ry="49"
                fill={shapeGeometry(overlay).fill}
                stroke={shapeGeometry(overlay).stroke}
                stroke-width={shapeGeometry(overlay).strokeWidth}
                vector-effect="non-scaling-stroke"
              />
            ) : shapeGeometry(overlay).points ? (
              <polygon
                points={shapeGeometry(overlay).points}
                fill={shapeGeometry(overlay).fill}
                stroke={shapeGeometry(overlay).stroke}
                stroke-width={shapeGeometry(overlay).strokeWidth}
                stroke-linejoin="round"
                vector-effect="non-scaling-stroke"
              />
            ) : (
              <rect
                x="1"
                y="1"
                width="98"
                height="98"
                rx={overlay.content === 'rounded' ? 14 : 0}
                ry={overlay.content === 'rounded' ? 14 : 0}
                fill={shapeGeometry(overlay).fill}
                stroke={shapeGeometry(overlay).stroke}
                stroke-width={shapeGeometry(overlay).strokeWidth}
                vector-effect="non-scaling-stroke"
              />
            )}
          </svg>
          <span class="overlay__shape-text" style="position:relative;z-index:1">
            {overlay.text}
          </span>
        </span>
      )
    ) : overlay.kind === 'video' ? (
      <video
        class="overlay overlay--video"
        data-overlay={overlay.id}
        data-edit-kind={ed('video')}
        src={safeMediaUrl(overlay.content)}
        controls
        preload="metadata"
      />
    ) : overlay.kind === 'image' ? (
      <img
        class="overlay overlay--image"
        data-overlay={overlay.id}
        data-edit-kind={ed('image')}
        src={safeMediaUrl(overlay.content)}
        alt={overlay.alt}
        loading="lazy"
      />
    ) : (
      <span
        class="overlay overlay--icon"
        data-overlay={overlay.id}
        data-edit-kind={ed('icon')}
        data-edit-value={overlay.content}
      >
        <Icon name={overlay.content} size={40} label={overlay.alt || undefined} />
      </span>
    )
  )
}

<style>
  .overlay {
    margin: 0;
    max-width: 100%;
  }

  .overlay--image {
    height: auto;
    object-fit: contain;
  }

  .overlay--icon {
    display: inline-grid;
    place-items: center;
    color: var(--c-brand-600);
  }

  .overlay--video {
    height: auto;
    border-radius: var(--r-sm);
  }

  /* Forma: preenchimento/borda vêm do `style` inline (shapeStyle no servidor,
     a mesma conta no editor). O texto interno é centralizado; se virar link,
     perde o sublinhado e a cor azul padrão do navegador. */
  .overlay--shape {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 2rem;
    min-width: 2rem;
    padding: 0.5rem 0.75rem;
    text-align: center;
    text-decoration: none;
    color: inherit;
    font-size: var(--fs-sm);
    box-sizing: border-box;
  }
</style>
