---
/**
 * Diagrama do modelo Essencial — HTML + CSS + SVG (sem imagem estática).
 * Desktop: eixo horizontal com os nós em linha; o nó "paciente" (quando
 * existe) fica ao centro, abaixo. Mobile: fluxo vertical.
 *
 * Os nós vêm de `elo.nodes` e são livres: dá para editar texto/ícone, remover,
 * duplicar e reordenar (Editor Visual e formulário de Páginas). Papéis pela
 * `key`: "essencial" = nó em destaque; "paciente" = nó de baixo, se houver.
 */
import Icon from './Icon.astro';
import { elo as defaultElo } from '../data/institutional';

interface Props {
  /** Passe o conteúdo vindo do banco (Home); sem prop, usa o padrão estático. */
  elo?: typeof defaultElo;
}

const { elo = defaultElo } = Astro.props;
const { company } = Astro.locals.settings;
const edit = Boolean(Astro.locals.editMode);
const ed = <T,>(value: T): T | undefined => (edit ? value : undefined);

type Node = (typeof elo.nodes)[number] & { tag?: string };
const nodes = elo.nodes as Node[];
const patientIndex = nodes.findIndex((node) => node.key === 'paciente');
const rowNodes = nodes
  .map((node, index) => ({ node, index }))
  .filter(({ index }) => index !== patientIndex);
const patient = patientIndex >= 0 ? nodes[patientIndex]! : null;
---

<div class="elo-frame">
  <p class="elo-frame__label">{company.name}</p>
  <div
    class="elo"
    role="group"
    aria-label="Modelo de atuação da Essencial Saúde"
    data-edit-list={ed('elo.nodes')}
  >
  <div class="elo__row">
    {
      rowNodes.map(({ node, index }, position) => (
        <>
          {position > 0 && (
            <span class="elo__link" aria-hidden="true">
              <i />
            </span>
          )}
          <article
            class:list={['elo__node', node.key === 'essencial' && 'elo__node--core']}
            data-edit-item={ed(index)}
          >
            <span class:list={['elo__icon', node.key === 'essencial' && 'elo__icon--core']}>
              <Icon
                name={node.icon}
                size={node.key === 'essencial' ? 24 : 22}
                data-edit={`elo.nodes.${index}.icon`}
                data-edit-kind={ed('icon')}
                data-edit-value={node.icon}
                data-edit-label={ed('Ícone')}
              />
            </span>
            <h3 data-edit={`elo.nodes.${index}.label`} data-edit-label={ed('Título')}>
              {node.label}
            </h3>
            <p
              data-edit={`elo.nodes.${index}.text`}
              data-edit-kind={ed('multiline')}
              data-edit-label={ed('Texto')}
            >
              {node.text}
            </p>
            {(node.tag || (edit && typeof node.tag === 'string')) && (
              <span class="elo__tag" data-edit={`elo.nodes.${index}.tag`} data-edit-label={ed('Selo')}>
                {node.tag}
              </span>
            )}
          </article>
        </>
      ))
    }
  </div>

  {
    patient && (
      <>
        <span class="elo__link elo__link--down" aria-hidden="true">
          <i />
        </span>

        <article class="elo__node elo__node--patient" data-edit-item={ed(patientIndex)}>
          <span class="elo__icon elo__icon--patient">
            <Icon
              name={patient.icon}
              size={22}
              data-edit={`elo.nodes.${patientIndex}.icon`}
              data-edit-kind={ed('icon')}
              data-edit-value={patient.icon}
              data-edit-label={ed('Ícone')}
            />
          </span>
          <div>
            <h3 data-edit={`elo.nodes.${patientIndex}.label`} data-edit-label={ed('Título')}>
              {patient.label}
            </h3>
            <p
              data-edit={`elo.nodes.${patientIndex}.text`}
              data-edit-kind={ed('multiline')}
              data-edit-label={ed('Texto')}
            >
              {patient.text}
            </p>
          </div>
        </article>
      </>
    )
  }
  </div>
</div>

<style>
  /* Moldura que engloba os três nós, com o nome da empresa "recortando" a
     borda no topo (como uma legenda de fieldset) — usa a mesma cor sólida
     de fundo da seção para o recorte funcionar. */
  .elo-frame {
    position: relative;
    border: 2px solid rgba(111, 208, 194, 0.55);
    border-radius: var(--r-xl);
    padding: clamp(2rem, 4vw, 2.75rem) clamp(1.25rem, 3vw, 2rem) clamp(1.5rem, 3vw, 2rem);
    box-shadow: 0 0 0 1px rgba(111, 208, 194, 0.15) inset;
  }

  .elo-frame__label {
    position: absolute;
    top: 0;
    left: 50%;
    transform: translate(-50%, -50%);
    margin: 0;
    max-width: calc(100% - 2rem);
    padding: 0 var(--sp-4);
    background: var(--bg-brand);
    color: #fff;
    font-size: var(--fs-sm);
    font-weight: var(--fw-bold);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-align: center;
  }

  .elo {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .elo__row {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    width: 100%;
    gap: 0;
  }

  @media (min-width: 900px) {
    .elo__row {
      flex-direction: row;
      align-items: stretch;
    }
  }

  .elo__node {
    position: relative;
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: clamp(1.15rem, 2vw, 1.6rem);
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: var(--r-lg);
    backdrop-filter: blur(2px);
  }

  .elo__node h3 {
    font-size: var(--fs-base);
    color: #fff;
  }

  .elo__node p {
    font-size: var(--fs-xs);
    line-height: var(--lh-relaxed);
    color: rgba(234, 243, 251, 0.72);
    margin: 0;
  }

  .elo__icon {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--r-md);
    background: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.16);
    color: var(--c-brand-200);
  }

  .elo__node--core {
    background: linear-gradient(160deg, rgba(18, 167, 148, 0.22), rgba(26, 111, 175, 0.16));
    border-color: rgba(111, 208, 194, 0.5);
    box-shadow: 0 18px 40px -22px rgba(18, 167, 148, 0.8);
  }

  .elo__icon--core {
    background: var(--c-accent-600);
    border-color: var(--c-accent-500);
    color: #fff;
  }

  .elo__tag {
    align-self: flex-start;
    margin-top: 0.25rem;
    padding: 0.15rem 0.6rem;
    border-radius: var(--r-pill);
    background: rgba(255, 255, 255, 0.14);
    color: #fff;
    font-size: 0.6875rem;
    font-weight: var(--fw-semibold);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .elo__node--patient {
    flex-direction: row;
    align-items: center;
    gap: var(--sp-4);
    width: min(560px, 100%);
    background: rgba(255, 255, 255, 0.07);
    border-color: rgba(168, 211, 239, 0.4);
  }

  .elo__icon--patient {
    color: #ffb4b4;
    border-color: rgba(255, 180, 180, 0.4);
  }

  /* conectores */
  .elo__link {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
  }

  .elo__link i {
    display: block;
    background: linear-gradient(
      90deg,
      rgba(168, 211, 239, 0.1),
      rgba(168, 211, 239, 0.55),
      rgba(168, 211, 239, 0.1)
    );
  }

  /* mobile: conectores verticais */
  .elo__link i {
    width: 2px;
    height: 26px;
    background: linear-gradient(
      180deg,
      rgba(168, 211, 239, 0.1),
      rgba(168, 211, 239, 0.55),
      rgba(168, 211, 239, 0.1)
    );
  }

  .elo__link--down i {
    height: 32px;
  }

  @media (min-width: 900px) {
    .elo__row > .elo__link {
      width: clamp(24px, 4vw, 56px);
    }

    .elo__row > .elo__link i {
      width: 100%;
      height: 2px;
      background: linear-gradient(
        90deg,
        rgba(168, 211, 239, 0.1),
        rgba(168, 211, 239, 0.55),
        rgba(168, 211, 239, 0.1)
      );
    }

    .elo__link--down i {
      height: 40px;
    }
  }
</style>
