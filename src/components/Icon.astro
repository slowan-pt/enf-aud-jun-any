---
/**
 * Família única de ícones vetoriais (SVG, traço 1.75, grade 24×24), com
 * fallback para ícone personalizado: se `name` for um caminho/URL (começa
 * com "/", "http://" ou "https://" e termina em imagem), renderiza um
 * <img> em vez de buscar no mapa embutido — assim qualquer campo de ícone
 * do site aceita tanto um nome da biblioteca quanto um SVG/PNG enviado
 * pela Mídia, sem precisar mudar cada lugar que usa <Icon>.
 *
 * Uso: <Icon name="shield-check" size={20} /> ou <Icon name="/media/x.svg" size={20} />
 */
import { iconPaths } from '../data/icons';
import { safeMediaUrl } from '../lib/urls';

interface Props {
  name: string;
  size?: number;
  class?: string;
  strokeWidth?: number;
  /** Quando o ícone carrega significado próprio, informe um rótulo. */
  label?: string;
  /** Atributos extras (ex.: data-edit, usado pelo editor visual). */
  [key: string]: unknown;
}

const {
  name,
  size = 24,
  class: className = '',
  strokeWidth = 1.75,
  label,
  ...rest
} = Astro.props;

// `name` vem do banco e é editável pelo painel. Duas saídas possíveis, ambas
// fechadas: ou é uma chave da biblioteca embutida (lista permitida), ou é uma
// URL de mídia validada. Qualquer outra coisa cai no ícone neutro.
const builtIn = Object.prototype.hasOwnProperty.call(iconPaths, name) ? name : '';
const customUrl = builtIn ? '' : safeMediaUrl(name);
const isCustom = Boolean(customUrl);
const d = isCustom ? '' : (iconPaths[builtIn] ?? iconPaths['info']);

// `data-edit-value` diz ao editor qual ícone está aplicado; fora do editor não
// serve para nada e sai do HTML. Dentro dele, publica o valor efetivamente
// usado — não o que veio do banco —, então um nome recusado não chega nem
// como texto.
const edit = Boolean(Astro.locals.editMode);
const { 'data-edit-value': _incoming, ...withoutEditValue } = rest as Record<string, unknown>;
const attrs =
  edit && 'data-edit-value' in rest
    ? { ...withoutEditValue, 'data-edit-value': builtIn || customUrl }
    : withoutEditValue;
const aria = label
  ? { role: 'img' as const, 'aria-label': label }
  : { 'aria-hidden': 'true' as const };
---

{
  isCustom ? (
    <img
      src={customUrl}
      width={size}
      height={size}
      alt={label ?? ''}
      class={`icon icon--custom ${className}`.trim()}
      loading="lazy"
      {...attrs}
      {...(label ? {} : { 'aria-hidden': 'true' })}
    />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      width={size}
      height={size}
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width={strokeWidth}
      stroke-linecap="round"
      stroke-linejoin="round"
      class={`icon ${className}`.trim()}
      focusable="false"
      {...attrs}
      {...aria}
      set:html={d}
    />
  )
}

<style>
  .icon {
    flex: none;
  }

  .icon--custom {
    object-fit: contain;
  }
</style>
