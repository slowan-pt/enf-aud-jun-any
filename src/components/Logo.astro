---
/**
 * MARCA OFICIAL — logo "ES+ AUDITORIA" (public/logo/essencial-saude-logo.webp).
 *
 * A imagem (ícone + a palavra AUDITORIA) vem acompanhada do nome "Essencial / Saúde Auditoria" em texto, usada no cabeçalho, no menu móvel,
 * no rodapé, na barra lateral do painel e no login. O arquivo pode ser trocado em
 * Configurações → Logotipo (`brand.logoUrl`); sem troca, vale `brand.markUrl`.
 *
 * Sobre fundo escuro (`inverse`) a arte, que é azul, vai sobre uma placa clara.
 */
interface Props {
  variant?: 'default' | 'inverse';
  size?: 'sm' | 'md' | 'lg';
  class?: string;
  /** Só a imagem, sem o nome ao lado (uso em espaços curtos). */
  markOnly?: boolean;
}

const { variant = 'default', size = 'md', class: className = '', markOnly = false } = Astro.props;

const { brand } = Astro.locals.settings;
const src = brand.logoUrl || brand.markUrl;
---

<span class={`logo logo--${variant} logo--${size} ${className}`.trim()}>
  <span class="logo__plate">
    <img
      class="logo__image"
      src={src}
      width="640"
      height="566"
      alt="Essencial Saúde Auditoria"
      loading="eager"
      decoding="async"
    />
  </span>
  {
    !markOnly && (
      <span class="logo__type">
        <span class="logo__name">Essencial</span>
        <span class="logo__sub">Saúde Auditoria</span>
      </span>
    )
  }
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    line-height: 1;
  }

  .logo__plate {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    border-radius: var(--r-sm);
    background: transparent;
  }

  .logo__image {
    display: block;
    width: auto;
    height: 60px;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .logo__image {
      height: 68px;
    }
  }

  .logo--inverse .logo__plate {
    background: #fff;
    padding: 6px;
  }

  .logo--sm .logo__image {
    height: 52px;
  }

  .logo--lg .logo__image {
    height: 96px;
  }

  .logo__type {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .logo__name {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: -0.02em;
    color: var(--c-brand-900);
  }

  .logo__sub {
    font-family: var(--font-display);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--c-brand-900);
  }

  .logo--inverse .logo__name,
  .logo--inverse .logo__sub {
    color: #fff;
  }

  .logo--sm .logo__name {
    font-size: 1.05rem;
  }

  .logo--sm .logo__sub {
    font-size: 0.55rem;
  }

  .logo--lg .logo__name {
    font-size: 1.5rem;
  }

  .logo--lg .logo__sub {
    font-size: 0.75rem;
  }
</style>
