---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/types';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs: Crumb[];
  image?: string;
  imageAlt?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, lead, crumbs, image, imageAlt = '', align = 'left' } = Astro.props;
const hasImage = Boolean(image);
---

<section class:list={['page-hero', { 'page-hero--with-image': hasImage }]}>
  <div class="page-hero__bg" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    <div
      class:list={[
        'page-hero__text',
        { 'page-hero__text--center': align === 'center' && !hasImage },
      ]}
    >
      <Breadcrumbs items={crumbs} variant="inverse" />
      {eyebrow && <p class="eyebrow page-hero__eyebrow">{eyebrow}</p>}
      <h1 class="title-lg">{title}</h1>
      {lead && <p class="page-hero__lead">{lead}</p>}
      <slot />
    </div>
    {
      hasImage && (
        <div class="page-hero__media">
          <img src={image} alt={imageAlt} width="720" height="540" loading="eager" />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    background: var(--c-brand-900);
    color: var(--text-on-brand);
    overflow: hidden;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 88% 10%, rgba(18, 167, 148, 0.22), transparent 58%),
      radial-gradient(90% 70% at 10% 100%, rgba(47, 142, 205, 0.28), transparent 60%);
    pointer-events: none;
  }

  .page-hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .page-hero--with-image .page-hero__inner {
    grid-template-columns: 1fr;
  }

  @media (min-width: 940px) {
    .page-hero--with-image .page-hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .page-hero__text {
    max-width: 44rem;
  }

  .page-hero__text--center {
    margin-inline: auto;
    text-align: center;
  }

  .page-hero__eyebrow {
    color: var(--c-accent-300);
    margin-top: var(--sp-5);
  }

  .page-hero h1 {
    color: #fff;
  }

  .page-hero__lead {
    margin-top: var(--sp-4);
    font-size: var(--fs-lg);
    color: rgba(234, 243, 251, 0.82);
    max-width: 40rem;
  }

  .page-hero__text--center .page-hero__lead {
    margin-inline: auto;
  }

  .page-hero__media {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: var(--shadow-lg);
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 939px) {
    .page-hero__media {
      max-width: 520px;
    }
  }
</style>
