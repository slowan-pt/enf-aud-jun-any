---
import Breadcrumbs from './Breadcrumbs.astro';
import type { Crumb } from '../lib/types';

interface Props {
  eyebrow?: string;
  title: string;
  lead?: string;
  crumbs: Crumb[];
  image?: string;
  imageAlt?: string;
  align?: 'left' | 'center';
  /**
   * Caminho `data-edit` da imagem, só quando o chamador quiser essa imagem
   * editável no Editor Visual (ex.: /servicos/[slug]). Ausente = comportamento
   * de sempre, sem nenhum atributo extra — Home, Quem Somos e Contato não
   * passam esta prop e continuam idênticas.
   */
  imageEditPath?: string;
  /**
   * Ajuste visual da imagem — `cover`/`contain` e posição do enquadramento.
   * Ausente = comportamento de sempre (cover, centrado, via CSS abaixo).
   * A proporção (aspect-ratio 4/3) e o tamanho mínimo nunca mudam: só o que
   * fica visível dentro desse quadro muda.
   */
  imageFit?: 'cover' | 'contain';
  imagePosX?: number;
  imagePosY?: number;
  /**
   * Caminhos `data-edit` do texto — mesma regra da imagem acima: ausente
   * (fora do editor, ou quando o chamador não tem campo correspondente) não
   * gera nenhum atributo extra, então a página pública fica idêntica.
   */
  eyebrowEditPath?: string;
  titleEditPath?: string;
  leadEditPath?: string;
  /**
   * Imagem fixa que substitui o fundo azul e ocupa toda a largura do topo.
   * Vazio/ausente = fundo azul de sempre. `bgEditPath` só é passado no modo
   * de edição: renderiza um botão para trocar/remover a imagem, mesmo quando
   * ainda não há imagem (senão não haveria onde clicar).
   */
  bgImage?: string;
  bgImageAlt?: string;
  bgEditPath?: string;
}

const {
  eyebrow,
  title,
  lead,
  crumbs,
  image,
  imageAlt = '',
  align = 'left',
  imageEditPath,
  imageFit,
  imagePosX,
  imagePosY,
  eyebrowEditPath,
  titleEditPath,
  leadEditPath,
  bgImage,
  bgImageAlt = '',
  bgEditPath,
} = Astro.props;
const hasBg = Boolean(bgImage);
// Com imagem de fundo, ela ocupa o topo inteiro — a imagem lateral sai de cena.
const hasImage = Boolean(image) && !hasBg;
const bgChip =
  'data:image/svg+xml;utf8,' +
  encodeURIComponent(
    `<svg xmlns="http://www.w3.org/2000/svg" width="250" height="40"><rect width="250" height="40" rx="8" fill="#0b2545" fill-opacity=".85" stroke="#fff" stroke-dasharray="4 3"/><text x="125" y="25" font-family="sans-serif" font-size="13" fill="#fff" text-anchor="middle">${hasBg ? 'Trocar imagem de fundo' : '+ Imagem de fundo do topo'}</text></svg>`
  );
const imageStyle =
  imageFit || imagePosX !== undefined || imagePosY !== undefined
    ? `object-fit:${imageFit ?? 'cover'};object-position:${imagePosX ?? 50}% ${imagePosY ?? 50}%`
    : undefined;
---

<section
  class:list={['page-hero', { 'page-hero--with-image': hasImage, 'page-hero--photo': hasBg }]}
>
  {
    hasBg && (
      <img
        class="page-hero__photo"
        src={bgImage}
        alt={bgImageAlt}
        loading="eager"
        fetchpriority="high"
        decoding="async"
      />
    )
  }
  {
    bgEditPath && (
      <img
        class="page-hero__bg-chip"
        src={bgChip}
        alt=""
        width="250"
        height="40"
        data-edit={bgEditPath}
        data-edit-kind="image"
        data-edit-value={bgImage ?? ''}
        data-edit-label="Imagem de fundo do topo"
      />
    )
  }
  <div class="page-hero__bg" aria-hidden="true"></div>
  <div class="container page-hero__inner">
    <div
      class:list={[
        'page-hero__text',
        { 'page-hero__text--center': align === 'center' && !hasImage },
      ]}
    >
      <Breadcrumbs items={crumbs} variant="inverse" />
      {eyebrow && (
        <p
          class="eyebrow page-hero__eyebrow"
          data-edit={eyebrowEditPath}
          data-edit-label={eyebrowEditPath ? 'Selo do topo' : undefined}
        >
          {eyebrow}
        </p>
      )}
      <h1
        class="title-lg"
        data-edit={titleEditPath}
        data-edit-label={titleEditPath ? 'Título' : undefined}
      >
        {title}
      </h1>
      {lead && (
        <p
          class="page-hero__lead"
          data-edit={leadEditPath}
          data-edit-kind={leadEditPath ? 'multiline' : undefined}
          data-edit-label={leadEditPath ? 'Texto de apoio' : undefined}
        >
          {lead}
        </p>
      )}
      <slot />
    </div>
    {
      hasImage && (
        <div class="page-hero__media">
          <img
            src={image}
            alt={imageAlt}
            width="720"
            height="540"
            loading="eager"
            style={imageStyle}
            data-edit={imageEditPath}
            data-edit-kind={imageEditPath ? 'image' : undefined}
            data-edit-label={imageEditPath ? 'Imagem do topo' : undefined}
          />
        </div>
      )
    }
  </div>
</section>

<style>
  .page-hero {
    position: relative;
    background: var(--c-brand-900);
    color: var(--text-on-brand);
    overflow: hidden;
    padding-block: clamp(2.5rem, 5vw, 4.5rem);
  }

  .page-hero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(120% 90% at 88% 10%, rgba(18, 167, 148, 0.22), transparent 58%),
      radial-gradient(90% 70% at 10% 100%, rgba(47, 142, 205, 0.28), transparent 60%);
    pointer-events: none;
  }

  .page-hero__photo {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 70% 50%;
  }

  /* Escurece a foto só o bastante para o texto branco continuar legível. */
  .page-hero--photo .page-hero__bg {
    background: linear-gradient(90deg, rgba(6, 22, 46, 0.78), rgba(6, 22, 46, 0.25) 70%);
  }

  .page-hero--photo {
    min-height: clamp(20rem, 38vw, 30rem);
    display: flex;
    align-items: center;
  }

  .page-hero--photo .page-hero__inner {
    width: 100%;
    /* A `.container` genérica limita a 1200px e centraliza — sobre uma foto
       full-bleed isso deixa uma faixa vazia grande à esquerda em telas
       largas. Aqui o texto (que não é centralizado, só começa na borda
       esquerda deste bloco) se aproxima da borda real da viewport,
       preenchendo melhor o espaço sobre a imagem, mas com um respiro maior
       que o gutter padrão para não colar demais na borda. */
    max-width: none;
    padding-left: clamp(1.5rem, 6vw, 5rem);
  }

  /* Com foto de fundo o texto ocupa quase metade da largura — mais perto de
     quem está na foto — e o corpo da letra acompanha essa largura. O
     degradê escuro (acima) cobre até ~70% da imagem, então o texto nunca
     chega a ficar sobre o rosto da pessoa. */
  .page-hero--photo .page-hero__text {
    --w: clamp(300px, 46vw, 620px);
    max-width: var(--w);
  }
  .page-hero--photo h1 {
    font-size: clamp(1.4rem, calc(var(--w) / 9.5), 3rem);
  }
  .page-hero--photo .page-hero__lead {
    max-width: none;
    font-size: clamp(0.8rem, calc(var(--w) / 26), 1.125rem);
  }
  .page-hero--photo .btn {
    font-size: clamp(0.75rem, calc(var(--w) / 30), 0.95rem);
  }

  @media (max-width: 939px) {
    .page-hero--photo .page-hero__text {
      --w: 100%;
      max-width: none;
    }
    .page-hero--photo h1 {
      font-size: clamp(1.6rem, 7vw, 2.4rem);
    }
    .page-hero--photo .page-hero__lead {
      font-size: var(--fs-md);
    }
    /* Celular: foto e texto separados — a imagem inteira em cima, o texto sobre o
       azul da marca logo abaixo. Nada de texto por cima da foto. */
    .page-hero--photo {
      display: block;
      min-height: 0;
      padding-block: 0;
    }
    .page-hero--photo .page-hero__photo {
      position: relative;
      inset: auto;
      display: block;
      aspect-ratio: 16 / 10;
      height: auto;
      object-position: 75% 50%;
    }
    .page-hero--photo .page-hero__bg {
      display: none;
    }
    .page-hero--photo .page-hero__inner {
      padding-block: clamp(1.5rem, 6vw, 2.5rem);
    }
  }

  .page-hero__bg-chip {
    position: absolute;
    top: 10px;
    right: 10px;
    z-index: 5;
    width: 250px;
    height: 40px;
  }

  .page-hero__inner {
    position: relative;
    display: grid;
    gap: clamp(2rem, 4vw, 3.5rem);
    align-items: center;
  }

  .page-hero--with-image .page-hero__inner {
    grid-template-columns: 1fr;
  }

  @media (min-width: 940px) {
    .page-hero--with-image .page-hero__inner {
      grid-template-columns: 1.1fr 0.9fr;
    }
  }

  .page-hero__text {
    max-width: 44rem;
  }

  .page-hero__text--center {
    margin-inline: auto;
    text-align: center;
  }

  /* O padrão sitewide de título à esquerda vence um valor só herdado — precisa
     de uma regra direta aqui para o h1 realmente ficar centralizado. */
  .page-hero__text--center h1 {
    text-align: center;
  }

  .page-hero__eyebrow {
    color: var(--c-accent-300);
    margin-top: var(--sp-5);
  }

  .page-hero h1 {
    color: #fff;
  }

  .page-hero__lead {
    margin-top: var(--sp-4);
    font-size: var(--fs-lg);
    color: rgba(234, 243, 251, 0.82);
    max-width: 40rem;
    /* Campo "multiline": preserva os parágrafos (linhas em branco) que a
       pessoa digitou no editor — sem isto, o HTML colapsa tudo em uma
       única linha corrida, ignorando a quebra visual que ela escolheu. */
    white-space: pre-line;
  }

  .page-hero__text--center .page-hero__lead {
    margin-inline: auto;
  }

  .page-hero__media {
    position: relative;
    border-radius: var(--r-xl);
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow: var(--shadow-lg);
  }

  .page-hero__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  @media (max-width: 939px) {
    .page-hero__media {
      max-width: 520px;
    }
  }
</style>
