---
import '@fontsource-variable/inter';
import '@fontsource-variable/sora';
import '../styles/global.css';

import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppFloat from '../components/WhatsAppFloat.astro';
import { flags } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  path?: string;
  ogImage?: string;
  ogType?: 'website' | 'article';
  noindex?: boolean;
  jsonLd?: Record<string, unknown>[];
  publishedTime?: string;
  modifiedTime?: string;
  /** Mensagem contextual do botão flutuante de WhatsApp. */
  whatsappMessage?: string;
  bodyClass?: string;
  /** Repassado a BaseHead — sobrescrita de cor só desta página. */
  colorOverride?: Partial<{
    brandColor: string;
    accentColor: string;
    backgroundColor: string;
    headingColor: string;
  }>;
}

const { whatsappMessage, bodyClass = '', ...head } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <BaseHead {...head} />
  </head>
  <body class={bodyClass}>
    <a href="#conteudo" class="skip-link">Pular para o conteúdo</a>

    {
      flags.demoContent && (
        <div class="stage-banner" role="note">
          <span class="stage-banner__tag">Etapa 1</span>
          <span>
            Pré-visualização de layout — textos e conteúdos são de demonstração e serão
            substituídos pelo conteúdo real cadastrado no CMS.
          </span>
        </div>
      )
    }

    <Header />

    <main id="conteudo">
      <slot />
    </main>

    <Footer />
    <WhatsAppFloat message={whatsappMessage} />

    <style>
      .stage-banner {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        padding: 0.5rem 1rem;
        background: var(--c-brand-950);
        color: rgba(234, 243, 251, 0.75);
        font-size: 0.75rem;
        line-height: 1.4;
        text-align: center;
      }

      .stage-banner__tag {
        display: inline-block;
        padding: 0.1rem 0.5rem;
        border-radius: var(--r-pill);
        background: var(--c-accent-700);
        color: #fff;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        font-size: 0.6875rem;
      }
    </style>

    <style is:global>
      /* Janela popup da Política de Privacidade: só o texto, sem o menu/rodapé do site. */
      html.is-popup :is(.site-header, .footer, .skip-link, .wa),
      html.is-popup .cta-band {
        display: none !important;
      }
    </style>

    <script>
      // marca que há JS disponível (usado pelas animações progressivas)
      document.documentElement.classList.add('js');

      // Links com data-popup (ex.: Política de Privacidade nos formulários) abrem
      // numa janela popup — o visitante não perde o que já digitou. Se o navegador
      // bloquear o popup, o link abre normalmente numa nova aba.
      const POPUP_NAME = 'popup-privacidade';
      if (window.name === POPUP_NAME) document.documentElement.classList.add('is-popup');
      document.addEventListener('click', (event) => {
        const link = (event.target as Element | null)?.closest<HTMLAnchorElement>('a[data-popup]');
        if (!link || event.defaultPrevented) return;
        if (event.ctrlKey || event.metaKey || event.shiftKey) return;
        const screenW = window.screen.availWidth || 1280;
        const screenH = window.screen.availHeight || 800;
        const width = Math.max(360, Math.min(860, screenW - 40));
        const height = Math.max(400, Math.min(780, screenH - 40));
        const left = Math.max(0, Math.round((screenW - width) / 2));
        const top = Math.max(0, Math.round((screenH - height) / 2));
        const popup = window.open(
          link.href,
          POPUP_NAME,
          `popup=yes,width=${width},height=${height},left=${left},top=${top},scrollbars=yes,resizable=yes`
        );
        if (popup) {
          event.preventDefault();
          popup.focus();
        }
      });

      // revelação suave de blocos ao entrar na viewport
      const targets = document.querySelectorAll('[data-reveal]');
      if (targets.length) {
        const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (reduce || !('IntersectionObserver' in window)) {
          targets.forEach((el) => el.classList.add('is-visible'));
        } else {
          const observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add('is-visible');
                  observer.unobserve(entry.target);
                }
              });
            },
            { rootMargin: '0px 0px -8% 0px', threshold: 0.08 }
          );
          targets.forEach((el) => observer.observe(el));
        }
      }
    </script>
  </body>
</html>
